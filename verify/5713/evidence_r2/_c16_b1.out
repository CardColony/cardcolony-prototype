    async def test_report_done_calls_owner_and_coder_stays_silent(
            coder_registry, work, monkeypatch):
        """全链路收口：完工回执 → 主卡被调起验收 → answer 落编程卡收件箱留档 →
        编程卡无新回合（K3 对 completed coder 跳过、信仍 pending）。"""
