#!/bin/sh
# 提交闸（[harness 第 1 步 2026-10-28]）。
#
# 两道，缺一不可：
#   ① 数据守卫（2026-10-03 事故后加）：拒绝把 works/ 下的运行数据提交进 git。
#      起因：15:01 分支操作把 works/ 整体回退，用户数据受损。
#   ② 事件契约闸：新增/改动事件而没向 config/event_catalog.json 报备（类型＋字段），
#      或者产生点没带齐契约零件 ⇒ **提交不通过**。
#
# 为什么闸放在提交而不是只放测试：测试是"有人想起来才跑"，提交是必经之路。
# 用户口径（2026-10-28）：「新增【事件】就必须向这个口子报备，否则测试不通过、
# 提交不通过」——只有挂在提交上，那句话才成立。
#
# 安装：python scripts/install_hooks.py（或手工拷到 .git/hooks/pre-commit）
# 临时绕过：git commit --no-verify（仅限明确知情时）

# ---- ① 数据守卫 ----
STAGED=$(git diff --cached --name-only | grep -E '^works/' || true)
if [ -n "$STAGED" ]; then
  echo '[pre-commit 拒绝] 检测到 works/ 下的运行数据被暂存，不允许提交：'
  echo "$STAGED" | head -20
  echo '数据留痕走独立快照目录（推演agent_data_snapshots），不进 git。'
  echo '确需提交请用 git commit --no-verify（仅限明确知情时）。'
  exit 1
fi

# ---- ② 事件契约闸 ----
# 只在「源码或事件登记表被暂存」时跑，避免每次提交都付测试开销。
TOUCHED=$(git diff --cached --name-only | grep -E '^(src/|config/event_catalog\.json|config/card_type_registry\.json)' || true)
if [ -n "$TOUCHED" ]; then
  PY=".venv/Scripts/python.exe"
  [ -x "$PY" ] || PY="python"
  echo '[pre-commit] 事件契约校验中…'
  "$PY" -m pytest tests/test_event_catalog_coverage.py tests/test_event_field_contract.py \
      -q --no-header -p no:cacheprovider 2>&1 | tail -15
  if [ $? -ne 0 ]; then
    echo '[pre-commit 拒绝] 事件契约不通过：'
    echo '  · 新增事件类型必须在 config/event_catalog.json 报备（类型＋fields 契约）'
    echo '  · 产生点必须带齐 fields.part 里声明的零件'
    echo '  · 清退要成对标 deprecated + write_blocked（不删行）'
    echo '确需绕过请用 git commit --no-verify（仅限明确知情时）。'
    exit 1
  fi
fi

exit 0
