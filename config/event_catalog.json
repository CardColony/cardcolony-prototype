{
 "_meta": {
  "title": "事件类型登记表",
  "desc": "系统内所有事件类型的唯一登记处。新增事件类型必须在此登记，否则 event_hub.record 会报 UnknownEventType（开发期抛错、生产期 ERROR 日志）。tests/test_event_catalog_coverage.py 会扫源码所有事件产生点与本源对账，未登记即红。",
  "version": 3,
  "updated": "2026-11-01",
  "fields": {
   "label": "中文名（前端显示 / 日志可读）",
   "group": "分组，仅用于展示归类",
   "source": "产生该事件的模块（便于反查）",
   "channel": "card=卡级事件（落该卡事件流）｜work=工作级事件（无单一卡）",
   "triggerable": "是否允许作为 harness 规则触发源（高频噪声事件为 false）",
   "fields.part": "**必须带**的零件：短、可枚举、可比较，harness 条件的唯一取数面。缺一个 ⇒ 测试红",
   "fields.optional": "允许缺的零件（错误路径等天然没有）",
   "fields.payload": "原文全文，**不进条件面**（条件只问 part/optional）。注意：payload 是上下文与前端回放的原始数据，**不受任何清理机制处置**；这里的分类只声明「哪些字段不许拿来当条件」，不是寿命约定。",
   "deprecated": "可选。true=已停用，历史数据仍可解释，但禁止新写入",
   "write_blocked": "可选。true=写入被拒（配合 deprecated）"
  }
 },
