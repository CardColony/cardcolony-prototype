__pycache__/
*.pyc
logs/
.server.pid
.env
.venv/
.workbuddy/
# 临时/诊断文件不入库（auto commit 用 git add -A，靠这里挡）
_*.py
_*.txt
_*.json
_*.log
_*.out
_*.tmp
_*.png
_*.xml
_*.html
_*.js
_*.mjs
_*.err
# 验证/截图/临时测试产物目录（2026-10-15 补）
_verify/
_shots/
_pytest_tmp/
# 其他工具的状态目录（非本仓库资产）
.workbuddy-ai/
# 零字节事故文件（重定向笔误产物）
/=
# docs 内的施工期备份目录（同 _backups 纪律，不入库）
docs/exploration/_backup_*/
# 原子写入瞬态目录（编辑器/脚本写文件的 tmpdir，扫描期竞态会炸 git add）
*.tmpdir/
# 运行/诊断产物目录（2026-10-10 补：此前未挡，致 100 项临时件堆在未跟踪清单里）
_backups/
_web/
_vrun/
_e2e_static_tmp_*/
推演agent_backups/
.pytest_cache/
# 研究语料（第三方作品正文，版权内容不入库；统计产物另存 docs/）
corpus/
# 运行数据（卡片/对话/画布）——2026-10-03 事故后剥离：数据留痕走独立快照目录
# 推演agent_data_snapshots（在代码仓库之外），不进 git。任何分支操作都不得再改写它们。
# [2026-10-14 卡片存储迁移] 卡片与影子已进 SQLite：works/<work_id>/cards.db
# （含 WAL 旁挂 cards.db-wal / cards.db-shm）——同属运行数据，本行 works/ 一并挡住。
works/
# 根目录工作件与临时备份目录（2026-10-10 补；前导 / 锚定根目录，
# 不影响 tests/_golden/、tests/_fixtures/ 等已跟踪目录内的文件）
/_*.md
/_*.diff
/_t*/
/_backup_*/

# git worktree 目录（.worktrees/permbase 是真实 worktree——git worktree list 可见；
# 当普通文件提交会把整棵子树复制进仓库）
.worktrees/
# 数据快照运行态指纹（data_snapshot 运行时生成，非配置）
.snapshot_fingerprints.json
# 启动日志 .err 伴生文件（.log/.out 已挡，.err 漏网）
_*.err
# Windows 重定向事故产物（> nul 误写成的 105B 垃圾；nul 为保留设备名，入库会伤 Windows 检出）
/nul
# 重启前代码备份目录（git 已有全量历史，备份不留库）
/重启前代码备份_*/

# docs 内的下划线探测/差异目录（e2e profile 等垃圾，不入库）
docs/_*/
docs/*/_*/
