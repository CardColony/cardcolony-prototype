    '<div class="n-foot"><span class="n-state"><span class="sd"></span>'+STATE_LABEL[n.state]+'</span>'+
      '<span class="n-acts"><button class="n-act" data-act="conv" title="打开对话">◧</button>'+
      '<button class="n-act" data-act="more" title="更多">⋯</button></span></div>'+
    '<div class="n-meta">'+esc(n.meta)+'</div>';
  return el;
}

function renderNodes(){
  const host=$("#nodes");
  const ids=visibleIds();
  const inBranch=(S.focus==="root")?null:new Set(branchIds(S.focus));
  const have=new Map([...host.children].map(el=>[el.dataset.id,el]));
  ids.forEach(id=>{
    const n=NODES[id];
    let el=have.get(id);
    if(!el){ el=nodeEl(id); host.appendChild(el); } else { have.delete(id); }
    el.style.left=n.pos.x+"px"; el.style.top=n.pos.y+"px";
    el.classList.toggle("sel",S.sel.has(id));
    el.classList.toggle("dim",!!inBranch&&!inBranch.has(id));
    el.classList.toggle("collapsed",S.collapsed.has(id));
    const caret=$(".n-caret",el); if(caret) caret.textContent=S.collapsed.has(id)?"▸":"▾";
    const fold=$(".n-fold",el);
    if(fold) fold.textContent=S.collapsed.has(id)?"+"+kidsOf(id).length:"";
    n._h=el.offsetHeight||NH;
  });
  have.forEach(el=>el.remove());
}

function anchorR(n){return {x:n.pos.x+NW, y:n.pos.y+(n._h||NH)/2};}
function anchorL(n){return {x:n.pos.x, y:n.pos.y+(n._h||NH)/2};}
function curve(a,b,cls){
  const dx=Math.max(40,(b.x-a.x)*0.5);
  return '<path class="'+cls+'" d="M '+a.x+' '+a.y+' C '+(a.x+dx)+' '+a.y+', '+(b.x-dx)+' '+b.y+', '+b.x+' '+b.y+'"/>';
}
function drawWires(){
  const ids=new Set(visibleIds());
  let h="";
  ids.forEach(id=>{
    const n=NODES[id];
    if(n.parent&&ids.has(n.parent)) h+=curve(anchorR(NODES[n.parent]),anchorL(n),"wire-p");
  });
  if(S.commOn) COMM.forEach(([a,b])=>{
    if(ids.has(a)&&ids.has(b)) h+=curve(anchorR(NODES[a]),anchorL(NODES[b]),"wire-c");
  });
  $("#wires").innerHTML=h;
}

function applyTransform(){
  const w=$("#world");
  w.style.transform="translate("+S.tx+"px,"+S.ty+"px) scale("+(S.zoom/100)+")";
  w.dataset.lod = S.zoom<60?"far":(S.zoom<88?"near":"full");
  $("#zoomPct").textContent=Math.round(S.zoom)+"%";
  $("#zoomRange").value=S.zoom;
  const c=$("#canvas"); c.scrollLeft=0; c.scrollTop=0;
}

function setZoom(z,ax,ay){
  z=Math.max(25,Math.min(200,z));
  const r=$("#canvas").getBoundingClientRect();
  if(ax==null){ax=r.left+r.width/2; ay=r.top+r.height/2;}
  const k=z/S.zoom;
  S.tx=(ax-r.left)-((ax-r.left)-S.tx)*k;
  S.ty=(ay-r.top)-((ay-r.top)-S.ty)*k;
  S.zoom=z; applyTransform();
}

function measure(){
  visibleIds().forEach(id=>{
    const el=$('#nodes .node[data-id="'+id+'"]');
    if(el) NODES[id]._h=el.offsetHeight||NH;
  });
}
function fit(ids){
  ids=ids||visibleIds();
  const r=$("#canvas").getBoundingClientRect();
  const rw=S.sideOpen?300:0;
  const aw=Math.max(200,r.width-rw-96), ah=Math.max(160,r.height-96);
  for(let pass=0;pass<2;pass++){
    let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
    ids.forEach(id=>{const n=NODES[id],h=n._h||NH;
      x0=Math.min(x0,n.pos.x); y0=Math.min(y0,n.pos.y);
      x1=Math.max(x1,n.pos.x+NW); y1=Math.max(y1,n.pos.y+h);});
    const z=Math.max(25,Math.min(150,Math.min(aw/Math.max(1,x1-x0),ah/Math.max(1,y1-y0))*100));
    S.zoom=z;
    S.tx=(r.width-rw)/2-((x0+x1)/2)*z/100;
    S.ty=r.height/2-((y0+y1)/2)*z/100;
    applyTransform();
    measure();     // LOD 档位会改节点高度：量完再算一遍
  }
}
function syncSel(){
  $$("#nodes .node").forEach(el=>el.classList.toggle("sel",S.sel.has(el.dataset.id)));
  $("#selCount").textContent=S.sel.size;
  $("#selbar").classList.toggle("on",S.sel.size>0);
}
function toggleSel(id){
  if(S.sel.has(id)) S.sel.delete(id); else S.sel.add(id);
