function renderAll(){renderNodes();drawWires();renderCrumb();renderRail();renderStat();}
let renaming=null;
function startRename(id){
  if(renaming) commitRename();
  const el=$('#nodes .node[data-id="'+id+'"]'); if(!el) return;
  const tEl=$(".n-title .t",el); const n=NODES[id];
  renaming={id,el,tEl,orig:n.title};
  tEl.contentEditable="true";
  tEl.onkeydown=(ev)=>{
    if(ev[K]==="Enter"){ ev.preventDefault(); commitRename(); }
    else if(ev[K]==="Escape"){ ev.preventDefault(); cancelRename(); }
  };
  tEl.onblur=()=>{ if(renaming&&renaming.id===id) commitRename(); };
  tEl.focus({preventScroll:true});
  const rg=document.createRange(); rg.selectNodeContents(tEl);
  const sel=window.getSelection(); sel.removeAllRanges(); sel.addRange(rg);
  $("#canvas").scrollLeft=0; $("#canvas").scrollTop=0;
}
function commitRename(){
  if(!renaming) return;
  const r=renaming; renaming=null;
  const txt=(r.tEl.textContent||"").trim()||r.orig;
  NODES[r.id].title=txt;
  r.el.setAttribute("aria-label",txt+" · "+STATE_LABEL[NODES[r.id].state]+" · "+NODES[r.id].code);
  r.tEl.textContent=txt;
  r.tEl.contentEditable="false";
  const arch=NODES[r.id].arch;
  if(arch){ const a=document.createElement("span"); a.className="archcode"; a.textContent=arch; r.tEl.appendChild(a); }
  renderCrumb(); renderRail();
  if(txt!==r.orig){
    toast("已改名 · "+txt,"撤销",()=>{
      NODES[r.id].title=r.orig;
      const t=$('#nodes .node[data-id="'+r.id+'"] .n-title .t');
      if(t){ t.textContent=r.orig; if(arch){const a=document.createElement("span");a.className="archcode";a.textContent=arch;t.appendChild(a);} }
      renderCrumb(); renderRail();
    });
  }
}
function cancelRename(){
  if(!renaming) return;
  const r=renaming; renaming=null;
  r.tEl.textContent=r.orig; r.tEl.contentEditable="false";
  const arch=NODES[r.id].arch;
  if(arch){ const a=document.createElement("span"); a.className="archcode"; a.textContent=arch; r.tEl.appendChild(a); }
}

