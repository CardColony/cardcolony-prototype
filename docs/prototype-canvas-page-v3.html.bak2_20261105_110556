}
function collapseAll(v){
  if(v) Object.keys(NODES).forEach(id=>{ if(hasKids(id)&&id!=="root") S.collapsed.add(id); });
  else S.collapsed.clear();
  renderNodes(); drawWires(); renderRail(); setTimeout(fit,30);
  toast(v?"已全部折叠 · 只留一层概览":"已全部展开 · 画布缩放到容纳全树");
