function moveMarq(e){
  const r=$("#canvas").getBoundingClientRect();
  const x2=(e.clientX-r.left-S.tx)/(S.zoom/100), y2=(e.clientY-r.top-S.ty)/(S.zoom/100);
  const l=Math.min(marq.x,x2),t=Math.min(marq.y,y2),w=Math.abs(x2-marq.x),h=Math.abs(y2-marq.y);
  marq.box.style.left=l+"px"; marq.box.style.top=t+"px";
  marq.box.style.width=w+"px"; marq.box.style.height=h+"px";
  marq.rect={l,t,r:l+w,b:t+h};
}
function endMarq(){
  const m=marq; marq=null;
  $("#canvas").classList.remove("marquee");
  if(m.box) m.box.remove();
  if(!m.rect) return;
  const r=m.rect; let n=0;
  visibleIds().forEach(id=>{
    const o=NODES[id], oh=o._h||NH;
    if(o.pos.x<r.r&&o.pos.x+NW>r.l&&o.pos.y<r.b&&o.pos.y+oh>r.t){ S.sel.add(id); n++; }
  });
  if(n){ syncSel(); toast("框选到 "+n+" 张卡"); markDragged(); }
}

function onWheel(e){
  e.preventDefault();
  if(e.ctrlKey||e.metaKey){ setZoom(S.zoom*(e.deltaY<0?1.1:0.9),e.clientX,e.clientY); return; }
  S.tx-=e.deltaX; S.ty-=e.deltaY; applyTransform();
}

