function snapTo(id,nx,ny){
  const n=NODES[id], H=n._h||NH;
  let hx=null,hy=null;
  visibleIds().forEach(k=>{
    if(k===id) return;
    const o=NODES[k], oh=o._h||NH;
    [[o.pos.x,nx],[o.pos.x+NW/2,nx+NW/2],[o.pos.x+NW,nx+NW]].forEach(([t,v])=>{
      if(Math.abs(v-t)<6){ nx+=t-v; hx=t; } });
    [[o.pos.y,ny],[o.pos.y+oh/2,ny+H/2],[o.pos.y+oh,ny+H]].forEach(([t,v])=>{
      if(Math.abs(v-t)<6){ ny+=t-v; hy=t; } });
  });
  return {nx,ny,hx,hy};
}
function showGuides(hx,hy){
  const g=$("#guides"), gx=$(".gx",g), gy=$(".gy",g);
  if(hx!=null||hy!=null){
    g.style.display="block";
    gx.style.display=hx!=null?"block":"none";
    gy.style.display=hy!=null?"block":"none";
    if(hx!=null) gx.style.left=hx+"px";
    if(hy!=null) gy.style.top=hy+"px";
  } else { g.style.display="none"; }
}
function nudgeSel(dx,dy){
  const id=[...S.sel][0]; if(!id) return;
  const n=NODES[id];
  const r=snapTo(id,n.pos.x+dx,n.pos.y+dy);
  n.pos={x:Math.round(r.nx),y:Math.round(r.ny)};
  const el=$('#nodes .node[data-id="'+id+'"]');
  if(el){ el.style.left=n.pos.x+"px"; el.style.top=n.pos.y+"px"; }
  showGuides(r.hx,r.hy);
  drawWires();
}
let drag=null,justDragged=false,pan=null,marq=null,spaceDown=false,clickTimer=null;
function markDragged(){justDragged=true;setTimeout(()=>{justDragged=false;},80);}

function moveDrag(e){
  const k=S.zoom/100;
  const dx=(e.clientX-drag.sx)/k, dy=(e.clientY-drag.sy)/k;
  if(!drag.moved){
    if(Math.hypot(e.clientX-drag.sx,e.clientY-drag.sy)<4) return;
    drag.moved=true; drag.el.classList.add("dragging");
  }
  const r=snapTo(drag.id,drag.ox+dx,drag.oy+dy);
  drag.nx=r.nx; drag.ny=r.ny;
  drag.el.style.left=r.nx+"px"; drag.el.style.top=r.ny+"px";
  showGuides(r.hx,r.hy);
  drawWires();
}
function endDrag(){
  const d=drag; drag=null;
  $("#guides").style.display="none";
  d.el.classList.remove("dragging");
  if(!d.moved) return;
  markDragged();
  const old={...d.n.pos};
  d.n.pos={x:Math.round(d.nx),y:Math.round(d.ny)};
  d.n._h=d.el.offsetHeight||NH;
  drawWires();
  toast("已移动到 ("+d.n.pos.x+", "+d.n.pos.y+")","撤销",()=>{
    d.n.pos=old; d.el.style.left=old.x+"px"; d.el.style.top=old.y+"px"; drawWires();
  });
}

