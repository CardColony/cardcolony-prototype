.st-inner{max-width:400px;text-align:center}
.st-inner h3{margin:0 0 6px;font-size:14px;font-weight:600}
.st-inner p{margin:0 0 14px;font-size:12.5px;color:var(--text2);line-height:1.6}
.st-acts{display:flex;gap:7px;justify-content:center}
.st-code{display:inline-block;font:11px var(--mono);color:var(--blocked);border:1px dashed rgba(224,101,92,.45);
  padding:1px 6px;border-radius:4px;margin-bottom:8px}
.sk{background:var(--surface2);border:1px solid var(--line);border-radius:4px}
.sk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;width:min(760px,80vw)}
