function layoutTidy(quiet){
  const COL=[70,470,870], ROW=190, TOP=70;
  const depth={}, yOf={};
  let slot=0;
  (function walk(id){
    depth[id]=depthOf(id);
    const kids=kidsOf(id).filter(k=>!NODES[k]._hidden&&!S.collapsed.has(id));
    if(!kids.length){ yOf[id]=TOP+slot*ROW; slot++; return; }
    kids.forEach(walk);
    const ys=kids.map(k=>yOf[k]);
    yOf[id]=(Math.min(...ys)+Math.max(...ys))/2;
  })("root");
  Object.keys(yOf).forEach(id=>{
    NODES[id].pos={x:COL[Math.min(depth[id],COL.length-1)], y:Math.round(yOf[id])};
  });
  Object.keys(NODES).forEach(id=>{ if(!(id in yOf)) NODES[id].pos={x:COL[Math.min(depthOf(id),2)],y:TOP}; });
  renderNodes(); drawWires();
  setTimeout(()=>{ fit(); if(!quiet) toast("已按层级整理布局"); },30);
}
function renderRail(){
  let h="";
  (function walk(id,pad){
    if(NODES[id]._hidden) return;
    const n=NODES[id], kids=hasKids(id);
    h+='<li><div class="tree-row'+(pad?" child":"")+(S.focus===id?" on":"")+'" data-go="'+id+'" style="padding-left:'+(10+pad*14)+'px">'+
      '<span class="d" style="background:var(--'+n.state+')"></span><span class="t">'+esc(n.title)+'</span>'+
      (kids?'<span class="tw" data-fold="'+id+'" title="折叠/展开">'+(S.collapsed.has(id)?"▸":"▾")+'</span>':'')+
      '</div></li>';
    if(kids&&!S.collapsed.has(id)) kidsOf(id).forEach(k=>walk(k,pad+1));
  })("root",0);
  $("#railTree").innerHTML=h;
}

function renderStat(){
  const all=Object.keys(NODES);
