const S={zoom:100,tx:60,ty:20,sel:new Set(),focus:"root",hint:true,demo:"normal",
  lod:"full",anno:false,sideOpen:true,commOn:true,theme:"light",collapsed:new Set()};
function kidsOf(id){return Object.keys(NODES).filter(k=>NODES[k].parent===id);}
function hasKids(id){return kidsOf(id).length>0;}
function visibleIds(){
  const out=[];
  (function walk(id){
    if(NODES[id]._hidden) return;
    out.push(id);
    if(S.collapsed.has(id)) return;
    kidsOf(id).forEach(walk);
  })("root");
  return out;
}
function branchIds(id){
  const out=[];
  (function walk(x){
    if(NODES[x]._hidden) return;
    out.push(x);
    if(S.collapsed.has(x)) return;
    kidsOf(x).forEach(walk);
  })(id);
  return out;
}
function depthOf(id){return chainOf(id).length-1;}
function fitIdsFor(id){return branchIds(id);}

function nodeEl(id){
  const n=NODES[id];
