}
function clearSel(){S.sel.clear(); syncSel();}

function chainOf(id){const out=[];let c=id;while(c){out.unshift(c);c=NODES[c].parent;}return out;}
function renderCrumb(){
  const ch=chainOf(S.focus);
  let h='<span class="seg'+(S.focus==="root"?" cur":"")+'" data-go="root">全景</span>';
  if(S.focus!=="root"){
    h+='<span class="sep">›</span>';
    h+=ch.slice(1).map((id,i,arr)=>'<span class="seg'+(i===arr.length-1?" cur":"")+'" data-go="'+id+'">'+esc(NODES[id].title)+'</span>').join('<span class="sep">›</span>');
  }
  $("#crumb").innerHTML=h;
}

function fitForFocus(){
  if(S.focus==="root"){ fit(); toast("已适配全树"); }
  else { fit(branchIds(S.focus)); toast("已适配「"+NODES[S.focus].title+"」这一支"); }
}
function centerOn(ids){
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  ids.forEach(id=>{const n=NODES[id],h=n._h||NH;
    x0=Math.min(x0,n.pos.x); y0=Math.min(y0,n.pos.y);
    x1=Math.max(x1,n.pos.x+NW); y1=Math.max(y1,n.pos.y+h);});
  const r=$("#canvas").getBoundingClientRect();
  const rw=S.sideOpen?300:0;
  const aw=Math.max(200,r.width-rw-96), ah=Math.max(160,r.height-96);
  const need=Math.min(aw/Math.max(1,x1-x0), ah/Math.max(1,y1-y0))*100;
  if(need<S.zoom) S.zoom=Math.max(25,need);   // 装不下才缩小，绝不主动放大成局部
  const k=S.zoom/100;
  S.tx=(r.width-rw)/2-((x0+x1)/2)*k;
  S.ty=r.height/2-((y0+y1)/2)*k;
  applyTransform();
}
function focusBranch(id){
  if(id==="root"){ unfocus(); return; }
  if(S.focus===id){ toast("已聚焦「"+NODES[id].title+"」· Esc 回全景"); return; }
  S.focus=id; S.sel.clear(); syncSel();
  renderNodes(); drawWires(); renderCrumb(); renderRail();
  centerOn(branchIds(id));
