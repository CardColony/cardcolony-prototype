/* =========================================================================
   图标库（v2）：单一几何语言 —— 24 网格 / 1.6 描边 / round 端点 / 无填充。
   命名即语义，全部按钮从这里取，不再用字形符号。
   ========================================================================= */
const ICONS={
  canvas:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  chat:'<path d="M20 12a8 8 0 0 1-8 8H4l1.6-3.2A8 8 0 1 1 20 12z"/><path d="M8.5 10.5h7M8.5 13.5h4"/>',
  doc:'<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 12h6M9 16h4"/>',
  rule:'<path d="m12 3 8 4v5c0 4.5-3.2 7.6-8 9-4.8-1.4-8-4.5-8-9V7z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  search:'<circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/>',
  minus:'<path d="M6 12h12"/>',
  plus:'<path d="M12 6v12M6 12h12"/>',
  fit:'<path d="M9 4H4v5M15 4h5v5M4 15v5h5M20 15v5h-5"/>',
  sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>',
  moon:'<path d="M20 13.5A8.5 8.5 0 0 1 10.5 4 8.5 8.5 0 1 0 20 13.5z"/>',
  more:'<circle cx="5" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="19" cy="12" r="1.4"/>',
  close:'<path d="m6 6 12 12M18 6 6 18"/>',
  list:'<path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/>',
  arch:'<rect x="3" y="3" width="18" height="5" rx="1.5"/><path d="M5 8v11a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8M10 12h4"/>',
  edit:'<path d="M16.5 4.5a2.1 2.1 0 0 1 3 3L8 19l-4 1 1-4z"/>',
  send:'<path d="m4 4 17 8-17 8 3-8z"/><path d="M7 12h14"/>',
  chevL:'<path d="m14 6-6 6 6 6"/>',
  chevR:'<path d="m10 6 6 6-6 6"/>',
  cmd:'<path d="M9 9h6v6H9zM9 9H7a2 2 0 1 1 2-2zM15 9h2a2 2 0 1 0-2-2zM9 15H7a2 2 0 1 0 2 2zM15 15h2a2 2 0 1 1-2 2z"/>',
  layers:'<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  info:'<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/>',
  play:'<path d="M7 4.5v15l12-7.5z"/>',
  pause:'<path d="M8 5v14M16 5v14"/>',
  check:'<path d="m4 12 5 5L20 6"/>',
  alert:'<path d="M12 3 2.5 20h19z"/><path d="M12 9v4M12 16.5h.01"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  link:'<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.2 1.2"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.2-1.2"/>',
  diamond:'<path d="m12 3 8 9-8 9-8-9z"/>',
  dot:'<circle cx="12" cy="12" r="3"/>',
  /* —— 七类卡的语义图标：同一 24 网格 / 1.6 描边 / round 端点 —— */
  crown:'<path d="m3 7 4.5 4L12 4l4.5 7L21 7l-1.6 11H4.6z"/><path d="M5 21h14"/>',
  branch:'<circle cx="6" cy="5" r="2.4"/><circle cx="6" cy="19" r="2.4"/><circle cx="18" cy="12" r="2.4"/><path d="M6 7.4v9.2M6 12h9.6"/>',
  cube:'<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>',
  gear:'<circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.6M12 18.6v2.6M2.8 12h2.6M18.6 12h2.6M5.5 5.5l1.8 1.8M16.7 16.7l1.8 1.8M18.5 5.5l-1.8 1.8M7.3 16.7l-1.8 1.8"/>',
  shieldCheck:'<path d="m12 3 7.5 3.2v5.1c0 4.3-3 7.2-7.5 8.7-4.5-1.5-7.5-4.4-7.5-8.7V6.2z"/><path d="m8.6 12 2.3 2.3 4.5-4.7"/>',
  pen:'<path d="M16.8 4.2a2.05 2.05 0 0 1 2.9 2.9L7.6 19.2 3.6 20.4l1.2-4z"/><path d="m14.6 6.4 3 3"/>',
  monitor:'<rect x="3" y="4" width="18" height="12" rx="1.8"/><path d="M9 20h6M12 16v4"/>',
  chevD:'<path d="m6 10 6 6 6-6"/>',
  collapse:'<path d="m8 4 4 4-4 4M16 4l-4 4 4 4"/>',
  expand:'<path d="m4 8 4-4 4 4M20 8l-4-4-4 4"/>'
};
function icon(name,cls){return '<svg class="ic '+(cls||'')+'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+(ICONS[name]||'')+'</svg>';}

/* ---- 品牌资产内联：brand/cardcolony-mark-{dark,light}-sm.svg 与 wordmark ----
   双色规则在 CSS 变量里执行：线色随主题文字色，点色 = --brand-gold。
   深色主题用 #e2a63d，浅色主题用 #c9901f（brand/README 色票）。 */
function brandMark(sz){
  return '<svg class="brand-mark" viewBox="0 0 240 240" width="'+(sz||26)+'" height="'+(sz||26)+'" aria-hidden="true">'
    +'<path d="M120 44 V32" stroke="currentColor" stroke-width="8" stroke-linecap="round" fill="none" style="color:var(--brand-line)"/>'
    +'<circle cx="120" cy="24" r="9" fill="var(--brand-gold)"/>'
    +'<path d="M180 82 C180 62 164 48 144 48 H96 C70 48 50 68 50 94 V146 C50 172 70 192 96 192 H144 C164 192 180 178 180 158" stroke="currentColor" stroke-width="30" stroke-linecap="round" fill="none" style="color:var(--brand-line)"/>'
    +'<circle cx="102" cy="114" r="14" fill="var(--brand-gold)"/>'
    +'<circle cx="142" cy="114" r="14" fill="var(--brand-gold)"/></svg>';
}
/* 字标：符号顶替首字母 C，ardColony 零间距贴排；role=img 让读屏读出完整品牌名（否则只读到 ard Colony） */
function brandWordmark(){
  return '<span class="wordmark" role="img" aria-label="CardColony">'+brandMark(24)
    +'<span class="ard" aria-hidden="true">ard</span><span class="colony" aria-hidden="true">Colony</span></span>';
}

/* ---- 把静态骨架里的字形符号一次性替换成图标（只换视觉，不动结构与 id） ---- */
function iconify(){
  const dc=document.getElementById('dpClose');
  if(dc){dc.innerHTML='<span class="ic-label">'+icon('close','ic-14')+'关闭</span>';dc.setAttribute('aria-label','关闭设计说明');}
  const map={
    railLogo:null,
    '.rail-btn[title="画布"]':'canvas','.rail-btn[title="对话"]':'chat',
    '.rail-btn[title="产物"]':'doc','.rail-btn[title="规则"]':'rule',
    '#zoomOut':'minus','#zoomIn':'plus','#fitBtn':'fit',
    '#searchBtn':'search','#moreBtn':'more'
  };
  Object.keys(map).forEach(function(sel){
    if(!map[sel])return;
    const el=document.querySelector(sel); if(el)el.innerHTML=icon(map[sel],'ic-18');
  });
  // 左栏品牌位：真正的 C 形小机器人（≤48px 用 -sm 加粗版几何）
  const lg=document.querySelector('.rail-logo'); if(lg){lg.innerHTML=brandMark(26);lg.title='CardColony';}
  $$('button[title]').forEach(function(b){if(!b.getAttribute('aria-label'))b.setAttribute('aria-label',b.title);});
  $('#moreBtn').setAttribute('aria-expanded','false');$('#moreBtn').setAttribute('aria-controls','moreMenu');
  $$('.re-seg').forEach(function(b){b.setAttribute('aria-expanded','false');});
  $$('.rail-btn').forEach(function(b){b.setAttribute('aria-pressed',b.classList.contains('on')?'true':'false');});
  $('#designBtn').setAttribute('aria-label','打开或关闭设计说明');
  const pct=document.getElementById('zoomPct');
  if(pct){pct.setAttribute('role','button');pct.tabIndex=0;pct.setAttribute('aria-label','恢复 100% 缩放');
    pct.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();setZoom(1,true);}});}
  const rp=document.getElementById('rpHandle');
  if(rp){rp.setAttribute('role','button');rp.tabIndex=0;
    rp.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();rp.click();}});}
  $$('.mm-item').forEach(function(m){m.setAttribute('role','menuitem');m.tabIndex=0;});
  $$('.dp-sec').forEach(function(s){const on=s.classList.contains('on');s.inert=!on;s.setAttribute('aria-hidden',on?'false':'true');});
  $$('.dp-tab').forEach(function(t){t.setAttribute('aria-selected',t.classList.contains('on')?'true':'false');});
  const menu=document.getElementById('moreMenu');if(menu){menu.setAttribute('role','menu');menu.setAttribute('inert','');}
  const rail=document.querySelector('.rail');if(rail){rail.setAttribute('aria-label','项目导航');}
  syncNavigationAccess();
  // 顶栏左端专属品牌位：symbol-as-C 字标，ard 线色 + Colony 点色，零间距
  const tb=document.getElementById('tbBrand'); if(tb)tb.innerHTML=brandWordmark();
  // 关闭按钮统一 ✕ → close 图标（含规则面板内的关闭）
  document.querySelectorAll('.dr-close,.fs-close').forEach(function(b){
    if(!b.querySelector('svg'))b.innerHTML=icon('close','ic-14');
  });
  // 右缘书签组三段：事件 / 规则卡 / 归档
  const segIc={ev:'list',rule:'rule',arch:'arch'};
  document.querySelectorAll('.re-seg').forEach(function(s){
    const k=s.dataset.sheet,ic=s.querySelector('.re-ic');
    if(ic&&segIc[k])ic.innerHTML=icon(segIc[k],'ic-14');
  });
  // 「设计说明」按钮：图标＋文字
  const db=document.getElementById('designBtn');
  if(db)db.innerHTML='<span class="ic-label">'+icon('layers')+'设计说明</span>';
  // 「发送」按钮：纸飞机
  const sd=document.getElementById('drSend');
  if(sd)sd.innerHTML='<span class="ic-label">'+icon('send')+'发送</span>';
  // 「演示」入口
  const dd=document.getElementById('demoDock');
  if(dd)dd.innerHTML='<span class="ic-label">'+icon('play')+'演示</span>';
  // 命令面板搜索框前的放大镜
  const ci=document.querySelector('.cmdk-in > span');
  if(ci)ci.innerHTML=icon('search','ic-14');
  // 「更多」菜单每项的语义图标（右侧原来的 ◍◧▭◐ 全部退掉）
  const mmIc={expand:'expand',collapse:'collapse',lines:'link',tip:'info',drawer:'chat',edit:'pen',states:'layers',design:'doc',rm:'pause'};
  document.querySelectorAll('.mm-item').forEach(function(it){
    const k=it.dataset.mm; if(!mmIc[k])return;
    const mk=it.querySelector('.mk');
    const sp=document.createElement('span'); sp.className='mm-ic'; sp.innerHTML=icon(mmIc[k],'ic-14');
    it.insertBefore(sp,it.firstChild);
    if(mk&&['tip','drawer','edit','states','design','expand','collapse'].indexOf(k)>=0)mk.remove();
  });
  // 主题按钮：按当前主题给太阳或月亮
  syncThemeIcon();
  // 设计说明 › 组件页：七类徽标用与画布同一套 SVG 图标渲染（规范样板必须与实物同源）
  const gk=document.getElementById('galKinds');
  if(gk){
    const col={master:'var(--k-master)',manager:'var(--k-manager)',unit:'var(--k-unit)',
      worker:'var(--k-worker)',qa:'var(--k-qa)',pm:'var(--k-pm)',ui:'var(--k-ui)'};
    gk.innerHTML=Object.keys(KIND).map(function(k){
      return '<span class="n-type" style="color:'+col[k]+';border-color:color-mix(in srgb,'+col[k]+' 45%,var(--stroke))">'
        +icon(KIND[k].ic,'ic-14')+'<span class="nt-t">'+KIND[k].n+'</span></span>';
    }).join('');
  }
  // 四态「空」态的空框图标：不再是 ▢ 字形
  const ei=document.querySelector('.emptybox .ei');
  if(ei)ei.innerHTML=icon('arch','ic-18');
}
function syncNavigationAccess(){
  const rail=document.querySelector('.rail'),body=document.querySelector('.rail-body');
  if(body){const wide=rail&&(rail.matches(':hover')||rail.contains(document.activeElement));body.inert=!wide;body.setAttribute('aria-hidden',wide?'false':'true');}
  const mm=document.getElementById('moreMenu');
  if(mm){const open=mm.classList.contains('open');mm.inert=!open;mm.setAttribute('aria-hidden',open?'false':'true');
    mm.querySelectorAll('.mm-item').forEach(function(x){x.tabIndex=open?0:-1;});}
  const panel=document.getElementById('rulePanel');
  if(panel){const closed=panel.classList.contains('closed');
    panel.querySelectorAll('.rp-tabs,.rp-body').forEach(function(x){x.inert=closed;});}
  $$('.sheet,.drawer,.fourstate,.dpanel').forEach(function(x){x.inert=!x.classList.contains('open');});
  const tip=document.getElementById('tooltip');if(tip)tip.setAttribute('aria-hidden',tip.classList.contains('on')?'false':'true');
}
function syncThemeIcon(){
  const b=document.getElementById('themeBtn'); if(!b)return;
  const dark=document.documentElement.dataset.theme==='dark';
  b.innerHTML=icon(dark?'sun':'moon','ic-18');
  b.title=dark?'切到浅色主题':'切到深色主题';
}

/* ============ DOM ============ */
const world=$('#world'), nodeLayer=$('#nodes'), svg=$('#wires'), canvas=$('#canvas'),
      stage=$('#stage'), pct=$('#zoomPct'), tooltip=$('#tooltip');
const byId={}; DATA.forEach(c=>byId[c.id]=c);
let zoom=1, tx=0, ty=0, folded=new Set(), elMap={};

/* ---------- 布局：同深度同列；纵向紧凑堆叠，父卡居中于子卡 ---------- */
function kidsOf(id){return DATA.filter(c=>c.parent===id&&!c.hidden);}
function allKidsOf(id){return DATA.filter(c=>c.parent===id);}
function layout(){
  DATA.forEach(c=>{c.x=0;c.y=0;});
  let slot=0;
  (function place(id,depth){
    const n=byId[id]; if(!n) return;
    const kids=kidsOf(id);
    if(!kids.length){ n.x=PADX+depth*(NW+GAPX); n.y=PADY+slot*ROWH; slot++; return; }
    kids.forEach(k=>place(k.id,depth+1));
    const first=kids[0], last=kids[kids.length-1];
    n.y=(first.y+last.y)/2; n.x=PADX+depth*(NW+GAPX);
  })('card_001',0);
}
/* ---------- 节点渲染（复用元素，位移才有过渡可看） ---------- */
function nodeHTML(c){
  const k=KIND[c.kind], st=STATE[c.state];
  const facts=c.facts.map(f=>'<span><i class="k">'+f[0]+'</i><b>'+f[1]+'</b></span>').join('');
  return ''+
   '<div class="n-top">'+
     '<span class="n-type" data-kind="'+c.kind+'">'+icon(k.ic,'ic-14')+'<span class="nt-t">'+k.n+'</span></span>'+
     '<span class="n-state"><i class="sd"></i>'+st+'</span>'+
     '<button class="n-model" title="'+MODEL[c.kind]+'（点开改这张卡）">'+MODEL[c.kind]+'</button>'+
     '<span class="n-count" title="子卡数">'+icon('branch','ic-14')+'<span class="nc-num">'+allKidsOf(c.id).length+'</span></span>'+
   '</div>'+
   '<div class="n-title"><span class="t" title="'+c.t+'">'+c.t+'</span>'+
     '<span class="n-acts">'+
       '<button class="n-act" data-act="chat" title="对话" aria-label="对话 '+c.t+'">'+icon('chat','ic-14')+'</button>'+
       (c.kind==='master'?'':'<button class="n-act danger" data-act="arch" title="归档整支" aria-label="归档 '+c.t+'">'+icon('arch','ic-14')+'</button>')+
       '<button class="n-act" data-act="edit" title="编辑卡面" aria-label="编辑卡面 '+c.t+'">'+icon('pen','ic-14')+'</button>'+
     '</span></div>'+
   '<div class="n-facts">'+facts+'</div>'+
   '<div class="n-last">'+c.last+'</div>'+
   (allKidsOf(c.id).length?'<button class="n-fold" title="折叠或展开子树" aria-label="折叠或展开 '+c.t+' 的子树">'+icon('branch','ic-14')+'<span class="nf-text">'+allKidsOf(c.id).length+' 项子卡</span>'+icon('chevL','ic-14 nf-chev')+'</button>':'')+
   (c.why?'<div class="rwhy">'+c.why+'</div>':'');
}
function isActive(c){return c.state==='run'||c.state==='done';}
function render(){
  DATA.forEach(c=>{
    if(c.hidden){
      const old=elMap[c.id];
      if(old){old.remove(); delete elMap[c.id];}
      return;
    }
    let el=elMap[c.id];
    if(!el){
      el=document.createElement('div');
      el.className='node'; el.dataset.id=c.id;
      el.innerHTML=nodeHTML(c);
      nodeLayer.appendChild(el); elMap[c.id]=el;
      bindNode(el,c);
    }
    el.dataset.kind=c.kind; el.dataset.state=c.state;
    el.dataset.active=isActive(c)?'true':'false';
    el.style.left=c.x+'px'; el.style.top=c.y+'px';
    /* 保留分支图标，只更新计数；此前 textContent 会把 SVG 一起抹掉 */
    const cnt=el.querySelector('.n-count');
    if(cnt&&!cnt.querySelector('.nc-num'))cnt.innerHTML=icon('branch','ic-14')+'<span class="nc-num"></span>';
    if(cnt)cnt.querySelector('.nc-num').textContent=allKidsOf(c.id).length;
    const nf=el.querySelector('.n-fold');
    if(nf){nf.querySelector('.nf-text').textContent=allKidsOf(c.id).length+' 项子卡';
      nf.setAttribute('aria-expanded',folded.has(c.id)?'false':'true');}
    el.classList.toggle('folded',folded.has(c.id));
  });
}
function relayout(anim){
  world.classList.toggle('anim',!!anim);
  nodeLayer.classList.toggle('anim',!!anim);
  layout(); render(); drawWires();
  renderTree(); stats();
  if(anim){ setTimeout(()=>{world.classList.remove('anim');nodeLayer.classList.remove('anim');},420); }
}
/* ---------- 三类线 ---------- */
function drawWires(){
  let s='';
  const vis=id=>byId[id]&&!byId[id].hidden;
  DATA.forEach(c=>{
    if(!vis(c.id))return;                      /* 隐藏卡不画任何线（否则折叠后拉出指向 0,0 的废线） */
    const p=c.parent&&byId[c.parent]; if(!p) return;
    const x1=p.x+NW, y1=p.y+56, x2=c.x, y2=c.y+56, mx=x1+46;
    s+='<path class="wire-parent" d="M'+x1+' '+y1+' H'+mx+' V'+y2+' H'+x2+'"/>';
    s+='<circle class="wire-parent-cap" cx="'+x2+'" cy="'+y2+'" r="2.4"/>';
  });
  [[ 'card_001','card_074' ],['card_257','card_4b1'],['card_074','card_346'],['card_257','card_345']]
   .forEach(([a,b])=>{
    if(!vis(a)||!vis(b))return;                /* 任一端隐藏即不画 */
    const A=byId[a],B=byId[b];
    const x1=A.x+NW,y1=A.y+56,x2=B.x,y2=B.y+56,dx=Math.max(60,(x2-x1)/2);
    const d='M'+x1+' '+y1+' C'+ (x1+dx)+' '+y1+', '+(x2-dx)+' '+y2+', '+x2+' '+y2;
    s+='<path class="wire-comm-base" d="'+d+'"/><path class="wire-comm" d="'+d+'"/>';
    s+='<circle class="wire-comm-dot" cx="'+x2+'" cy="'+y2+'" r="3"/>';
  });
  [['card_4a1','card_4b1'],['card_3a1','card_345']].forEach(([a,b])=>{
    if(!vis(a)||!vis(b))return;
    const A=byId[a],B=byId[b];
    const x1=A.x+NW,y1=A.y+78,x2=B.x,y2=B.y+78;
    s+='<path class="wire-rel" d="M'+x1+' '+y1+' L'+x2+' '+y2+'"/>';
    s+='<rect class="wire-rel-dia" x="'+(x1-4)+'" y="'+(y1-4)+'" width="8" height="8" transform="rotate(45 '+x1+' '+y1+')"/>';
    s+='<rect class="wire-rel-dia" x="'+(x2-4)+'" y="'+(y2-4)+'" width="8" height="8" transform="rotate(45 '+x2+' '+y2+')"/>';
  });
  svg.innerHTML=s;
  $('#legP').textContent=DATA.filter(c=>c.parent&&vis(c.id)).length;
  $('#legC').textContent=[['card_001','card_074'],['card_257','card_4b1'],['card_074','card_346'],['card_257','card_345']]
    .filter(p=>vis(p[0])&&vis(p[1])).length;
  $('#legR').textContent=[['card_4a1','card_4b1'],['card_3a1','card_345']]
    .filter(p=>vis(p[0])&&vis(p[1])).length;
}
/* ---------- 缩放 / LOD / 适配 ---------- */
function lod(z){const p=z*100;return p<58?'far':p<=71?'near':p<=95?'full':'ultra';}
let openSheetName='无';
function apply(){
  world.style.transform='translate('+tx+'px,'+ty+'px) scale('+zoom+')';
  world.dataset.lod=lod(zoom);
  pct.textContent=Math.round(zoom*100)+'%';
  $('#buildStamp').textContent='LOD '+world.dataset.lod+' · '+Math.round(zoom*100)+'% · '+
    (document.documentElement.dataset.theme==='light'?'浅色':'深色')+' · 浮窗:'+openSheetName+' · 视觉稿 v2';
  runLodCheck();
}
function setZoom(z,anim,anchor){
  z=Math.max(.25,Math.min(2,z));
  const cw=canvas.clientWidth, ch=canvas.clientHeight;
  const ax=anchor?anchor.x:cw/2, ay=anchor?anchor.y:ch/2;
  const px=(ax-tx)/zoom, py=(ay-ty)/zoom;
  zoom=z; tx=ax-px*zoom; ty=ay-py*zoom;
  if(anim){world.classList.add('anim');setTimeout(()=>world.classList.remove('anim'),420);}
  apply();
}
function fit(){
  const vis=DATA.filter(c=>!c.hidden); if(!vis.length) return;
  let x1=1e9,y1=1e9,x2=-1e9,y2=-1e9;
  vis.forEach(c=>{x1=Math.min(x1,c.x);y1=Math.min(y1,c.y);x2=Math.max(x2,c.x+NW);y2=Math.max(y2,c.y+112);});
  const cw=canvas.clientWidth,ch=canvas.clientHeight,pad=28;
  /* 全景优先可读：不把 15 张卡压成 44% 的小字；近档起，画布可平移/缩放探索 */
  const z=Math.max(.60,Math.min(1.15,Math.min((cw-pad*2)/(x2-x1),(ch-pad*2)/(y2-y1))));
  zoom=z; tx=(cw-(x2-x1)*z)/2-x1*z; ty=(ch-(y2-y1)*z)/2-y1*z;
  world.classList.add('anim');setTimeout(()=>world.classList.remove('anim'),420);
  apply(); runChecks();
}
function locate(id){
  const c=byId[id]; if(!c) return;
  setZoom(Math.max(zoom,.9),true,{x:canvas.clientWidth/2,y:canvas.clientHeight/2});
  tx=canvas.clientWidth/2-(c.x+NW/2)*zoom; ty=canvas.clientHeight/2-(c.y+56)*zoom;
  apply();
  const el=elMap[id]; if(el){el.classList.add('focus');setTimeout(()=>el.classList.remove('focus'),1400);}
}
/* ---------- 折叠 ---------- */
function descendants(id,out){
  out=out||[];
  DATA.filter(c=>c.parent===id).forEach(k=>{out.push(k.id);descendants(k.id,out);});
  return out;
}
function fold(id){
  const on=folded.has(id);
  const ds=descendants(id);
  if(on){folded.delete(id);ds.forEach(d=>{const n=byId[d];if(n)n.hidden=false;});}
  else{folded.add(id);ds.forEach(d=>{const n=byId[d];if(n)n.hidden=true;});}
  relayout(true); fit(); addEvent('state',(on?'展开':'折叠')+' '+id);
}
function bindNode(el,c){
  let tt=null, clickT=null;
  el.addEventListener('mouseenter',()=>{
    el.classList.add('show-why');
    tt=setTimeout(()=>showTip(c,el),260);
  });
  el.addEventListener('mouseleave',()=>{clearTimeout(tt);el.classList.remove('show-why');hideTip();});
  el.addEventListener('click',e=>{
    const act=e.target.closest('[data-act]');
    if(act){
      const a=act.dataset.act;
      if(a==='chat') openDrawer(c.id);
      else if(a==='arch') archive(c.id);
      else if(a==='edit') openCardMenu(c,act);
      return;
    }
    if(e.target.closest('.n-model')){addEvent('model','改 card '+c.id.slice(-3)+' 模型（覆盖值）');return;}
    if(e.target.closest('.n-fold')){clearTimeout(clickT);fold(c.id);return;}
    clearTimeout(clickT);
    clickT=setTimeout(()=>{ if(kidsOf(c.id).length) fold(c.id); else locate(c.id); },200);
  });
  el.addEventListener('dblclick',e=>{e.stopPropagation();clearTimeout(clickT);openDrawer(c.id);});
}
/* ---------- 卡面操作菜单：笔形钮呼出，逐项皆动作，Esc 可关 ---------- */
const STATE_SEQ=['run','done','blocked','paused','queued'];
let cmCur=null;
function closeCardMenu(){$('#cardMenu').hidden=true;cmCur=null;}
function openCardMenu(c,btn){
  cmCur=c;
  const m=$('#cardMenu');
  $('#cmTitle').textContent=c.id+' · '+c.t.slice(0,10);
  m.hidden=false;
  const r=btn.getBoundingClientRect();
  m.style.left=Math.min(r.left,innerWidth-190)+'px';
  m.style.top=Math.min(r.bottom+6,innerHeight-160)+'px';
  m.querySelector('[data-cm="title"]').focus();
}
document.addEventListener('click',e=>{
  if($('#cardMenu').hidden)return;
  if(e.target.closest('#cardMenu')||e.target.closest('[data-act="edit"]')||e.target.closest('.mm-item'))return;
  closeCardMenu();
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('#cardMenu').hidden){closeCardMenu();}});
$('#cardMenu').addEventListener('click',e=>{
  const it=e.target.closest('[data-cm]'); if(!it||!cmCur)return;
  const k=it.dataset.cm,c=cmCur,el=elMap[c.id];
  if(k==='title'){
    const t=el.querySelector('.n-title .t');t.contentEditable='true';t.focus();
  }else if(k==='state'){
    const i=(STATE_SEQ.indexOf(c.state)+1)%STATE_SEQ.length;
    c.state=STATE_SEQ[i]; el.dataset.state=c.state; render(); drawWires(); renderTree(); stats();
  }else if(k==='model'){
    addEvent('model','改 '+c.id.slice(-3)+' 模型（覆盖值）');
  }else if(k==='archive'){ archive(c.id); }
  closeCardMenu();
});
function archive(id){
  const n=byId[id]; if(!n||n.kind==='master') return;
  const all=[id].concat(descendants(id));
  all.forEach(d=>{const x=byId[d];if(x)x.hidden=true;});
  ARCH.unshift({t:n.t,id:n.id,kind:n.kind,code:'ARCH-05',why:'本页归档（可回档）'});
  addEvent('arch','归档 '+n.id+' '+n.t);
  relayout(true); fit(); renderArch();
  $('#archN').textContent=ARCH.length;
}
/* ---------- tooltip ---------- */
function showTip(c,el){
  const r=el.getBoundingClientRect(), sr=stage.getBoundingClientRect();
  $('#ttTitle').textContent=c.t;
  $('#ttCode').textContent=c.id;
  $('#ttStateText').textContent=STATE[c.state];
  $('#ttState').style.color='var(--st-'+c.state+')';
  $('#ttBody').textContent=c.last;
  tooltip.classList.add('on');tooltip.setAttribute('aria-hidden','false');
  let x=r.right-sr.left+10, y=r.top-sr.top;
  if(x+380>sr.width) x=Math.max(8,r.left-sr.left-390);
  tooltip.style.left=x+'px'; tooltip.style.top=Math.max(8,y)+'px';
}
function hideTip(){tooltip.classList.remove('on');tooltip.setAttribute('aria-hidden','true');}
/* ---------- 主题 ---------- */
function setTheme(t){
  document.documentElement.dataset.theme=t;
  syncThemeIcon();
  apply();
  runChecks();
}
/* ---------- 顶栏统计 / 底栏 / 树 ---------- */
function stats(){
  const n=DATA.filter(c=>!c.hidden).length;
  const run=DATA.filter(c=>c.state==='run'&&!c.hidden).length;
  const blk=DATA.filter(c=>c.state==='blocked'&&!c.hidden).length;
  const grey=DATA.filter(c=>!c.hidden&&!isActive(c)).length;
  $('#projectStat').innerHTML='<b>'+n+'</b> 卡 · <b>'+run+'</b> 运行中 · <b>'+blk+'</b> 受阻 · '+
    '已归档 <span class="arch" title="归档的唯一门在右缘书签">'+ARCH.length+'</span>'+
    ' · 置灰 <span class="arch" id="greyN" title="非 active：置灰 + 原因码">'+grey+'</span>';
}
function renderBar(){
  const bar=$('#modelbar');
  bar.innerHTML='<span class="mb-lead">MODEL</span>'+Object.keys(KIND).map(k=>{
    const cts=DATA.filter(c=>c.kind===k).length;
    return '<button class="mb-cell'+(cts?'':' zero')+'" data-gkind="'+k+'">'+
      '<span class="k-row"><span class="k-ic">'+icon(KIND[k].ic,'ic-14')+'</span>'+
      '<span class="k-nm">'+KIND[k].n+'</span><span class="k-ct">'+cts+'</span></span>'+
      '<span class="k-md">'+(cts?MODEL[k]:'—')+'</span></button>';
  }).join('');
  $$('.mb-cell',bar).forEach(b=>b.addEventListener('click',()=>{
    const k=b.dataset.gkind; addEvent('model','底栏改 '+KIND[k].n+' 类默认模型');
    b.style.borderColor='var(--accent)'; setTimeout(()=>b.style.borderColor='',600);
  }));
}
function renderTree(){
  const ul=$('#railTree'); ul.innerHTML='';
  (function walk(id,depth){
    const c=byId[id]; if(!c||c.hidden) return;
    const li=document.createElement('li');
    const cls=depth===0?'tree-row':depth===1?'tree-row child':'tree-row grand';
    li.innerHTML='<div class="'+cls+'" data-id="'+id+'">'+
      '<span class="d" style="background:'+(c.state==='run'?'var(--st-run)':c.state==='blocked'?'var(--st-blocked)':c.state==='paused'?'var(--st-paused)':'var(--st-done)')+'"></span>'+
      '<span class="t">'+c.t+'</span></div>';
    ul.appendChild(li);
    kidsOf(id).forEach(k=>walk(k.id,depth+1));
  })('card_001',0);
  $$('.tree-row',ul).forEach(r=>r.addEventListener('click',()=>locate(r.dataset.id)));
}
/* ---------- 事件 / 归档 / 规则卡 ---------- */
function addEvent(k,x){
  const d=new Date();
  EVENTS.unshift({tm:('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2),k:k,x:x});
  $('#evN').textContent=EVENTS.length;
  $('#evSub').textContent='共 '+EVENTS.length+' 条 · 项目级事件自动记录（不含对话）';
  renderEvents();
}
function renderEvents(){
  const EVK={arch:'归档',state:'状态',new:'建卡'};
  $('#evBody').innerHTML=EVENTS.map(e=>'<div class="ev-row"><span class="ev-t">'+e.tm+'</span>'+
    '<span class="ev-k '+(e.k==='arch'?'arch':e.k==='state'?'run':'')+'">'+(EVK[e.k]||e.k)+'</span>'+
    '<span class="ev-x">'+e.x+'</span></div>').join('');
}
function renderArch(){
  $('#archBody').innerHTML='<div class="ap-note">归档＝cards 行已删、meta 进 card_archive；画布上不再有它的节点。'+
    '归档入口只在卡面（悬停卡片，标题行右侧归档图标），这里只做记录与回档。</div>'+
    (ARCH.length?ARCH.map(a=>'<div class="ap-row"><div class="ap-main">'+
      '<div class="ap-t">'+a.t+'</div>'+
      '<div class="ap-m">'+a.id+' ｜ '+KIND[a.kind].n+' ｜ '+a.code+'</div>'+
      '<div class="ap-w">'+a.why+'</div></div>'+
      '<button class="btn" data-restore="'+a.id+'">回档</button></div>').join(''):
     '<div class="ap-empty">没有归档记录<br>归档入口在卡面：悬停卡片，标题行右侧归档图标</div>');
  $$('[data-restore]').forEach(b=>b.addEventListener('click',()=>{
    const id=b.dataset.restore, i=ARCH.findIndex(a=>a.id===id);
    if(i>=0){ARCH.splice(i,1);const n=byId[id];if(n)n.hidden=false;addEvent('new','回档 '+id);relayout(true);fit();renderArch();stats();$('#archN').textContent=ARCH.length;}
  }));
  $('#archSub').textContent=ARCH.length+' 条记录';
}
const RULES=[
 {k:'all',b:'通用',tx:'分域自治与阶段收口：根卡只管边界与放行；各域在已批准需求内自裁；只在改变范围、冻结协议、跨域返工、阶段验收、真实阻塞、对外动作六类事项上报。'},
 {k:'ui',b:'UI卡',tx:'只做界面活：写前端页面、开浏览器验效果。跑不了命令与服务——那部分交 worker 卡。结论只写页面里核到的事实。'},
 {k:'worker',b:'worker',tx:'一件任务一张卡；完工 report_done 交给系统回执主卡。'},
 {k:'function.qa',b:'QA',tx:'验收只对照已批准需求与阶段判据，不临时增加格式要求；失败、跳过、未覆盖如实写明。'}
];
function renderRules(){
  $('#ruleBody').innerHTML=RULES.map(r=>'<div class="rc-sec"><div class="rc-hd">'+
    '<span class="rc-k">## '+r.k+'</span><span>'+r.b+'</span>'+
    '<button class="btn" style="margin-left:auto;height:22px;font-size:11px">编辑</button></div>'+
    '<div class="rc-tx">'+r.tx+'</div></div>').join('')+
    '<div class="rc-sec"><div class="rc-hd"><span class="rc-k">## 说明</span></div>'+
    '<div class="rc-tx">规则卡作为节点不上画布（挂到哪支下都等于说「只有这一支受它管」），但右缘必须有入口——这段书签就是。</div></div>';
}
function renderRP(){
  $('#rpBody').innerHTML='<div class="rp-head"><div class="rp-k">视觉层待办</div>'+
    '<div class="rp-v">A 方案：重做版式、信息层级与控件形态；保留覆盖层、缩放、折叠和鼠标出口的交互语义</div></div>'+
    ['令牌两套齐备（'+TOKENS.length+' 项）','三类线两维可区分','命中区 ≥24px','四态含加载≠空','reduced-motion 降级']
    .map((t,i)=>'<div class="rp-item'+(i===0?' on':'')+'"><span class="no">V'+(i+1)+'</span><span>'+t+'</span></div>').join('');
}
/* ---------- 覆盖层开关 ---------- */
const SHEETS={ev:'#sheetEv',rule:'#sheetRule',arch:'#sheetArch'};
function closeAllSheets(){
  Object.values(SHEETS).forEach(s=>$(s).classList.remove('open'));
  $$('.re-seg').forEach(b=>{b.classList.remove('on');b.setAttribute('aria-expanded','false');});
  stage.classList.remove('sheetOpen');
  $('#drawer').classList.remove('open');
  openSheetName='无'; apply(); syncNavigationAccess();
}
function toggleSheet(k){
  const open=$(SHEETS[k]).classList.contains('open');
  closeAllSheets();
  if(!open){
    $(SHEETS[k]).classList.add('open'); stage.classList.add('sheetOpen');
    const btn=$('.re-seg[data-sheet="'+k+'"]'); if(btn){btn.classList.add('on');btn.setAttribute('aria-expanded','true');}
    openSheetName={ev:'事件',rule:'规则卡',arch:'归档'}[k]||k; apply();
    if(k==='ev'){renderEvents();}
  }
  syncNavigationAccess();
}
function openDrawer(id){
  const c=byId[id]; if(!c) return;
  closeAllSheets();
  openSheetName='对话'; apply();
  $('#drTitle').textContent=c.t; $('#drSub').textContent=c.id;
  const rows=$$('#drBody .msg');
  MSGS.slice(0,3).forEach((m,i)=>{
    const row=rows[i]; if(!row) return;
    row.querySelector('.av').textContent=m[0];
    row.querySelector('.hd b').textContent=m[1];
    row.querySelector('.hd span').textContent=m[3];
    row.querySelector('.tx').textContent=m[2];
  });
  $('#drawer').classList.add('open');
  syncNavigationAccess();
  drawCur=id;
}
let drawCur=null;
const MSGS=[['你','你','视觉稿这一轮把令牌两套先落齐，组件态排后面。','14:52'],
  ['卡','card_001','收到。三类线记得两维可分——只靠颜色不算。','15:04'],
  ['卡','card_257','已按 A 方案重做信息层级与控件位置，保留覆盖层、缩放、折叠和鼠标出口。','15:18']];
function send(){
  const v=$('#drInput').value.trim(); if(!v) return;
  const d=new Date();
  MSGS.push(['你','你',v,('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)]);
  if(MSGS.length>3) MSGS.shift();
  $('#drInput').value=''; if(drawCur)openDrawer(drawCur);
}
/* 抽屉与 tooltip 的骨架先占位，后续只改文字不改结构——
   这样点验时元素数量恒定，读数不会被「刚插进来的节点」搅乱 */
function initSkeletons(){
  $('#drBody').innerHTML=MSGS.map(()=>'<div class="msg"><div class="av"></div>'+
    '<div class="bd"><div class="hd"><b></b><span></span></div><div class="tx"></div></div></div>').join('');
  $('#tooltip').innerHTML='<div class="tt-hd"><span id="ttTitle"></span>'+
    '<span class="tt-code" id="ttCode"></span>'+
    '<span class="n-state" id="ttState" style="margin-left:auto"><i class="sd"></i>'+
    '<span id="ttStateText"></span></span></div>'+
    '<div class="tt-body" id="ttBody"></div>'+
    '<div class="tt-foot">最近 3 条 · 单击折叠/展开 · 双击对话 · 标题行右侧：改名 / 归档</div>';
}
/* ---------- 四态容器 ---------- */
const FS={
 normal:'<h5>正常</h5>'+
   '<p>卡片树已取回：15 张卡 / 3 层。这是有真实内容的样子——下面四态都是它的异常分支。</p>',
 loading:'<h5>正在取卡片树<span class="num" style="color:var(--text3)"> GET /api/canvas/cards</span></h5>'+
   '<div class="skel"><i></i><i></i><i></i></div>'+
   '<p style="margin-top:12px">加载≠空：还没有结论，所以给骨架占位，不给「一张卡都没有」。骨架与「正常」的差别只在内容真假，布局一致。</p>'+
   '<div style="margin-top:10px"><button class="btn" data-close="fourstate">关闭示例</button></div>',
 empty:'<div class="emptybox"><div class="ei">'+icon('arch','ic-18')+'</div><b>数据已取回 · 一张卡都没有</b>'+
   '<p>不是没取到——是确知为 0。卡由模型建（create_card / create_worker_card），人只看与归档。</p>'+
   '<button class="btn" data-close="fourstate">关闭示例</button></div>',
 error:'<div class="errbox"><span class="ec">502 · BAD GATEWAY</span>'+
   '<p>卡片树请求失败，保留上次结果（15 张卡）。重试走 loading → normal。</p>'+
   '<div class="acts"><button class="btn primary">重试</button>'+
   '<button class="btn" data-close="fourstate">关闭示例</button></div></div>',
 deny:'<div class="errbox" style="border-color:var(--stroke)">'+
   '<span class="ec" style="color:var(--text2)">E403 · 缺 cards:read</span>'+
   '<p>你没有这棵树的读权限。不是故障——所以不用错误红，也别指望静默重试会好。</p>'+
   '<div class="acts"><button class="btn primary">向根卡申请只读</button>'+
   '<button class="btn" data-close="fourstate">关闭示例</button></div></div>'
};
function renderFS(k){
  $$('.fs-tab').forEach(t=>t.classList.toggle('on',t.dataset.fs===k));
  $('#fsBody').innerHTML=FS[k];
  $$('[data-close="fourstate"]',$('#fsBody')).forEach(b=>b.addEventListener('click',()=>$('#fourState').classList.remove('open')));
}
/* ---------- 命令面板 ---------- */
function renderCmdk(q){
  const list=DATA.filter(c=>!c.hidden&&((c.t+' '+c.id).toLowerCase().includes((q||'').toLowerCase())));
  $('#cmdkList').innerHTML=list.map((c,i)=>'<div class="cmdk-item'+(i===0?' on':'')+'" data-id="'+c.id+'">'+
    '<span class="cd" style="background:var(--k-'+c.kind+')"></span>'+c.t+
    '<span class="cn">'+c.id+'</span></div>').join('')||
    '<div class="cmdk-item" style="color:var(--text3)">没有匹配的卡</div>';
  $$('.cmdk-item[data-id]').forEach(it=>it.addEventListener('click',()=>{
    locate(it.dataset.id); $('#cmdk').classList.remove('open'); $('#scrim').classList.remove('on');
  }));
}
/* ============ 自检：对比度 / 命中区 / 令牌齐备 ============ */
function hex2rgb(h){
  if(Array.isArray(h))return h;
  h=String(h).trim();
  if(h.startsWith('rgb')) return h.match(/\d+/g).slice(0,3).map(Number);
  h=h.replace('#','');
  if(h.length===3) h=h.split('').map(c=>c+c).join('');
  return [parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];
}
function L(rgb){
  const a=rgb.map(v=>{v/=255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4);});
  return .2126*a[0]+.7152*a[1]+.0722*a[2];
}
function ratio(a,b){const la=L(hex2rgb(a)),lb=L(hex2rgb(b));const hi=Math.max(la,lb),lo=Math.min(la,lb);return (hi+.05)/(lo+.05);}
const PAIRS=[
 ['正文 text / bg','--text','--bg',4.5],['正文 text / surface','--text','--surface',4.5],
 ['正文 text / surface2','--text','--surface2',4.5],['正文 text / raised','--text','--raised',4.5],
 ['次要 text2 / surface','--text2','--surface',4.5],['次要 text2 / surface2','--text2','--surface2',4.5],
 ['辅助 text3 / surface','--text3','--surface',4.5],['辅助 text3 / bg','--text3','--bg',4.5],
 ['辅助 text3 / surface2','--text3','--surface2',4.5],
 ['链接 accent / surface','--accent','--surface',4.5],
 ['主按钮 on-accent / accent2','--on-accent','--accent2',4.5],
 ['状态 run / surface','--st-run','--surface',4.5],['状态 done / surface','--st-done','--surface',4.5],
 ['状态 blocked / surface','--st-blocked','--surface',4.5],['状态 paused / surface','--st-paused','--surface',4.5],
 ['状态 queued / surface','--st-queued','--surface',4.5],['状态 arch / surface','--st-arch','--surface',4.5],
 ['品牌字（深墨）/ brand-gold','--brand-gold-ink','--brand-gold',4.5],
 ['非文本 stroke-strong / bg','--stroke-strong','--bg',3],['非文本 stroke-strong / surface','--stroke-strong','--surface',3],
 ['非文本 accent / surface（焦点环）','--accent','--surface',3],
 ['线 parent / bg','--wire-parent','--bg',3],['线 comm / bg','--wire-comm','--bg',3],['线 rel / bg','--wire-rel','--bg',3],
 ['类型 k-master / surface','--k-master','--surface',3],['类型 k-manager / surface','--k-manager','--surface',3],
 ['类型 k-unit / surface','--k-unit','--surface',3],['类型 k-worker / surface','--k-worker','--surface',3],
 ['类型 k-qa / surface','--k-qa','--surface',3],['类型 k-pm / surface','--k-pm','--surface',3],
 ['类型 k-ui / surface','--k-ui','--surface',3]
];
const T={}; TOKENS.forEach(t=>T[t.n]=t);
function runChecks(){
  /* ① 对比度：两套都算（用令牌字面值，与当前主题无关） */
  let rows='',fail=0;
  PAIRS.forEach(p=>{
    const d=T[p[1]],l=T[p[2]]; if(!d||!l) return;
    const rd=ratio(d.d,l.d), rl=ratio(d.l,l.l);
    const ok=rd>=p[3]&&rl>=p[3]; if(!ok)fail++;
    rows+='<div class="chk-row"><span class="st '+(ok?'pass':'fail')+'">'+(ok?'通过':'不达标')+'</span>'+
      '<span>'+p[0]+'</span><span class="val">深 '+rd.toFixed(2)+':1 ｜ 浅 '+rl.toFixed(2)+':1 ｜ 门槛 '+p[3]+':1</span></div>';
  });
  /* ③ 令牌齐备性：表里两套都有值 + 与当前主题 computed 值一致 */
  const cs=getComputedStyle(document.documentElement);
  let miss=0,mis=[],drift=[];
  const th=(document.documentElement.dataset.theme==='light')?'l':'d';
  TOKENS.forEach(t=>{
    if(!t.d||!t.l){miss++;mis.push(t.n+' 缺一套');}
    const cv=(cs.getPropertyValue(t.n)||'').trim();
    if(!cv){miss++;mis.push(t.n+' 未定义');}
    else if(cv.toLowerCase()!==String(t[th]).toLowerCase()){
      drift.push(t.n+' 期望 '+t[th]+' 实读 '+cv);
    }
  });
  const nTxt=PAIRS.filter(p=>p[3]===4.5).length, nNon=PAIRS.length-nTxt;
  $('#ctBody').innerHTML=rows+'<div class="chk-row" style="border:0;margin-top:6px">'+
    '<span class="st '+(fail?'fail':'pass')+'">'+(fail?'有 '+fail+' 对不达标':'全部达标')+'</span>'+
    '<span>共 '+PAIRS.length+' 对（文字 '+nTxt+' 对 ≥4.5:1，非文本 '+nNon+' 对 ≥3:1）</span></div>';
  $('#parityBody').innerHTML='<div class="chk-row"><span class="st '+(miss?'fail':'pass')+'">'+(miss?'缺 '+miss:'齐备')+'</span>'+
    '<span>令牌 '+TOKENS.length+' 项 × 深/浅 两套</span><span class="val">缺项 '+(mis.join('；')||'无')+'</span></div>'+
    '<div class="chk-row"><span class="st pass">同名</span><span>深色有、浅色无的令牌：0（本页两套同表生成）</span>'+
    '<span class="val">口径：TOKENS 表 vs CSS 变量同名</span></div>'+
    '<div class="chk-row"><span class="st '+(drift.length?'fail':'pass')+'">'+
    (drift.length?'漂移 '+drift.length+' 项':'与当前主题逐项一致')+'</span>'+
    '<span>当前主题「'+(th==='l'?'浅色':'深色')+'」的证法：computedStyle 读到的变量值 = 令牌表里该主题的值</span>'+
    '<span class="val">'+(drift.slice(0,4).join('；')||'0 项不一致')+'</span></div>';
  /* ② 命中区：只统计视口内、实际渲染且中心点未被遮挡的元素。
     屏幕外／未展开元素不是“通过”；画布缩放后的尺寸也真实计入。 */
  const sel='button, [role="button"], input, .tree-row, .mb-cell, .re-seg, .fs-tab, .cmdk-item, .n-fold, .node';
  const els=$$(sel).filter(e=>{
    if(e.disabled||e.closest('[inert]'))return false;
    const cs=getComputedStyle(e),r=e.getBoundingClientRect();
    if(cs.display==='none'||cs.visibility==='hidden'||r.width<=0||r.height<=0)return false;
    if(r.left<0||r.top<0||r.right>innerWidth||r.bottom>innerHeight)return false;
    const hit=document.elementFromPoint(r.left+r.width/2,r.top+r.height/2);
    return hit&&(hit===e||e.contains(hit));
  });
  let bad=[],sMinW=1e9,sMinH=1e9;
  els.forEach(e=>{
    const r=e.getBoundingClientRect();
    sMinW=Math.min(sMinW,r.width);sMinH=Math.min(sMinH,r.height);
    if(r.width<24||r.height<24)bad.push((e.id||e.dataset.id||e.className||e.tagName)+' '+r.width.toFixed(1)+'×'+r.height.toFixed(1));
  });
  $('#hitBody').innerHTML='<div class="chk-row"><span class="st '+(bad.length?'fail':'pass')+'">'+
    (bad.length?'不达标 '+bad.length+' 个':'当前视口全部 ≥24px')+'</span>'+
    '<span>可见、视口内、中心点无遮挡的可点元素 '+els.length+' 个</span>'+
    '<span class="val">屏上最小 '+(els.length?sMinW.toFixed(1):'—')+'×'+(els.length?sMinH.toFixed(1):'—')+' px</span></div>'+
    '<div class="chk-row"><span class="st '+(bad.length?'fail':'pass')+'">实测口径</span>'+
    '<span>含画布缩放（'+Math.round(zoom*100)+'%，LOD '+world.dataset.lod+'）；display/visibility、视口边界、elementFromPoint 中心遮挡均参与</span>'+
    '<span class="val">不统计屏幕外与未展开控件，不冒充全状态通过</span></div>'+
    '<div class="chk-row"><span class="st '+(world.dataset.lod==='ultra'?'pass':'')+'">覆盖边界</span>'+
    '<span>低倍率隐藏卡内小按钮，保留卡体与可见子树入口；hover/focus 菜单、off-canvas 节点、弹层内控件须各自状态复验</span>'+
    '<span class="val">本次不是全状态穷举</span></div>'+
    (bad.length?'<div class="chk-row"><span>未达标</span><span class="val" style="white-space:normal">'+bad.slice(0,8).join('；')+'</span></div>':'');
  renderTokenTable();
  runVisualAudit();
  runRmCheck();
}
/* 实际可见文字：读 DOM 的 color/opacity 与最近非透明背景，不用预设令牌替代。
   这是 DOM/计算样式检查，不等同于像素级图像验收。 */
function runVisualAudit(){
  const host=$('#visualAuditBody'); if(!host)return;
  const parse=s=>{const m=String(s).match(/[\d.]+/g);return m?m.slice(0,3).map(Number):null;};
  const blend=(f,b,a)=>f.map((v,i)=>v*a+b[i]*(1-a));
  const bgOf=el=>{
    let p=el;
    while(p&&p!==document.documentElement){const c=getComputedStyle(p).backgroundColor;
      const a=Number((c.match(/[\d.]+/g)||[])[3]===undefined?1:(c.match(/[\d.]+/g)||[])[3]);
      const rgb=parse(c);if(rgb&&a>.95)return rgb;p=p.parentElement;}
    return parse(getComputedStyle(document.body).backgroundColor);
  };
  const seen=new Set(),bad=[];let checked=0;
  $$('.node, .topbar, .modelbar, .dpanel.open, .sheet.open, .drawer.open, .fourstate.open').forEach(root=>{
    const rr=root.getBoundingClientRect();if(rr.right<0||rr.bottom<0||rr.left>innerWidth||rr.top>innerHeight)return;
    const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
    while(walker.nextNode()){
      const node=walker.currentNode,txt=node.textContent.trim();if(!txt)continue;
      const el=node.parentElement,cs=getComputedStyle(el);
      const range=document.createRange();range.selectNodeContents(node);const r=range.getBoundingClientRect();
      if(cs.display==='none'||cs.visibility==='hidden'||r.width===0||r.height===0)continue;
      if(r.right<0||r.bottom<0||r.left>innerWidth||r.top>innerHeight)continue;
      if(el.closest('.node')&&r.bottom>el.closest('.node').getBoundingClientRect().bottom+1)continue;
      const visibleAncestor=el.closest('.dp-sec');
      if(visibleAncestor&&visibleAncestor!==el&&!visibleAncestor.classList.contains('on'))continue;
      const key=el.tagName+'.'+el.className+'.'+txt;if(seen.has(key))continue;seen.add(key);
      let opacity=1,p=el;while(p&&p!==document.documentElement){opacity*=Number(getComputedStyle(p).opacity);p=p.parentElement;}
      const fg=parse(cs.color),bg=bgOf(el);if(!fg||!bg)continue;
      const value=ratio(blend(fg,bg,Math.min(1,opacity)),bg);checked++;
      if(value<4.5)bad.push((el.className||el.tagName)+'「'+txt.slice(0,20)+'」 '+value.toFixed(2)+':1');
    }
  });
  host.innerHTML='<div class="chk-row"><span class="st '+(bad.length?'fail':'pass')+'">'+(bad.length?'需修正 '+bad.length+' 处':'当前样本通过')+'</span>'+
    '<span>实际可见文字（去重） '+checked+' 处；opacity 与最近非透明背景参与合成</span><span class="val">门槛 4.5:1</span></div>'+
    '<div class="chk-row"><span class="st">范围</span><span>仅当前视口内卡片／顶栏／模型条／已打开浮层；不覆盖裁切后与图像抗锯齿</span><span class="val">非像素级验收</span></div>'+
    (bad.length?'<div class="chk-row"><span class="st fail">未过样本</span><span class="val" style="white-space:normal">'+bad.slice(0,12).join('；')+'</span></div>':'');
}
function runLodCheck(){
  const n=document.querySelector('.node'), z=Math.round(zoom*100), L=world.dataset.lod;
  if(!n||!$('#lodBody')) return;
  const g=sel=>{const e=n.querySelector(sel);return e?getComputedStyle(e):null;};
  const d=e=>e?e.display:'—', fs=e=>e?e.fontSize:'—';
  const F=g('.n-facts'), Ls=g('.n-last'), T=g('.n-type'), Ti=g('.n-title'), A=g('.n-acts'), M=g('.n-model');
  const band={far:'<58%',near:'58–71%',full:'72–95%',ultra:'≥96%'}[L];
  const rows=[
    ['当前档位', L+'（'+band+'）· '+z+'%'],
    ['.n-facts 事实行', 'display:'+d(F)],
    ['.n-last 最近一条', 'display:'+d(Ls)],
    ['.n-type 类型徽标', 'font-size:'+fs(T)+(L==='far'?'（文字收起·只留图标）':'')],
    ['.n-title 标题', 'font-size:'+fs(Ti)],
    ['.n-acts / .n-model 卡内控件', 'display:'+d(A)+' / '+d(M)+
      ((L==='far'||L==='near')?'（收起：屏上不足 24px）':'')]
  ];
  $('#lodBody').innerHTML=rows.map(r=>'<div class="chk-row"><span class="st pass">实测</span><span>'+
    r[0]+'</span><span class="val">'+r[1]+'</span></div>').join('');
}
function runRmCheck(){
  const w=$('.wire-comm'), n=$('.node[data-state="run"] .sd'), sk=$('.skel i');
  const an_=el=>el?getComputedStyle(el).animationName:'—';
  const aw=an_(w), an=an_(n), as=an_(sk);
  const on=document.body.classList.contains('rm');
  $('#rmBody').innerHTML=
    '<div class="chk-row"><span class="st '+(on?'pass':'')+'">'+(on?'降级开':'降级关')+'</span>'+
    '<span>通信线流星 animation-name</span><span class="val">'+aw+'</span></div>'+
    '<div class="chk-row"><span class="st '+(on?'pass':'')+'">'+(on?'降级开':'降级关')+'</span>'+
    '<span>运行中呼吸（状态色点 .sd）animation-name</span><span class="val">'+an+'</span></div>'+
    '<div class="chk-row"><span class="st '+(on?'pass':'')+'">'+(on?'降级开':'降级关')+'</span>'+
    '<span>骨架条 shimmer animation-name（四态·加载）</span><span class="val">'+as+'</span></div>'+
    '<div class="chk-row"><span class="st pass">功能不缺</span><span>降级后仍可点：节点 '+
      DATA.filter(c=>!c.hidden).length+' 个 · 书签 3 段 · 顶栏 6 钮 · 卡体单击/双击/tooltip 全在</span>'+
      '<span class="val">降级只去动效</span></div>';
}
function renderTokenTable(){
  $('#tkBody').innerHTML=TOKENS.map(t=>{
    const sw=(v)=>'<span class="sw" style="background:'+v+'"></span>'+v;
    return '<tr><td class="nm">'+t.n+'</td><td class="uc">'+t.use+'</td>'+
      '<td class="vl">'+sw(t.d)+'</td><td class="vl">'+sw(t.l)+'</td></tr>';
  }).join('');
}

/* ============ 事件绑定 ============ */
$('#zoomOut').addEventListener('click',()=>setZoom(zoom-.1,true));
$('#zoomIn').addEventListener('click',()=>setZoom(zoom+.1,true));
$('#zoomPct').addEventListener('click',()=>setZoom(1,true));
$('#fitBtn').addEventListener('click',fit);
$('#themeBtn').addEventListener('click',()=>setTheme(document.documentElement.dataset.theme==='dark'?'light':'dark'));
$('#rmChk').addEventListener('change',e=>{document.body.classList.toggle('rm',e.target.checked);runChecks();});
$$('.rail-btn').forEach(b=>b.addEventListener('click',()=>{
  $$('.rail-btn').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',x===b?'true':'false');});
  const name=b.title;
  if(name==='画布'){fit();}
  if(name==='对话'){openDrawer('card_257');}
  if(name==='产物'){$('#designBtn').click();$('.dp-tab[data-tab="gal"]').click();}
  if(name==='规则'){$('#rulePanel').classList.remove('closed');stage.classList.add('side');syncRpHandle();syncNavigationAccess();}
}));
$('#searchBtn').addEventListener('click',()=>{$('#cmdk').classList.add('open');$('#scrim').classList.add('on');$('#cmdkInput').focus();renderCmdk('');});
$('#scrim').addEventListener('click',()=>{$('#cmdk').classList.remove('open');$('#scrim').classList.remove('on');});
$('#cmdkInput').addEventListener('input',e=>renderCmdk(e.target.value));
$('#moreBtn').addEventListener('click',e=>{
  e.stopPropagation();const open=$('#moreMenu').classList.toggle('open');
  $('#moreBtn').setAttribute('aria-expanded',open?'true':'false');syncNavigationAccess();
  if(open){const first=$('.mm-item');if(first)first.focus();}
});
$$('.mm-item').forEach(it=>it.addEventListener('click',()=>{
  const k=it.dataset.mm; $('#moreMenu').classList.remove('open');syncNavigationAccess();
  if(k==='lines'){const on=world.classList.toggle('nolines');$('#mmLines').textContent=on?'关':'开';}
  if(k==='states'){$('#fourState').classList.add('open');openSheetName='四态';apply();syncNavigationAccess();runChecks();}
  if(k==='design'){$('#dpanel').classList.remove('open');syncNavigationAccess();$('#designBtn').click();}
  if(k==='tip'){const c=byId['card_001'];
    const el=document.querySelector('.node[data-id="card_001"]')||document.body; if(c)showTip(c,el);}
  if(k==='drawer')openDrawer('card_257');
  if(k==='edit'){const c=byId['card_074'];
    const el=document.querySelector('.node[data-id="card_074"]');
    if(c&&el){const b=el.querySelector('[data-act="edit"]');if(b)openCardMenu(c,b);}}
  if(k==='rm'){const on=document.body.classList.toggle('rm');$('#mmRm').textContent=on?'开':'关';
    const c=$('#rmChk'); if(c)c.checked=on; runChecks();}
  if(k==='expand'){folded.clear();DATA.forEach(c=>c.hidden=false);relayout(true);fit();}
  if(k==='collapse'){DATA.forEach(c=>{if(c.parent)folded.add(c.parent);});DATA.forEach(c=>{if(c.parent)c.hidden=true;});relayout(true);fit();}
}));
$$('.re-seg').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();toggleSheet(b.dataset.sheet);}));
$$('[data-close]').forEach(b=>b.addEventListener('click',e=>{
  e.stopPropagation();
  const k=b.dataset.close;
  if(k==='fourstate'){$('#fourState').classList.remove('open');openSheetName='无';apply();syncNavigationAccess();}
  else if(k==='cmdk'){$('#cmdk').classList.remove('open');$('#scrim').classList.remove('on');}
  else if(SHEETS[k])closeAllSheets();
  else if(k==='drawer'){$('#drawer').classList.remove('open');syncNavigationAccess();}
}));
function syncRpHandle(){
  const open=!$('#rulePanel').classList.contains('closed');
  $('#rpHandle').innerHTML=icon(open?'chevR':'chevL','ic-14');
  $('#rpHandle').title=open?'收起规则面板':'展开规则面板';
}
$('#rpHandle').addEventListener('click',()=>{
  const p=$('#rulePanel'); p.classList.toggle('closed');
  const open=!p.classList.contains('closed');
  stage.classList.toggle('side',open); syncRpHandle();syncNavigationAccess();
});
$('#rpClose').addEventListener('click',()=>{$('#rulePanel').classList.add('closed');stage.classList.remove('side');syncRpHandle();syncNavigationAccess();});
$('#demoDock').addEventListener('click',()=>{
  const p=$('#fourState'); p.classList.toggle('open');
  openSheetName=p.classList.contains('open')?'四态':'无'; apply();syncNavigationAccess();runChecks();
});
$$('.fs-tab').forEach(t=>t.addEventListener('click',()=>renderFS(t.dataset.fs)));
$('#drSend').addEventListener('click',send);
$('#drInput').addEventListener('keydown',e=>{if(e.key==='Enter')send();});
$('#designBtn').addEventListener('click',()=>{
  const open=$('#dpanel').classList.toggle('open');syncNavigationAccess();
  if(open){runChecks();runLodCheck();}else $('#designBtn').focus();
});
$('#dpClose').addEventListener('click',()=>{$('#dpanel').classList.remove('open');syncNavigationAccess();$('#designBtn').focus();});
$$('.dp-tab').forEach(t=>t.addEventListener('click',()=>{
  $$('.dp-tab').forEach(x=>{const on=x===t;x.classList.toggle('on',on);x.setAttribute('aria-selected',on?'true':'false');});
  $$('.dp-sec').forEach(s=>{const on=s.id==='sec-'+t.dataset.tab;
    s.classList.toggle('on',on);s.inert=!on;s.setAttribute('aria-hidden',on?'false':'true');});
  runChecks();
}));
$$('.opt').forEach(o=>{
  $$('.cd',o).forEach(cd=>cd.addEventListener('click',()=>{
    $$('.cd',o).forEach(x=>x.classList.remove('sel')); cd.classList.add('sel');
    o.dataset.pick=cd.dataset.v;
  }));
});
document.addEventListener('click',e=>{
  if(!e.target.closest('#moreMenu')&&!e.target.closest('#moreBtn')){$('#moreMenu').classList.remove('open');syncNavigationAccess();}
  if(!e.target.closest('.re-group')&&!e.target.closest('.sheet')&&!e.target.closest('.drawer')&&!e.target.closest('#moreMenu'))closeAllSheets();
  if(!e.target.closest('#tooltip')&&!e.target.closest('.node')&&!e.target.closest('#moreMenu'))hideTip();
});
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#searchBtn').click();}
  if(e.key==='Escape'){
    if($('#dpanel').classList.contains('open')){$('#dpClose').click();return;}
    if($('#cmdk').classList.contains('open')){$('#cmdk').classList.remove('open');$('#scrim').classList.remove('on');$('#searchBtn').focus();return;}
    if($('#moreMenu').classList.contains('open')){$('#moreMenu').classList.remove('open');syncNavigationAccess();$('#moreBtn').focus();return;}
    if($('#fourState').classList.contains('open')){$('#fourState').classList.remove('open');syncNavigationAccess();$('#demoDock').focus();return;}
    closeAllSheets();
  }
});
/* 画布手势：拖空白平移、滚轮平移、Ctrl+滚轮以光标为锚缩放（手势永不过渡） */
let dragging=false,lx=0,ly=0;
canvas.addEventListener('mousedown',e=>{
  if(e.target.closest('.node')) return;
  dragging=true;lx=e.clientX;ly=e.clientY;canvas.style.cursor='grabbing';world.classList.remove('anim');
});
window.addEventListener('mousemove',e=>{
  if(!dragging)return;
  tx+=e.clientX-lx; ty+=e.clientY-ly; lx=e.clientX; ly=e.clientY; apply();
});
window.addEventListener('mouseup',()=>{dragging=false;canvas.style.cursor='default';});
canvas.addEventListener('wheel',e=>{
  e.preventDefault();
  if(e.ctrlKey||e.metaKey){
    const r=canvas.getBoundingClientRect();
    setZoom(zoom*(e.deltaY>0?.92:1.08),false,{x:e.clientX-r.left,y:e.clientY-r.top});
  }else{
    tx-=e.deltaX; ty-=e.deltaY; world.classList.remove('anim'); apply();
  }
},{passive:false});

/* ============ 启动 ============ */
iconify(); syncRpHandle();
renderTree(); renderBar(); renderEvents(); renderArch(); renderRules(); renderRP(); renderFS('normal');
initSkeletons();
stats(); relayout(false); apply(); setTimeout(fit,30); runChecks();
window.__cv={setZoom,fit,setTheme,locate,fold,toggleSheet,openDrawer:openDrawerById,runChecks,
  get state(){return {zoom:zoom,tx:tx,ty:ty,lod:world.dataset.lod,theme:document.documentElement.dataset.theme};}};
function openDrawerById(id){openDrawer(id);}
})();
</script>
</body>
</html>

