<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>画布页 · 视觉设计稿 v2 · 品牌与图标</title>
<style>
/* =========================================================================
   画布页视觉设计稿 v2 · 品牌与图标 —— 单文件 / 零外链 / file:// 直开
   A 方案：保留 v3 的区域职责与交互语义；卡片、顶栏、信息层级与控件位置重新设计。
   新卡面 312×112；全景优先可读（≥60%），不强行把三层树压成小字。
   v2 相比 v1 的三件实质改动：
     ① 真正的品牌：brand/ 的 C 形小机器人与 symbol-as-C 字标内联，蜂蜜金只进品牌标
     ② 全套 SVG 图标：24 网格 / 1.6 描边 / round 端点，替掉所有随字体漂移的字形符号
     ③ 审美打磨层（本文件 CSS 末尾）：状态从「整卡边框染色」改为「顶部 2px 发丝线＋色点」，
        标题提为主角，模型名/事实行降为等宽辅助，框架后退、画布为前景
   令牌两套（深/浅）同名齐备——见脚本 TOKENS 表，页内「设计说明 › 自检」逐对比对
   ========================================================================= */
:root{
  /* ---- 背景层级：三级明度台阶，画布永远最深、浮层永远最亮 ---- */
  --bg:#0c1015; --surface:#12171e; --surface2:#171e27; --raised:#1f2731;
  /* ---- 线：line 只作装饰分隔（不作信息载体）；stroke 弱边界；stroke-strong ≥3:1 承载边界信息 ---- */
  --line:#232c37; --stroke:#3c4a58; --stroke-strong:#66798d;
  /* ---- 文字 ---- */
  --text:#e9eff6; --text2:#adbccb; --text3:#8296a8; --text-disabled:#5b6b7b;
  /* ---- 强调：只给主操作、选中、焦点环。品牌蜂蜜金不进强调色（brand/README.md 红线） ---- */
  --accent:#7aa2f7; --accent2:#5f88e0; --accent-weak:rgba(122,162,247,.14); --on-accent:#0b1220;
  /* ---- 状态色：运行中/已完成/受阻/已暂停/排队中/归档 ---- */
  --st-run:#3fc7b4; --st-done:#5cbf7a; --st-blocked:#ec6f63; --st-paused:#d7a03e;
  --st-queued:#8fa4c0; --st-arch:#8b97a3;
  /* ---- 类型色：七类，三处同源（卡面左条 / 类型徽标 / 底部模型条同名格） ---- */
  --k-master:#b9c9ff; --k-manager:#93a9de; --k-unit:#9aa6b4; --k-worker:#6fa8dc;
  --k-qa:#5cbf7a; --k-pm:#b48ce8; --k-ui:#e0a24a;
  /* ---- 三类线 ---- */
  --wire-parent:#8296a8; --wire-comm:#7aa2f7; --wire-rel:#b48ce8;
  /* ---- 品牌色：只出现在品牌标，绝不用于状态、按钮、徽标 ---- */
  --brand-gold:#e2a63d;
  --brand-line:#e6edf3;
  --brand-gold-ink:#1a1408;
  /* ---- 阴影：只表层级，不作装饰（1 卡 2 面板 3 浮层/弹窗） ---- */
  --shadow-1:0 1px 2px rgba(0,0,0,.50);
  --shadow-2:0 8px 24px rgba(0,0,0,.45);
  --shadow-3:0 18px 48px rgba(0,0,0,.55);
  /* ---- 圆角 ---- */
  --r-card:6px; --r-ctl:6px; --r-panel:8px; --r-float:10px; --r-modal:14px;
  /* ---- 间距（4 的倍数；--s* 全部落在这个阶上） ---- */
  --s1:4px; --s2:8px; --s3:12px; --s4:16px; --s5:24px; --s6:32px;
  /* ---- 字体 ---- */
  --f-ui:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Segoe UI",system-ui,sans-serif;
  --f-mono:ui-monospace,SFMono-Regular,"Cascadia Mono",Consolas,monospace;
  --fs-title:16px; --fs-head:14px; --fs-body:13px; --fs-2:12px; --fs-3:11px; --fs-4:10px;
  --lh:1.6; --lh-tight:1.35;
  /* ---- 动效节奏（只定视觉节奏，不改交互语义） ---- */
  --t-fast:120ms; --t-mid:200ms; --t-slow:280ms; --t-canvas:400ms;
  --ease:cubic-bezier(.4,0,.2,1); --ease-move:cubic-bezier(.22,.75,.2,1);
  --hit:24px;
}
html[data-theme="light"]{
  --bg:#f1f2f0; --surface:#ffffff; --surface2:#f7f8f6; --raised:#ffffff;
  --line:#e2e4e0; --stroke:#c9cfc9; --stroke-strong:#77817a;
  --text:#161f28; --text2:#46566a; --text3:#5d6b7a; --text-disabled:#98a2ac;
  --accent:#1f5fd1; --accent2:#1a4faf; --accent-weak:rgba(31,95,209,.10); --on-accent:#ffffff;
  --st-run:#0f6f63; --st-done:#1d6b3c; --st-blocked:#a3231e; --st-paused:#8a5a00;
  --st-queued:#4a5b74; --st-arch:#5d6b7a;
  --k-master:#2a4a9c; --k-manager:#3a5b96; --k-unit:#5b6672; --k-worker:#1f5f9e;
  --k-qa:#1d6b3c; --k-pm:#6b3fa0; --k-ui:#8a5a00;
  --wire-parent:#5d6b7a; --wire-comm:#1f5fd1; --wire-rel:#6b3fa0;
  --brand-gold:#c9901f;
  --brand-line:#1c2733;
  --brand-gold-ink:#1a1408;
  --shadow-1:0 1px 2px rgba(0,0,0,.07);
  --shadow-2:0 6px 18px rgba(0,0,0,.10);
  --shadow-3:0 16px 40px rgba(0,0,0,.14);
}
*{box-sizing:border-box}

/* =========================================================================
   图标体系（v2）：24 viewBox / 1.6 描边 / round 端点 / 单色 currentColor。
   全部 icon 走 SVG——不用字形符号（▦◧⌕✕…），字形随字体漂移，图标不漂。
   .ic 默认 16px；.ic-14 用于紧凑行；命中区由外层 .icon/.n-act 保证 ≥24px。
   ========================================================================= */
.ic{width:16px;height:16px;flex:none;display:block;stroke:currentColor;fill:none;
  stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.ic-14{width:14px;height:14px}
.ic-18{width:18px;height:18px}
.icon .ic{pointer-events:none}
button>.ic{margin:0}
.btn .ic{width:14px;height:14px}
/* 图标按钮内部加标签时，图标与文字之间留 6px，不再用空格凑 */
.ic-label{display:inline-flex;align-items:center;gap:6px}

/* =========================================================================
   品牌资产（v2）：brand/ 的 C 形小机器人与字标内联，零外链。
   线色 = C 笔身＋天线杆＋"ard"；点色 = 双目＋天线珠＋"Colony"。
   蜂蜜金 --brand-gold 只出现在这两处，永不进按钮/徽标/状态。
   ========================================================================= */
.brand-line{color:var(--brand-line)}
.brand-point{color:var(--brand-gold)}
.brand-mark{width:22px;height:22px;flex:none;display:block}
/* 严格保留品牌资产原始描边比例；不使用 non-scaling-stroke */
.brand-mark path,.brand-mark circle{vector-effect:none}
/* 字标：符号即首字母 C，ard 与 Colony 贴排零间距（brand/README 红线） */
.wordmark{display:inline-flex;align-items:center;gap:0;line-height:1;
  font-family:"Segoe UI",system-ui,sans-serif;font-weight:650;letter-spacing:.2px;
  font-size:19px;white-space:nowrap}
.wordmark svg{width:24px;height:24px;margin-right:-2px}
.wordmark .ard{color:var(--brand-line)}
.wordmark .colony{color:var(--brand-gold)}
html,body{margin:0;height:100%;overflow:hidden}
body{font-family:var(--f-ui);font-size:var(--fs-body);line-height:var(--lh);
  background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;
  transition:background var(--t-mid) var(--ease),color var(--t-mid) var(--ease)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
input{font:inherit;color:inherit}
::selection{background:var(--accent-weak)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.num{font-family:var(--f-mono);font-variant-numeric:tabular-nums}

/* ===== 控件：按钮四型 × 五态 ===== */
.btn{min-height:var(--hit);height:var(--hit);padding:0 10px;border:1px solid var(--stroke);
  border-radius:var(--r-ctl);background:var(--surface2);color:var(--text2);
  display:inline-flex;align-items:center;gap:var(--s1);font-size:var(--fs-2);
  transition:background var(--t-fast),border-color var(--t-fast),color var(--t-fast);
  white-space:nowrap}
.btn:hover{background:var(--surface);border-color:var(--stroke-strong);color:var(--text)}
.btn:active{background:var(--accent-weak);border-color:var(--accent);color:var(--text)}
.btn.primary{background:var(--accent2);border-color:var(--accent2);color:var(--on-accent);font-weight:600}
.btn.primary:hover{filter:brightness(1.08);color:var(--on-accent)}
.btn.primary:active{filter:brightness(.92)}
.btn.danger{border-color:color-mix(in srgb,var(--st-blocked) 55%,var(--stroke));color:var(--st-blocked)}
.btn.danger:hover{background:color-mix(in srgb,var(--st-blocked) 12%,var(--surface2));border-color:var(--st-blocked)}
.btn.link{border-color:transparent;background:none;color:var(--accent);padding:0 4px}
.btn.link:hover{text-decoration:underline;background:none}
.btn[disabled],.btn.is-disabled{opacity:.5;cursor:not-allowed;pointer-events:none}
.btn.is-loading{color:transparent;position:relative;cursor:progress}
.btn.is-loading::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:12px;
  margin:-6px 0 0 -6px;border-radius:50%;border:2px solid var(--accent);border-right-color:transparent;
  animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.icon{width:var(--hit);height:var(--hit);border-radius:var(--r-ctl);display:inline-flex;
  align-items:center;justify-content:center;color:var(--text2);
  transition:background var(--t-fast),color var(--t-fast)}
.icon:hover{background:var(--surface2);color:var(--text)}
.icon:active{transform:translateY(.5px)}
.icon.on{background:var(--accent-weak);color:var(--accent)}
.field{height:var(--hit);border:1px solid var(--stroke-strong);border-radius:var(--r-ctl);
  background:var(--surface2);padding:0 var(--s2);color:var(--text);font-size:var(--fs-2);
  outline:none;width:100%;transition:border-color var(--t-fast),box-shadow var(--t-fast)}
.field:focus{border-color:var(--accent);box-shadow:0 0 0 1px color-mix(in srgb,var(--accent) 45%,transparent)}
.field::placeholder{color:var(--text3)}
.field:hover{border-color:var(--stroke-strong)}
.field:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-weak)}
.kbd{font-family:var(--f-mono);font-size:var(--fs-4);padding:2px 4px;border:1px solid var(--stroke);
  border-radius:4px;color:var(--text3);background:var(--surface2)}

/* ===== 框架：左栏 44／顶栏 44／画布／右列 300／底部条 44 ===== */
.work-page{display:flex;height:100vh;width:100vw;position:relative}
.rail{width:44px;flex:0 0 44px;background:var(--surface);border-right:1px solid var(--line);
  position:relative;z-index:35}
.rail-inner{position:absolute;left:0;top:0;width:260px;height:100%;background:var(--surface);
  border-right:1px solid var(--line);transform:translateX(-216px);
  transition:transform var(--t-mid) var(--ease);display:flex;flex-direction:column}
.rail:hover .rail-inner{transform:translateX(0);box-shadow:var(--shadow-2)}
.rail-icons{width:44px;padding:var(--s2) 0;display:flex;flex-direction:column;align-items:center;
  gap:2px;flex:0 0 44px}
/* 品牌位（v2）：不再是金方块＋字母 C，而是 brand/ 的真实 mark。
   ≤48px 用 -sm 加粗版（粗 C、大双目）——这是品牌规范对小尺寸的明确要求。 */
.rail-logo{width:32px;height:32px;display:grid;place-items:center;margin-bottom:var(--s2)}
.rail-logo svg{width:26px;height:26px}
.rail-wordmark{padding:2px var(--s4) 6px}
.rail-btn{width:32px;height:32px;border-radius:var(--r-ctl);display:grid;place-items:center;
  color:var(--text3);font-size:14px}
.rail-btn:hover{background:var(--surface2);color:var(--text)}
.rail-btn.on{background:var(--accent-weak);color:var(--accent)}
.rail-body{flex:1;min-width:0;padding:var(--s3) 0;overflow:auto;opacity:0;
  transition:opacity var(--t-fast)}
.rail:hover .rail-body{opacity:1;transition-delay:60ms}
.rail-sec{padding:var(--s2) var(--s4) var(--s1);font-size:var(--fs-4);letter-spacing:.08em;
  text-transform:uppercase;color:var(--text3)}
.tree{list-style:none;margin:0;padding:0 var(--s2)}
.tree li{margin:1px 0}
.tree-row{display:flex;align-items:center;gap:6px;height:26px;padding:0 6px;
  border-radius:5px;cursor:pointer;color:var(--text2);font-size:var(--fs-2);
  white-space:nowrap;overflow:hidden}
.tree-row:hover{background:var(--surface2);color:var(--text)}
.tree-row.on{background:var(--accent-weak);color:var(--accent);font-weight:600}
.tree-row .d{width:6px;height:6px;border-radius:50%;flex:0 0 6px}
.tree-row.child{padding-left:22px}
.tree-row.grand{padding-left:36px}
.chk{display:flex;align-items:center;gap:8px;padding:0 var(--s4);font-size:var(--fs-2);
  color:var(--text2);cursor:pointer;min-height:var(--hit)}
.chk input{appearance:none;-webkit-appearance:none;width:var(--hit);height:var(--hit);
  border:0;background:none;position:relative;cursor:pointer;padding:0}
.chk input::before{content:"";position:absolute;left:4px;top:4px;width:14px;height:14px;
  border:1px solid var(--stroke-strong);border-radius:4px;background:var(--surface2)}
.chk input:checked::before{background:var(--accent);border-color:var(--accent)}
.chk input:checked::after{content:"";position:absolute;left:9px;top:7px;width:5px;height:9px;
  border:solid var(--on-accent);border-width:0 2px 2px 0;transform:rotate(45deg)}
.main{flex:1;min-width:0;display:flex;flex-direction:column;position:relative}
.topbar{height:44px;flex:0 0 44px;display:flex;align-items:center;gap:var(--s2);
  padding:0 10px;background:var(--surface);border-bottom:1px solid var(--line);
  position:relative;z-index:30}
.crumb{display:flex;align-items:center;gap:5px;font-size:var(--fs-2);min-width:0}
.crumb .seg{color:var(--text2);padding:2px 4px;border-radius:4px;white-space:nowrap;cursor:default}
.crumb .seg.cur{color:var(--text);font-weight:600}
.crumb .sep{color:var(--text3);font-size:var(--fs-3)}
.stat{display:flex;align-items:center;gap:9px;font-size:var(--fs-3);color:var(--text3);
  padding:0 var(--s2);border-left:1px solid var(--line)}
.stat b{color:var(--text2);font-weight:600}
.stat .arch{color:var(--text3);cursor:default}
.build{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);
  padding:3px 7px;border:1px solid var(--line);border-radius:4px}
.tb-spacer{flex:1}
/* 顶栏分区（v2）：品牌 / 上下文 / 视图 / 全局，靠细分隔线切开，不再一字排开挤在左边 */
.tb-div{width:1px;height:18px;background:var(--line);flex:none;margin:0 2px}
.tb-brand{display:inline-flex;align-items:center;flex:none;padding-right:2px}
.tb-acts{display:flex;align-items:center;gap:4px;flex:none}
.zoomgrp{display:flex;align-items:center;gap:2px;padding:0 var(--s1);
  border-left:1px solid var(--line)}
.zoomgrp .lbl{font-family:var(--f-mono);font-size:var(--fs-3);color:var(--text2);width:44px;
  text-align:center;cursor:pointer;padding:4px 0;border-radius:4px;min-height:var(--hit);
  display:grid;place-items:center}
.zoomgrp .lbl:hover{background:var(--surface2);color:var(--text)}
.stage{flex:1;min-height:0;position:relative;overflow:hidden;background:var(--bg);
  --rp:0px;--mbh:44px}
.stage.side{--rp:300px}
.canvas{position:absolute;top:0;left:0;bottom:var(--mbh);right:0;overflow:clip;cursor:default;
  touch-action:none;transition:right var(--t-mid) var(--ease)}
.world{position:absolute;left:0;top:0;width:2600px;height:1800px;transform-origin:0 0;
  will-change:transform}
.world.anim{transition:transform var(--t-canvas) var(--ease-move)}
#wires{position:absolute;left:0;top:0;width:2600px;height:1800px;pointer-events:none;overflow:visible}
#nodes{position:absolute;left:0;top:0}

/* ===== 底部全局模型条 44px 常驻：一格一类 ===== */
.modelbar{position:absolute;left:0;right:var(--rp);bottom:0;height:var(--mbh);z-index:52;
  display:flex;align-items:center;gap:2px;padding:0 10px;overflow-x:auto;overflow-y:hidden;
  background:var(--surface);border-top:1px solid var(--line);
  transition:right var(--t-mid) var(--ease);scrollbar-width:none}
.modelbar::-webkit-scrollbar{display:none}
.mb-lead{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);letter-spacing:.1em;
  padding-right:9px;flex:none;border-right:1px solid var(--line);margin-right:5px;line-height:16px}
.mb-cell{display:flex;flex-direction:column;justify-content:center;gap:2px;height:34px;
  padding:0 9px;border-radius:var(--r-ctl);flex:none;border:1px solid var(--stroke);
  background:var(--surface2);color:var(--text2);min-height:var(--hit);
  transition:background var(--t-fast),border-color var(--t-fast),color var(--t-fast)}
.mb-cell:hover{background:var(--surface);border-color:var(--stroke-strong);color:var(--text)}
.mb-cell:active{transform:translateY(.5px)}
.mb-cell .k-row{display:flex;align-items:center;gap:5px;line-height:11px}
.mb-cell .k-ic{display:inline-flex;align-items:center;line-height:1}
.mb-cell .k-ic .ic{width:11px;height:11px}
.mb-cell .k-nm{font-size:var(--fs-4);line-height:11px;letter-spacing:.01em}
.mb-cell .k-md{font-family:var(--f-mono);font-size:var(--fs-4);line-height:11px;
  color:var(--text);white-space:nowrap}
.mb-cell .k-ct{font-family:var(--f-mono);font-size:9px;color:var(--text3);margin-left:auto}
.mb-cell.zero{opacity:.55}
.mb-cell[data-gkind="master"] .k-ic,.mb-cell[data-gkind="master"] .k-nm{color:var(--k-master)}
.mb-cell[data-gkind="manager"] .k-ic,.mb-cell[data-gkind="manager"] .k-nm{color:var(--k-manager)}
.mb-cell[data-gkind="unit"] .k-ic,.mb-cell[data-gkind="unit"] .k-nm{color:var(--k-unit)}
.mb-cell[data-gkind="worker"] .k-ic,.mb-cell[data-gkind="worker"] .k-nm{color:var(--k-worker)}
.mb-cell[data-gkind="qa"] .k-ic,.mb-cell[data-gkind="qa"] .k-nm{color:var(--k-qa)}
.mb-cell[data-gkind="pm"] .k-ic,.mb-cell[data-gkind="pm"] .k-nm{color:var(--k-pm)}
.mb-cell[data-gkind="ui"] .k-ic,.mb-cell[data-gkind="ui"] .k-nm{color:var(--k-ui)}
/* ===== 卡片节点 290×84 起（尺寸不动，只换皮） ===== */
.node{position:absolute;width:312px;min-height:148px;background:var(--surface);overflow:hidden;
  border:1px solid var(--stroke-strong);border-radius:var(--r-card);
  display:flex;flex-direction:column;transform-origin:50% 50%;user-select:none;
  transition:border-color var(--t-fast),box-shadow var(--t-fast),background var(--t-fast),
    opacity var(--t-slow),filter var(--t-slow)}
#nodes.anim .node{transition:left 380ms var(--ease-move),top 380ms var(--ease-move),
    transform 380ms var(--ease-move),border-color var(--t-fast),box-shadow var(--t-fast),
    background var(--t-fast),opacity var(--t-slow)}
.node:hover{border-color:var(--accent);box-shadow:var(--shadow-2)}
.node.focus{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),var(--shadow-2)}
/* 类型的三重可触知维度：左条粗细＝结构深度；实/虚线＝组织位置 vs 干活；底明度＝压面 vs 浮起 */
.node::before{content:"";position:absolute;left:0;top:0;bottom:0;width:0;
  border-radius:var(--r-card) 0 0 var(--r-card);pointer-events:none}
.node[data-kind="master"]::before{width:4px;background:var(--k-master)}
.node[data-kind="manager"]::before{width:3px;background:var(--k-manager)}
.node[data-kind="unit"]::before{width:2px;background:var(--k-unit)}
.node[data-kind="worker"],.node[data-kind="qa"],.node[data-kind="pm"],.node[data-kind="ui"]{
  background:var(--raised);border-style:dashed;border-color:var(--stroke)}
.n-top{display:flex;align-items:center;gap:7px;padding:7px 13px 0}
.n-type{font-size:var(--fs-4);letter-spacing:.02em;padding:1px 5px;border-radius:4px;
  background:var(--surface2);color:var(--text2);border:1px solid var(--stroke);
  white-space:nowrap;display:inline-flex;align-items:center;gap:4px;flex:none}
/* 类型图标是真 SVG，不再是 ::before 的字形——图标取色由 [data-kind] 统一给 */
.n-type .ic{width:11px;height:11px}
.node[data-kind="master"] .n-type{background:var(--k-master);color:var(--bg);
  border-color:var(--k-master);font-weight:700}
.node[data-kind="manager"] .n-type{color:var(--k-manager);border-color:var(--k-manager);background:transparent}
.node[data-kind="unit"] .n-type{color:var(--k-unit);border-color:var(--k-unit);background:transparent}
.node[data-kind="worker"] .n-type .ic{color:var(--k-worker)}
.node[data-kind="qa"] .n-type .ic{color:var(--k-qa)}
.node[data-kind="pm"] .n-type .ic{color:var(--k-pm)}
.node[data-kind="ui"] .n-type .ic{color:var(--k-ui)}
.node[data-kind="ui"] .n-type{border-color:color-mix(in srgb,var(--k-ui) 45%,var(--stroke))}
.node[data-kind="pm"] .n-type{border-color:color-mix(in srgb,var(--k-pm) 45%,var(--stroke))}
.node[data-kind="qa"] .n-type{border-color:color-mix(in srgb,var(--k-qa) 45%,var(--stroke))}
.node[data-kind="worker"] .n-type{border-color:color-mix(in srgb,var(--k-worker) 45%,var(--stroke))}
.n-state{display:inline-flex;align-items:center;gap:5px;font-size:var(--fs-4);
  color:var(--text2);padding:1px 6px 1px 5px;border-radius:4px;background:var(--surface2);
  white-space:nowrap;flex:none}
.n-state .sd{width:6px;height:6px;border-radius:50%;flex:0 0 6px;background:var(--text3)}
.n-model{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text2);background:transparent;
  border:1px solid var(--stroke);border-radius:4px;padding:0 5px;line-height:22px;
  cursor:pointer;white-space:nowrap;max-width:124px;overflow:hidden;text-overflow:ellipsis;
  min-height:var(--hit)}
.n-model:hover{color:var(--text);border-color:var(--accent);background:var(--surface2)}
.n-count{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);margin-left:auto;flex:none;
  display:inline-flex;align-items:center;gap:3px}
.n-count .ic{width:10px;height:10px;opacity:.7}
.n-title{font-size:15px;font-weight:600;line-height:1.4;padding:5px 13px 0;color:var(--text);
  display:flex;align-items:flex-start;gap:5px;min-height:20px}
.node[data-kind="master"] .n-title{font-size:16px;letter-spacing:.01em}
.n-title .t{flex:1;min-width:0;word-break:break-word}
.n-facts{display:flex;flex-wrap:wrap;gap:0 13px;padding:7px 13px 0;
  font-size:var(--fs-2);color:var(--text3)}
.n-facts span{white-space:nowrap;display:inline-flex;gap:4px}
.n-facts b{color:var(--text2);font-weight:600}
.n-facts .k{color:var(--text3)}
.n-last{display:none;padding:7px 13px 0;font-size:var(--fs-2);color:var(--text2);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.n-acts{margin-left:auto;display:flex;gap:2px;opacity:0;transition:opacity var(--t-fast)}
.node:hover .n-acts{opacity:1}
.n-act{width:24px;height:24px;border-radius:5px;display:grid;place-items:center;
  color:var(--text3);font-size:var(--fs-3)}
.n-act:hover{background:var(--surface2);color:var(--accent)}
.n-act.danger:hover{color:var(--st-blocked)}
.n-pad{height:8px}
/* 状态：运行中＝呼吸（唯一会动的状态），其余静止 —— 一眼看出「还在跑」vs「可以看结果」 */
.node[data-state="run"] .sd{background:var(--st-run)}
.node[data-state="run"] .n-state{color:var(--st-run)}
/* 运行中的边框不再整体染色（见 v2 打磨层：状态走顶部发丝线＋色点，边框保持中性） */
@keyframes breathe{
  0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--st-run) 55%,transparent);opacity:.9}
  60%{box-shadow:0 0 0 7px transparent;opacity:.55}
  100%{box-shadow:0 0 0 0 transparent;opacity:.9}}
.node[data-state="done"] .sd{background:var(--st-done)}
.node[data-state="done"] .n-state{color:var(--st-done)}
.node[data-state="paused"] .sd{background:var(--st-paused)}
.node[data-state="paused"] .n-state{color:var(--st-paused)}
.node[data-state="blocked"] .sd{background:var(--st-blocked)}
.node[data-state="blocked"] .n-state{color:var(--st-blocked)}
/* 受阻的边框同样不再整体染色（v2：红色发丝线＋红色状态点已足够醒目） */
.node[data-state="queued"] .sd{background:var(--st-queued)}
.node[data-state="queued"] .n-state{color:var(--st-queued)}
/* 非 active（子树被折叠或状态停住）：置灰 + 原因码——灰不是「不存在」，理由要写在卡上 */
.node[data-active="false"]{filter:saturate(.35);opacity:.62}
.node[data-active="false"] .n-state{color:var(--text3)}
.node[data-active="false"] .n-state .sd{background:var(--text3)}
.rcode{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--st-blocked);
  border:1px dashed color-mix(in srgb,var(--st-blocked) 45%,transparent);
  padding:0 4px;border-radius:4px;margin-left:var(--s1);white-space:nowrap}
.rwhy{display:none;padding:6px 13px 9px;font-size:var(--fs-3);color:var(--text2);
  border-top:1px dashed var(--line);margin-top:7px;line-height:1.5}
.node.show-why .rwhy{display:block}
/* ---- LOD 四档：far<58% / near 58-71% / full 72-95% / ultra≥96% ---- */
.world[data-lod="far"] .n-facts,.world[data-lod="far"] .n-last,
.world[data-lod="near"] .n-last,.world[data-lod="full"] .n-last{display:none}
.world[data-lod="ultra"] .n-facts{display:none}
.world[data-lod="ultra"] .n-last{display:block}
/* far 档只留类型图标：文字隐去，SVG 图标放大顶出来（色相＋形状双线索，缩到 40% 仍认得出类） */
.world[data-lod="far"] .n-type{padding:2px 4px;gap:0}
.world[data-lod="far"] .n-type .nt-t{display:none}
.world[data-lod="far"] .n-type .ic{width:12px;height:12px}
.world[data-lod="far"] .n-title{font-size:13px;padding-top:4px}
.world[data-lod="far"] .n-model{font-size:9px;line-height:14px;max-width:78px;padding:0 3px}
.world[data-lod="far"] .node{min-height:64px}
.world[data-lod="far"] .n-state{font-size:9px}
/* far / near 档卡内不渲染小控件（模型条 20~22px 高、操作钮 24px）：缩小后它们屏上只剩 12~17px，
   命中区跌破 24px。删掉它们，交互改由卡体单击（折叠/定位）/双击（对话）/悬停 tooltip 承担，功能不缺 */
.world[data-lod="far"] .n-acts,.world[data-lod="far"] .n-model{display:none}
.world[data-lod="near"] .n-acts,.world[data-lod="near"] .n-model{display:none}
/* far 档状态字看不清时用左缘 3px 色条顶出来（状态仍可扫） */
.world[data-lod="far"] .node[data-state="blocked"],
.world[data-lod="far"] .node[data-state="paused"],
.world[data-lod="far"] .node[data-state="queued"]{border-left-width:3px}
.world[data-lod="far"] .node[data-state="blocked"]{border-left-color:var(--st-blocked)}
.world[data-lod="far"] .node[data-state="paused"]{border-left-color:var(--st-paused)}
.world[data-lod="far"] .node[data-state="queued"]{border-left-color:var(--st-queued)}

/* ===== 三类线：两维可区分（颜色 + 线型/端点标记），不只靠颜色 ===== */
.wire-parent{stroke:var(--wire-parent);stroke-width:1.5px;fill:none;stroke-linejoin:miter;
  stroke-dasharray:none}
.wire-parent-cap{fill:var(--wire-parent);stroke:none}
.wire-comm{stroke:var(--wire-comm);stroke-width:1.6px;fill:none;opacity:.85;
  stroke-dasharray:64 320;stroke-linecap:round;
  animation:meteor 2.6s linear infinite}
@keyframes meteor{from{stroke-dashoffset:384}to{stroke-dashoffset:0}}
.wire-comm-base{stroke:var(--wire-comm);stroke-width:1px;fill:none;opacity:.22}
.wire-comm-dot{fill:var(--wire-comm)}
.wire-rel{stroke:var(--wire-rel);stroke-width:1.6px;fill:none;stroke-dasharray:2 6;
  stroke-linecap:round;opacity:.9}
.wire-rel-dia{fill:var(--wire-rel)}
.wire-lab{font-family:var(--f-mono);font-size:10px;fill:var(--text3)}
.world.nolines .wire-rel,.world.nolines .wire-rel-dia{display:none}

/* ===== 右缘书签组：三段相接 gap=0，一端外圆、中缝直角 ===== */
.re-group{position:absolute;right:calc(var(--rp) + 10px);top:32%;transform:translateY(-50%);
  display:flex;flex-direction:column;gap:0;z-index:44;
  transition:right var(--t-mid) var(--ease)}
.stage.sheetOpen .re-group{right:calc(var(--rp) + 414px)}
.re-seg{display:flex;flex-direction:column;align-items:center;gap:5px;padding:9px 6px;
  background:var(--surface);border:1px solid var(--stroke-strong);border-right:0;
  color:var(--text2);cursor:pointer;min-height:var(--hit);
  transition:color var(--t-fast),background var(--t-fast)}
.re-seg + .re-seg{border-top:0}
.re-group .re-seg:first-child{border-radius:var(--r-card) 0 0 0}
.re-group .re-seg:last-child{border-radius:0 0 0 var(--r-card)}
.re-seg:hover,.re-seg.on{color:var(--accent);background:var(--surface2)}
.re-seg .re-ic{font-size:13px;line-height:1}
.re-seg .re-tx{font-size:var(--fs-4);writing-mode:vertical-rl;letter-spacing:.14em;line-height:1}
.re-seg .re-n{font-family:var(--f-mono);font-size:9px;color:var(--text3)}
.re-seg.on .re-n{color:var(--accent)}

/* ===== 右列规则面板 300px（默认收起，展开时画布让位） ===== */
.rule-panel{position:absolute;top:0;right:0;bottom:0;width:300px;background:var(--surface);
  border-left:1px solid var(--stroke-strong);z-index:40;display:flex;flex-direction:column;
  transition:transform var(--t-mid) var(--ease);box-shadow:var(--shadow-2)}
.rule-panel.closed{transform:translateX(300px)}
.rp-tabs{display:flex;align-items:center;border-bottom:1px solid var(--line);
  height:36px;flex:0 0 36px;padding-right:6px}
.rp-tab{height:36px;padding:0 11px;font-size:var(--fs-2);color:var(--text3);
  border-bottom:2px solid transparent;display:flex;align-items:center;min-height:var(--hit)}
.rp-tab:hover{color:var(--text2)}
.rp-tab.on{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
.rp-body{flex:1;overflow:auto;padding:10px 12px}
.rp-handle{position:absolute;left:-26px;top:50%;transform:translateY(-50%);width:26px;height:64px;
  background:var(--surface);border:1px solid var(--stroke-strong);border-right:0;
  border-radius:var(--r-card) 0 0 var(--r-card);display:grid;place-items:center;
  color:var(--text2);cursor:pointer;z-index:41;font-size:13px;min-height:var(--hit)}
.rp-handle:hover{color:var(--accent);background:var(--surface2)}
.rp-head{padding:10px 12px 8px;border-bottom:1px solid var(--line)}
.rp-k{font-size:var(--fs-2);font-weight:600;color:var(--text);display:flex;
  align-items:center;gap:6px}
.rp-k::before{content:"";width:6px;height:6px;border-radius:2px;background:var(--accent)}
.rp-v{font-size:var(--fs-3);color:var(--text3);margin-top:3px;line-height:1.5}
.rp-item{display:flex;align-items:flex-start;gap:8px;padding:8px 4px;
  border-bottom:1px solid var(--line);font-size:var(--fs-2);color:var(--text2)}
.rp-item .no{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);flex:none;
  width:34px;padding-top:2px}
.rp-item.on{color:var(--text)}

/* ===== 浮层：对话 / 事件 / 规则卡 / 归档（贴右缘，上下留 10px） ===== */
.sheet,.drawer{position:absolute;top:10px;bottom:10px;right:calc(var(--rp) + 10px);
  background:var(--surface);border:1px solid var(--stroke-strong);border-radius:var(--r-float);
  z-index:46;display:flex;flex-direction:column;box-shadow:var(--shadow-3);
  transform:translateX(112%);opacity:0;pointer-events:none;
  transition:transform var(--t-slow) var(--ease),right var(--t-mid) var(--ease),opacity 160ms}
.sheet.open,.drawer.open{transform:translateX(0);opacity:1;pointer-events:auto}
.drawer{width:392px}
.sheet{width:404px}
.sheet.w432{width:432px}
.dr-head{height:44px;flex:0 0 44px;display:flex;align-items:center;gap:8px;
  padding:0 12px;border-bottom:1px solid var(--line)}
.dr-title{font-size:var(--fs-body);font-weight:600}
.dr-sub{font-size:var(--fs-3);color:var(--text3)}
.dr-close{margin-left:auto;width:var(--hit);height:var(--hit);border-radius:var(--r-ctl);
  display:grid;place-items:center;color:var(--text2)}
.dr-close:hover{background:var(--surface2);color:var(--text)}
.dr-body{flex:1;overflow:auto;padding:12px}
.msg{display:flex;gap:9px;padding:9px 0;border-bottom:1px solid var(--line)}
.msg:last-child{border-bottom:0}
.msg .av{width:22px;height:22px;border-radius:6px;flex:none;display:grid;place-items:center;
  font-family:var(--f-mono);font-size:9px;background:var(--surface2);color:var(--text2);
  border:1px solid var(--stroke)}
.msg .bd{min-width:0}
.msg .hd{display:flex;align-items:baseline;gap:7px;font-size:var(--fs-3);color:var(--text3)}
.msg .hd b{color:var(--text2);font-size:var(--fs-2);font-weight:600}
.msg .tx{font-size:var(--fs-2);color:var(--text2);margin-top:3px;line-height:1.65}
.dr-foot{border-top:1px solid var(--line);padding:10px 12px;display:flex;gap:8px;align-items:center;
  background:var(--surface2);border-radius:0 0 var(--r-float) var(--r-float)}
/* —— 卡面操作菜单（笔形钮呼出）：就地小菜单，逐项皆动作 —— */
.card-menu{position:fixed;z-index:80;min-width:168px;background:var(--raised);
  border:1px solid var(--stroke-strong);border-radius:var(--r-float);box-shadow:var(--shadow-3);
  padding:4px;display:flex;flex-direction:column;gap:1px}
.card-menu[hidden]{display:none}
.cm-head{font-size:var(--fs-4);color:var(--text3);padding:6px 10px 4px;letter-spacing:.04em}
.cm-item{display:flex;align-items:center;gap:8px;height:30px;padding:0 10px;border-radius:var(--r-ctl);
  font-size:var(--fs-2);color:var(--text2);text-align:left;background:none;border:0;cursor:pointer}
.cm-item:hover{background:var(--surface2);color:var(--text)}
.cm-item.danger{color:var(--st-blocked)}
.ev-row{display:flex;align-items:flex-start;gap:9px;padding:9px 12px;border-bottom:1px solid var(--line)}
.ev-t{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);flex:none;width:70px}
.ev-k{font-family:var(--f-mono);font-size:9px;flex:none;padding:1px 5px;line-height:15px;
  border-radius:4px;border:1px solid var(--stroke);color:var(--text2)}
.ev-k.run{color:var(--st-run);border-color:color-mix(in srgb,var(--st-run) 50%,var(--stroke))}
.ev-k.arch{color:var(--st-arch);border-color:color-mix(in srgb,var(--st-arch) 50%,var(--stroke))}
.ev-x{font-size:var(--fs-2);color:var(--text2);min-width:0;line-height:1.6}
.ap-row{display:flex;align-items:flex-start;gap:9px;padding:10px 12px;border-bottom:1px solid var(--line)}
.ap-main{min-width:0;flex:1}
.ap-t{font-size:var(--fs-2);font-weight:600;color:var(--text)}
.ap-m{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);margin-top:2px}
.ap-w{font-size:var(--fs-3);color:var(--text2);margin-top:4px;line-height:1.6}
.ap-note{padding:9px 12px;font-size:var(--fs-3);line-height:1.7;color:var(--text3);
  border-bottom:1px solid var(--line);background:var(--surface2)}
.ap-empty{padding:22px 12px;text-align:center;font-size:var(--fs-2);color:var(--text3);
  line-height:1.8}
.rc-sec{padding:11px 12px;border-bottom:1px solid var(--line)}
.rc-hd{display:flex;align-items:center;gap:6px;font-size:var(--fs-2);font-weight:600;color:var(--text)}
.rc-hd .rc-k{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);font-weight:400}
.rc-tx{font-size:var(--fs-2);line-height:1.75;color:var(--text2);margin-top:6px;white-space:pre-wrap}
.rc-meta{font-family:var(--f-mono);font-size:var(--fs-4);line-height:1.7;color:var(--text3);
  padding:9px 12px;border-bottom:1px solid var(--line)}

/* ===== 命令面板 / 更多菜单 / tooltip / 四态 / 演示坞 ===== */
.scrim{position:absolute;inset:0;background:color-mix(in srgb,var(--bg) 55%,transparent);
  z-index:60;opacity:0;pointer-events:none;transition:opacity var(--t-mid)}
.scrim.on{opacity:1;pointer-events:auto}
.cmdk{position:absolute;left:50%;top:76px;transform:translate(-50%,-8px);width:520px;
  background:var(--surface);border:1px solid var(--stroke-strong);border-radius:var(--r-modal);
  box-shadow:var(--shadow-3);z-index:70;opacity:0;pointer-events:none;
  transition:opacity var(--t-mid),transform var(--t-mid)}
.cmdk.open{opacity:1;pointer-events:auto;transform:translate(-50%,0)}
.cmdk-in{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid var(--line)}
.cmdk-in .field{border:0;background:none;height:32px;font-size:var(--fs-head)}
.cmdk-list{max-height:320px;overflow:auto;padding:6px}
.cmdk-item{display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:var(--r-ctl);
  cursor:pointer;font-size:var(--fs-2);color:var(--text2);min-height:var(--hit)}
.cmdk-item:hover,.cmdk-item.on{background:var(--accent-weak);color:var(--text)}
.cmdk-item .cd{width:6px;height:6px;border-radius:50%;flex:none}
.cmdk-item .cn{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);margin-left:auto}
.cmdk-foot{display:flex;align-items:center;gap:10px;padding:8px 12px;border-top:1px solid var(--line);
  font-size:var(--fs-3);color:var(--text3)}
.moremenu{position:absolute;right:calc(var(--rp) + 92px);top:46px;width:230px;
  background:var(--surface);border:1px solid var(--stroke-strong);border-radius:var(--r-float);
  box-shadow:var(--shadow-3);z-index:65;padding:6px;opacity:0;pointer-events:none;
  transform:translateY(-6px);transition:opacity var(--t-fast),transform var(--t-fast)}
.moremenu.open{opacity:1;pointer-events:auto;transform:translateY(0)}
.mm-item{display:flex;align-items:center;gap:9px;padding:7px 9px;border-radius:5px;
  font-size:var(--fs-2);color:var(--text2);cursor:pointer;min-height:var(--hit)}
.mm-item:hover{background:var(--surface2);color:var(--text)}
.mm-item .mk{margin-left:auto;font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3)}
.mm-ic{display:inline-flex;color:var(--text3);flex:none}
.mm-item:hover .mm-ic{color:var(--text2)}
.mm-sep{height:1px;background:var(--line);margin:5px 4px}
.tooltip{position:absolute;z-index:80;width:auto;min-width:250px;max-width:460px;
  background:var(--surface);border:1px solid var(--stroke-strong);border-radius:var(--r-float);
  box-shadow:var(--shadow-3);padding:10px 12px;opacity:0;pointer-events:none;
  transition:opacity 150ms;font-size:var(--fs-2);color:var(--text2)}
.tooltip.on{opacity:1}
.tt-hd{display:flex;align-items:baseline;gap:7px;font-size:var(--fs-2);font-weight:600;color:var(--text)}
.tt-hd .tt-code{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3);font-weight:400}
.tt-body{margin-top:6px;line-height:1.7;white-space:pre-wrap;word-break:break-word}
.tt-foot{margin-top:8px;padding-top:7px;border-top:1px solid var(--line);
  font-size:var(--fs-3);color:var(--text3);line-height:1.6}
.demo-dock{position:absolute;left:calc(var(--rp) + 0px);left:12px;top:10px;height:28px;
  padding:0 10px;border-radius:14px;background:var(--surface);border:1px solid var(--stroke-strong);
  color:var(--text2);font-size:var(--fs-3);z-index:45;display:inline-flex;align-items:center;
  gap:6px;box-shadow:var(--shadow-1);min-height:28px}
.demo-dock:hover{color:var(--text);border-color:var(--accent)}
.fourstate{position:absolute;left:12px;bottom:calc(var(--mbh) + 12px);width:372px;height:250px;
  background:var(--surface);border:1px solid var(--stroke-strong);border-radius:var(--r-float);
  box-shadow:var(--shadow-3);z-index:56;display:flex;flex-direction:column;overflow:hidden;
  opacity:0;transform:translateY(6px);pointer-events:none;
  transition:opacity var(--t-mid),transform var(--t-mid)}
.fourstate.open{opacity:1;transform:translateY(0);pointer-events:auto}
.fs-tabs{display:flex;align-items:center;gap:2px;padding:6px 8px;border-bottom:1px solid var(--line)}
.fs-tab{height:26px;padding:0 9px;border-radius:5px;font-size:var(--fs-3);color:var(--text3);
  display:grid;place-items:center;min-height:26px}
.fs-tab:hover{background:var(--surface2);color:var(--text2)}
.fs-tab.on{background:var(--accent-weak);color:var(--accent);font-weight:600}
.fs-close{margin-left:auto;width:26px;height:26px;display:grid;place-items:center;
  color:var(--text3);border-radius:5px}
.fs-close:hover{background:var(--surface2);color:var(--text)}
.fs-body{flex:1;padding:12px;font-size:var(--fs-2);color:var(--text2);overflow:auto}
.fs-body h5{margin:0 0 8px;font-size:var(--fs-2);color:var(--text)}
.fs-body p{margin:0;font-size:var(--fs-3);color:var(--text3);line-height:1.7}
.skel{display:flex;flex-direction:column;gap:9px}
.skel i{display:block;height:11px;border-radius:4px;
  background:linear-gradient(90deg,var(--surface2) 25%,var(--raised) 37%,var(--surface2) 63%);
  background-size:400% 100%;animation:shimmer 1.4s linear infinite}
@keyframes shimmer{from{background-position:100% 0}to{background-position:0 0}}
.skel i:nth-child(1){width:62%}.skel i:nth-child(2){width:88%}.skel i:nth-child(3){width:74%}
.emptybox{display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:8px;height:100%;text-align:center}
.emptybox .ei{width:38px;height:38px;border-radius:10px;border:1px dashed var(--stroke-strong);
  display:grid;place-items:center;color:var(--text3);font-size:16px}
.emptybox b{font-size:var(--fs-2);color:var(--text2);font-weight:600}
.emptybox p{max-width:270px;font-size:var(--fs-3);color:var(--text3);line-height:1.7}
.errbox{border:1px solid color-mix(in srgb,var(--st-blocked) 45%,var(--stroke));
  border-radius:var(--r-panel);padding:10px 12px;background:color-mix(in srgb,var(--st-blocked) 7%,var(--surface))}
.errbox .ec{font-family:var(--f-mono);font-size:var(--fs-3);color:var(--st-blocked)}
.errbox p{margin-top:6px;color:var(--text2);font-size:var(--fs-3);line-height:1.7}
.errbox .acts{margin-top:9px;display:flex;gap:7px}

/* ===== 设计说明面板（覆盖层，带可见关闭） ===== */
.dpanel{position:fixed;top:0;right:0;bottom:0;width:min(880px,92vw);background:var(--bg);
  border-left:1px solid var(--stroke-strong);box-shadow:var(--shadow-3);z-index:120;
  display:flex;flex-direction:column;transform:translateX(102%);
  transition:transform var(--t-slow) var(--ease)}
.dpanel.open{transform:translateX(0)}
.dp-head{height:48px;flex:0 0 48px;display:flex;align-items:center;gap:10px;
  padding:0 var(--s4);border-bottom:1px solid var(--line);background:var(--surface)}
.dp-title{font-size:var(--fs-head);font-weight:600}
.dp-sub{font-size:var(--fs-3);color:var(--text3)}
.dp-tabs{display:flex;gap:2px;margin-left:auto;align-items:center}
.dp-tab{height:30px;padding:0 11px;border-radius:6px;font-size:var(--fs-2);color:var(--text3);
  display:grid;place-items:center;min-height:var(--hit)}
.dp-tab:hover{background:var(--surface2);color:var(--text2)}
.dp-tab.on{background:var(--accent-weak);color:var(--accent);font-weight:600}
.dp-body{flex:1;overflow:auto;padding:var(--s5) var(--s5) 64px}
.dp-sec{display:none}
.dp-sec.on{display:block}
.dp-sec h3{margin:0 0 6px;font-size:var(--fs-head);color:var(--text)}
.dp-sec .lead{font-size:var(--fs-2);color:var(--text3);line-height:1.75;margin:0 0 var(--s4);
  max-width:760px}
.dp-sec h4{margin:var(--s5) 0 var(--s2);font-size:var(--fs-2);color:var(--text2);
  letter-spacing:.04em}
table.tk{border-collapse:separate;border-spacing:0;width:100%;font-size:var(--fs-3)}
table.tk th{text-align:left;padding:7px 9px;background:var(--surface2);color:var(--text2);
  font-weight:600;border-bottom:1px solid var(--line);position:sticky;top:0}
table.tk td{padding:6px 9px;border-bottom:1px solid var(--line);color:var(--text2);
  vertical-align:middle}
table.tk td.nm{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text)}
table.tk td.uc{color:var(--text3);font-size:var(--fs-3)}
table.tk td.vl{font-family:var(--f-mono);font-size:var(--fs-4);white-space:nowrap}
.sw{display:inline-block;width:14px;height:14px;border-radius:4px;vertical-align:-3px;
  margin-right:7px;border:1px solid var(--stroke)}
.dec{border-left:2px solid var(--accent);padding:2px 0 2px var(--s3);margin:0 0 var(--s4)}
.dec b{display:block;font-size:var(--fs-2);color:var(--text);margin-bottom:3px}
.dec p{margin:0;font-size:var(--fs-2);color:var(--text3);line-height:1.75}
.opt{border:1px solid var(--stroke);border-radius:var(--r-panel);padding:var(--s3);
  margin-bottom:var(--s3);background:var(--surface)}
.opt .oh{display:flex;align-items:center;gap:8px;font-size:var(--fs-2);font-weight:600;
  color:var(--text);margin-bottom:6px}
.opt .oq{font-size:var(--fs-3);color:var(--text3);margin:0 0 var(--s2);line-height:1.7}
.opt .cand{display:flex;gap:var(--s2);flex-wrap:wrap}
.opt .cd{border:1px solid var(--stroke);border-radius:var(--r-ctl);padding:8px 10px;
  font-size:var(--fs-3);color:var(--text2);background:var(--surface2);cursor:pointer;
  min-height:var(--hit);display:flex;align-items:center;gap:7px}
.opt .cd:hover{border-color:var(--accent);color:var(--text)}
.opt .cd.sel{border-color:var(--accent);background:var(--accent-weak);color:var(--text);
  box-shadow:0 0 0 1px var(--accent) inset}
.opt .cd .tag{font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text3)}
.opt .note{font-size:var(--fs-3);color:var(--text3);margin-top:var(--s2);line-height:1.7}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:var(--s3)}
.gcard{border:1px solid var(--stroke);border-radius:var(--r-panel);background:var(--surface);
  padding:var(--s3)}
.gcard h6{margin:0 0 9px;font-size:var(--fs-3);color:var(--text3);font-weight:600;
  letter-spacing:.04em}
.grow{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.chk-row{display:flex;align-items:center;gap:9px;padding:5px 0;font-size:var(--fs-3);
  color:var(--text2);border-bottom:1px dotted var(--line)}
.chk-row .st{font-family:var(--f-mono);font-size:var(--fs-4);padding:1px 6px;border-radius:4px}
.pass{color:var(--st-done);background:color-mix(in srgb,var(--st-done) 12%,transparent)}
.fail{color:var(--st-blocked);background:color-mix(in srgb,var(--st-blocked) 14%,transparent)}
.chk-row .val{margin-left:auto;font-family:var(--f-mono);font-size:var(--fs-4);color:var(--text2)}
.mtx{border-collapse:separate;border-spacing:0;width:100%;font-size:var(--fs-3);margin-top:6px}
.mtx th,.mtx td{border-bottom:1px solid var(--line);padding:7px 9px;text-align:left;color:var(--text2)}
.mtx th{background:var(--surface2);color:var(--text2);font-weight:600}
.dotline{display:inline-block;width:46px;height:2px;vertical-align:middle;margin-right:7px}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.001ms !important;animation-iteration-count:1 !important;
    transition-duration:0.001ms !important}
  .wire-comm{animation:none;stroke-dasharray:none;opacity:.7}
  .node[data-state="run"] .sd{animation:none;opacity:1}
  .skel i{animation:none;background:var(--surface2)}
}
/* 同一套降级规则的「可实测开关」：勾上即给 <body> 加 .rm，效果与系统 reduced-motion 一致，
   便于在页内读到 animation-name=none 的真实读数（不靠自述） */
body.rm *{animation-duration:1ms !important;animation-iteration-count:1 !important;
  transition-duration:1ms !important}
body.rm .wire-comm{animation:none;stroke-dasharray:none;opacity:.7}
body.rm .node[data-state="run"] .sd{animation:none;opacity:1}
body.rm .skel i{animation:none;background:var(--surface2)}

/* =========================================================================
   v2 审美打磨层：不是换色，是把信息层级与「质感」做出来。
   原则——画布是主角，框架后退；标题是唯一需要被读的东西，其余都是辅助。
   ========================================================================= */

/* —— 顶栏：品牌字标稳住左端，上下文居中，操作分列两侧，细分隔线取代空隙堆叠 —— */
.topbar{gap:10px;padding:0 14px}
.topbar .wordmark{font-size:19px;letter-spacing:.2px}
.topbar .wordmark svg{width:23px;height:23px}
.crumb .seg.cur{font-size:var(--fs-body)}
#buildStamp{letter-spacing:.02em}

/* —— 节点卡：发丝状态线（顶部 2px）＋标题主导＋辅助降级 ——
   旧版靠「边框整体染色」表达状态，15 张卡同屏时变成一团彩边。
   改成：边框回到中性，状态只落在顶部一条 2px 发丝线与色点上——扫读更快，画面更静。 */
.node{border-color:var(--stroke);box-shadow:var(--shadow-1)}
.node[data-state="run"],.node[data-state="blocked"]{border-color:var(--stroke)}
.node::after{ /* 顶部状态发丝线（取代了旧的右上角呼吸点位置，呼吸改由色点承担） */
  content:"";position:absolute;left:0;right:0;top:0;height:2px;border-radius:var(--r-card) var(--r-card) 0 0;
  background:transparent;pointer-events:none}
.node[data-state="run"]::after{background:var(--st-run)}
.node[data-state="done"]::after{background:color-mix(in srgb,var(--st-done) 55%,transparent)}
.node[data-state="blocked"]::after{background:var(--st-blocked)}
.node[data-state="paused"]::after{background:var(--st-paused)}
.node[data-state="queued"]::after{background:color-mix(in srgb,var(--st-queued) 45%,transparent)}
/* 运行中的呼吸：回到状态色点上，小而明确，不再是整卡投影 */
.node[data-state="run"] .sd{animation:breathe 1.9s var(--ease) infinite}
.node:hover{border-color:var(--stroke-strong);box-shadow:var(--shadow-2)}
.node.focus{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),var(--shadow-2)}

/* 标题：真正的主角——字号提一档、字重 600、行高收紧，两行封顶 */
.n-title{font-size:15px;font-weight:600;line-height:1.42;padding-top:7px}
.node[data-kind="master"] .n-title{font-size:16px;font-weight:650}
/* 类型徽标与状态：退为 11px 辅助层，靠色点与图标承载，不与标题抢 */
.n-top{padding-top:9px;gap:8px}
.n-type{font-weight:500}
.n-state{font-weight:500}
/* 模型名：等宽小字，明确表示「这是配置，不是内容」 */
.n-model{font-size:10px;opacity:.85}
/* 事实行：键与值拉开明度，值用等宽，便于扫数字 */
.n-facts{font-size:var(--fs-3)}
.n-facts b{font-family:var(--f-mono);font-weight:600;font-variant-numeric:tabular-nums}
.n-facts .k{font-size:10px}
/* 卡内操作钮：默认隐去，悬停浮出，避免 15 张卡常驻一排图标造成噪点 */
.n-acts{gap:3px}
.n-act{background:var(--surface2);border:1px solid var(--line)}
.n-act:hover{background:var(--raised);border-color:var(--stroke-strong)}

/* —— 底部模型条：一格一类，图标＋类型＋等宽模型名，与卡面类型图标同源 —— */
.mb-cell{border-color:var(--line);background:transparent}
.mb-cell:hover{background:var(--surface2);border-color:var(--stroke)}
.mb-lead{letter-spacing:.14em}

/* —— 右缘书签组：纯图标＋竖排字，激活态用左侧 2px 强调条而不是整体变色 —— */
.re-seg{position:relative}
.re-seg.on::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:2px;
  background:var(--accent);border-radius:0 2px 2px 0}
.re-seg.on{background:var(--surface2)}

/* —— 左栏：品牌位与导航分组之间加一道细分隔，展开时树行更透气 —— */
.rail-logo{margin-bottom:10px}
.rail-btn.on{position:relative}
.rail-btn.on::before{content:"";position:absolute;left:-8px;top:7px;bottom:7px;width:2px;
  background:var(--accent);border-radius:0 2px 2px 0}
.tree-row{height:28px}
.tree-row .d{width:5px;height:5px}

/* —— 浮层：标题栏更紧、正文行高放宽到 1.7，长文可读 —— */
.dr-head{height:46px;flex:0 0 46px}
.dr-title{font-size:var(--fs-head)}
.msg .tx{line-height:1.7}


/* =========================================================================
   v2.1 · 自验收后的版式修正
   不是“继续换皮”：补足卡片信息带，减少框架噪声，把子树操作放回可见位置。
   ========================================================================= */
.node{padding:0 0 5px;box-shadow:0 1px 2px rgba(0,0,0,.16)}
.n-top{height:27px;min-height:27px;padding:7px 12px 0;gap:7px}
.n-type{height:20px;padding:0 5px;font-size:10px;letter-spacing:.015em}
.n-type .ic{width:12px;height:12px;stroke-width:1.65}
.n-state{height:20px;font-size:10px;padding:0 5px;gap:4px}
.n-model{display:none!important}
.n-count{margin-left:auto;padding:0 3px;min-width:24px;justify-content:flex-end;font-size:10px}
.n-title{padding:6px 12px 0;min-height:30px;font-size:15px;line-height:24px;gap:8px}
.node[data-kind="master"] .n-title{font-size:16px;line-height:24px}
.n-title>.t{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;
  white-space:normal;overflow:hidden;max-height:48px;min-width:0}
.n-acts{position:absolute;right:6px;top:35px;display:none;gap:3px;
  background:var(--raised);border:1px solid var(--stroke);border-radius:6px;padding:3px;
  box-shadow:var(--shadow-2)}
.node:hover .n-acts,.node:focus-within .n-acts{display:flex}
.node:hover .n-title>.t,.node:focus-within .n-title>.t{padding-right:74px}
.n-act{width:24px;height:24px;display:grid;place-items:center}
.n-facts{margin:5px 12px 0;padding-top:4px;border-top:1px solid var(--line);
  min-height:21px;gap:12px;justify-content:flex-start;overflow:hidden}
.n-facts>span{display:inline-flex;align-items:baseline;gap:4px;flex:none}
.n-facts .k{font-size:10px;color:var(--text3)}
.n-facts b{font-size:11px;line-height:16px;color:var(--text2);font-family:var(--f-ui);font-weight:500}
.n-last{margin:0 12px;font-size:10px;line-height:17px;height:17px;flex:none;color:var(--text3)}
.n-fold{position:absolute;right:7px;bottom:5px;min-width:26px;height:26px;
  display:flex;align-items:center;justify-content:center;gap:4px;padding:0 4px;
  color:var(--text3);border-radius:5px;background:var(--surface2);font-size:10px}
.n-fold:hover,.n-fold:focus-visible{color:var(--text);background:var(--raised)}
.n-fold .nf-text{font-size:10px;white-space:nowrap}
.n-fold .nf-chev{width:10px;height:10px;transform:rotate(-90deg)}
.node.folded .nf-chev{transform:rotate(90deg)}
.node[data-state="blocked"]{background:color-mix(in srgb,var(--st-blocked) 3%,var(--surface))}
.node[data-state="blocked"] .n-state{background:color-mix(in srgb,var(--st-blocked) 12%,var(--surface))}
.node[data-state="run"] .n-state{background:color-mix(in srgb,var(--st-run) 9%,var(--surface))}
.node[data-active="false"]{opacity:1;filter:saturate(.48);background:var(--surface2);border-color:var(--line)}
.node[data-active="false"] .n-title>.t{color:var(--text2)}
.node[data-active="false"] .n-type{filter:saturate(.5)}
.node[data-active="false"] .n-state{color:var(--text2);background:var(--surface)}
.node[data-active="false"] .n-state .sd{background:var(--text3)}
.node[data-active="false"] .n-last{max-width:calc(100% - 24px)}
.node[data-active="false"] .rwhy{position:absolute;left:12px;right:36px;bottom:7px;
  margin:0;font-size:9px;line-height:15px;background:var(--surface);padding:0}
.node:has(.n-fold) .n-last{padding-right:74px}
.node[data-kind="master"]::before{width:2px;opacity:.65}
.node[data-kind="manager"]::before{width:2px;opacity:.6}
.node[data-kind="unit"]::before{width:1px;opacity:.65}
.node[data-kind="worker"],.node[data-kind="qa"],.node[data-kind="pm"],.node[data-kind="ui"]{border-style:solid}
.node[data-kind="worker"] .n-type,.node[data-kind="qa"] .n-type,.node[data-kind="pm"] .n-type,.node[data-kind="ui"] .n-type{border-style:dashed}
/* full 档：标题＋类型/状态＋前 2 条事实（n-last 仅 ultra 档出现，防 15 卡同屏信息过载） */
.world[data-lod="full"] .node .n-last{display:none}
.world[data-lod="ultra"] .node .n-last{display:block}
.world[data-lod="full"] .node .n-facts>span:nth-child(n+3){display:none}
.world[data-lod="full"] .node{min-height:126px}
.world[data-lod="far"] .node .n-fold,.world[data-lod="near"] .node .n-fold{
  position:absolute;min-width:26px;height:26px;padding:0 4px;
  right:7px;bottom:5px;z-index:3;
  background:var(--raised);border:1px solid var(--stroke);box-shadow:var(--shadow-1)}
.world[data-lod="far"] .node .n-fold::after,.world[data-lod="near"] .node .n-fold::after{
  content:none}
.world[data-lod="far"] .node .nf-text,.world[data-lod="near"] .node .nf-text,
.world[data-lod="far"] .node .nf-chev,.world[data-lod="near"] .node .nf-chev{display:none}
.world[data-lod="far"] .node .n-top,.world[data-lod="near"] .node .n-top{padding-top:8px}
.world[data-lod="far"] .node .n-title,.world[data-lod="near"] .node .n-title{padding-top:7px}
.world[data-lod="far"] .node .n-title{font-size:15px}
.world[data-lod="far"] .node .n-count{display:none}
.world[data-lod="near"] .node .n-facts>span:nth-child(n+3){display:none}
.world[data-lod="far"] .node .n-state{max-width:70px}
.world[data-lod="far"] .node .n-title>.t{-webkit-line-clamp:2}
/* 顶栏：调试信息离开主工作路径；名称是导航，缩放是一组视图操作 */
#buildStamp{display:none}
.topbar{gap:10px;padding:0 12px}
.topbar .wordmark{font-size:19px;letter-spacing:0}
.topbar .wordmark svg{width:20px;height:20px;margin-right:0;transform:translateY(1px)}
.tb-brand{padding-right:3px}
.crumb .seg.cur{font-size:12px;letter-spacing:.02em}
.stat{border-left:0;padding-left:0;gap:8px;font-size:10px}
.zoomgrp{border:1px solid var(--line);border-radius:6px;padding:1px;gap:0;background:var(--surface2)}
.zoomgrp .icon{width:26px;height:24px}
.zoomgrp .lbl{height:24px;min-height:24px;width:40px;font-size:10px}
.tb-acts{gap:5px}
.tb-acts .icon{width:26px;height:26px}
#designBtn{height:26px;min-height:26px;padding:0 8px}
/* 底部模型条：它是全局配置，不是七张彩色按钮 */
.modelbar{gap:0;padding:0 12px;background:var(--surface)}
.mb-lead{font-size:9px;letter-spacing:.12em;color:var(--text3);padding-right:14px;margin-right:4px}
.mb-cell{height:32px;min-height:32px;border:0;border-radius:4px;background:transparent;padding:0 11px;gap:1px}
.mb-cell:hover{background:var(--surface2);border-color:transparent}
.mb-cell .k-md{font-size:10px;color:var(--text2)}
.mb-cell .k-nm{font-size:10px;color:var(--text2)!important}
.mb-cell .k-ct{font-size:9px;color:var(--text3)}
.mb-cell .k-ic .ic{width:12px;height:12px}
.mb-cell+.mb-cell{border-left:1px solid var(--line);border-radius:0}
/* 设计说明是底部工作面板，不再遮掉整个待验画布 */
.dpanel{top:auto;left:14px;right:14px;bottom:54px;height:min(460px,calc(100% - 88px));max-width:none;width:auto}
/* 设计说明的窗口头部与表格需要清晰的纵向节奏 */
.dp-head{gap:12px;flex-wrap:wrap;min-height:48px;padding:10px 16px}
.dp-title{font-size:14px;font-weight:650}
.dp-sub{font-size:10px}
.dp-tabs{gap:3px}
.dp-tab{min-width:42px;min-height:26px;height:26px}
#dpClose{height:26px;min-height:26px;margin-left:6px!important}
#dpClose .ic{width:12px;height:12px}
.dp-body{padding:16px 20px}
.dp-sec h3{font-size:15px;line-height:24px}
.dp-sec h4{margin:20px 0 8px;font-size:12px}
.tk td,.tk th{padding:6px 8px;line-height:1.5}
.chk-row{align-items:flex-start;line-height:1.55}
/* 键盘焦点不只靠颜色，图标按钮有统一边界 */
button:focus-visible,[role="button"]:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media (max-width:1100px){.stat{display:none}.topbar{gap:7px}}
@media (max-width:820px){.crumb{display:none}.topbar .wordmark{font-size:18px}.dp-sub{display:none}}
</style>
</head>
<body>
<div class="work-page">
  <nav class="rail">
    <div class="rail-inner">
      <div class="rail-icons">
        <div class="rail-logo" title="CardColony">C</div>
        <button class="rail-btn on" title="画布">▦</button>
        <button class="rail-btn" title="对话">◧</button>
        <button class="rail-btn" title="产物">▤</button>
        <button class="rail-btn" title="规则">◈</button>
      </div>
      <div class="rail-body">
        <div class="rail-sec">项目树</div>
        <ul class="tree" id="railTree"></ul>
        <div class="rail-sec">过滤</div>
        <label class="chk"><input type="checkbox"> 仅运行中</label>
        <label class="chk"><input type="checkbox"> 仅受阻</label>
        <label class="chk"><input type="checkbox"> 含已归档</label>
        <div class="rail-sec">图例</div>
        <div class="chk" style="cursor:default">
          <span class="dotline" style="background:var(--wire-parent)"></span>父子线 <b class="num" id="legP" style="margin-left:auto">0</b>
        </div>
        <div class="chk" style="cursor:default">
          <span class="dotline" style="background:var(--wire-comm)"></span>通信线 <b class="num" id="legC" style="margin-left:auto">0</b>
        </div>
        <div class="chk" style="cursor:default">
          <span class="dotline" style="border-top:2px dotted var(--wire-rel);background:none;height:0"></span>依赖关联线 <b class="num" id="legR" style="margin-left:auto">0</b>
        </div>
      </div>
    </div>
  </nav>
  <div class="main">
    <header class="topbar">
      <!-- ① 品牌：symbol-as-C 字标（brand/README：UI 顶栏用暗态字标，19–20px） -->
      <span class="tb-brand" id="tbBrand" title="CardColony"></span>
      <span class="tb-div"></span>
      <!-- ② 上下文：你在哪、项目什么样 -->
      <div class="crumb"><span class="seg cur">全景</span></div>
      <div class="stat" id="projectStat">...</div>
      <span class="build" id="buildStamp">设计稿 v2 · 品牌与图标</span>
      <span class="tb-spacer"></span>
      <!-- ③ 视图操作：只影响画布怎么看，靠画布一侧 -->
      <div class="zoomgrp" role="group" aria-label="画布视图">
        <button class="icon" id="zoomOut" title="缩小">−</button>
        <button class="lbl" id="zoomPct" title="回到 100%" aria-label="恢复 100% 缩放">100%</button>
        <button class="icon" id="zoomIn" title="放大">+</button>
        <button class="icon" id="fitBtn" title="整幅适配">⤢</button>
      </div>
      <span class="tb-div"></span>
      <!-- ④ 全局操作：搜索／主题／更多，靠右收尾 -->
      <div class="tb-acts">
        <button class="icon" id="searchBtn" title="搜索 ⌘K">⌕</button>
        <button class="icon" id="themeBtn" title="切换深浅主题">☀</button>
        <button class="icon" id="moreBtn" title="更多">⋯</button>
        <button class="btn" id="designBtn">◐ 设计说明</button>
      </div>
    </header>
    <div class="stage" id="stage">

      <div class="re-group" id="reGroup">
        <button class="re-seg" data-sheet="ev" title="全事件日志">
          <span class="re-ic">☰</span><span class="re-tx">事件</span><span class="re-n" id="evN">4</span>
        </button>
        <button class="re-seg" data-sheet="rule" title="规则卡">
          <span class="re-ic">▤</span><span class="re-tx">规则卡</span>
        </button>
        <button class="re-seg" data-sheet="arch" title="归档记录">
          <span class="re-ic">▣</span><span class="re-tx">归档</span><span class="re-n" id="archN">1</span>
        </button>
      </div>

      <aside class="rule-panel closed" id="rulePanel">
        <button class="rp-handle" id="rpHandle" title="展开规则面板" aria-label="展开规则面板">‹</button>
        <div class="rp-tabs">
          <div class="rp-tab on">规则卡</div>
          <div class="rp-tab">适用范围</div>
          <button class="rp-close dr-close" id="rpClose" title="关闭规则面板" aria-label="关闭规则面板" style="margin-left:auto">✕</button>
        </div>
        <div class="rp-body" id="rpBody"></div>
      </aside>

      <div class="drawer" id="drawer">
        <div class="dr-head">
          <span class="dr-title" id="drTitle">卡片对话</span>
          <span class="dr-sub" id="drSub">card_001</span>
          <button class="dr-close" data-close="drawer">✕</button>
        </div>
        <div class="dr-body" id="drBody"></div>
        <div class="dr-foot">
          <input class="field" placeholder="就地回复…（Enter 发送）" id="drInput">
          <button class="btn primary" id="drSend">发送</button>
        </div>
      </div>

      <div class="card-menu" id="cardMenu" role="menu" aria-label="卡面操作菜单" hidden>
        <div class="cm-head" id="cmTitle">卡面操作</div>
        <button class="cm-item" role="menuitem" data-cm="title"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 3l4 4L8 20l-5 1 1-5z"/></svg>改标题</button>
        <button class="cm-item" role="menuitem" data-cm="state"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18" fill="currentColor" stroke="none"/></svg>改状态</button>
        <button class="cm-item" role="menuitem" data-cm="model"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/></svg>改模型</button>
        <button class="cm-item danger" role="menuitem" data-cm="archive"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="5"/><path d="M5 9v10h14V9M10 13h4"/></svg>归档整支</button>
      </div>

      <div class="sheet w432" id="sheetEv">
        <div class="dr-head">
          <span class="dr-title">事件</span>
          <span class="dr-sub" id="evSub">共 4 条 · 项目级事件自动记录（不含对话）</span>
          <button class="dr-close" data-close="ev">✕</button>
        </div>
        <div class="dr-body" id="evBody"></div>
      </div>

      <div class="sheet" id="sheetRule">
        <div class="dr-head">
          <span class="dr-title">规则卡</span>
          <span class="dr-sub">rule · 项目级</span>
          <button class="dr-close" data-close="rule">✕</button>
        </div>
        <div class="rc-meta">类型 rule ｜ 适用范围 本树全部卡 ｜ 版本 v3 ｜ 策展人 根卡</div>
        <div class="dr-body" id="ruleBody"></div>
        <div class="dr-foot"><span style="font-size:11px;color:var(--text3)">改动只在本页生效（演示）；真实改动经用户同意才落盘</span></div>
      </div>

      <div class="sheet" id="sheetArch">
        <div class="dr-head">
          <span class="dr-title">归档</span>
          <span class="dr-sub" id="archSub">1 条记录</span>
          <button class="dr-close" data-close="arch">✕</button>
        </div>
        <div class="dr-body" id="archBody"></div>
      </div>

      <button class="demo-dock" id="demoDock">演示 ▾</button>
      <div class="moremenu" id="moreMenu">
        <button class="mm-item" data-mm="expand">全部展开<span class="mk">▾</span></button>
        <button class="mm-item" data-mm="collapse">全部折叠<span class="mk">▸</span></button>
        <div class="mm-sep"></div>
        <button class="mm-item" data-mm="lines">关系线显示<span class="mk" id="mmLines">开</span></button>
        <button class="mm-item" data-mm="tip">tooltip 示例（card_001）<span class="mk">◍</span></button>
        <button class="mm-item" data-mm="drawer">对话抽屉示例（card_257）<span class="mk">◧</span></button>
        <button class="mm-item" data-mm="edit">卡面菜单示例（card_074）<span class="mk">✎</span></button>
        <button class="mm-item" data-mm="states">四态面板<span class="mk">▭</span></button>
        <button class="mm-item" data-mm="design">设计说明<span class="mk">◐</span></button>
        <div class="mm-sep"></div>
        <button class="mm-item" data-mm="rm">动效降级（reduced-motion）<span class="mk" id="mmRm">关</span></button>
      </div>

      <div class="fourstate" id="fourState">
        <div class="fs-tabs">
          <button class="fs-tab on" data-fs="normal">正常</button>
          <button class="fs-tab" data-fs="loading">加载</button>
          <button class="fs-tab" data-fs="empty">空</button>
          <button class="fs-tab" data-fs="error">错误</button>
          <button class="fs-tab" data-fs="deny">无权限</button>
          <button class="fs-close" data-close="fourstate">✕</button>
        </div>
        <div class="fs-body" id="fsBody"></div>
      </div>

      <div class="scrim" id="scrim"></div>
      <div class="cmdk" id="cmdk">
        <div class="cmdk-in">
          <span style="color:var(--text3)">⌕</span>
          <input class="field" id="cmdkInput" placeholder="搜索卡片（标题 / 编号）">
          <span class="kbd">Esc</span>
        </div>
        <div class="cmdk-list" id="cmdkList"></div>
        <div class="cmdk-foot">
          <span>点结果＝定位（不选中、不淡化、不进模式）</span>
          <span style="margin-left:auto">Enter 第一条</span>
          <button class="btn link" data-close="cmdk">关闭</button>
        </div>
      </div>

      <div class="tooltip" id="tooltip"></div>

      <div class="canvas" id="canvas">
        <div class="world" id="world" data-lod="full">
          <svg id="wires" width="2600" height="1800" aria-hidden="true"></svg>
          <div id="nodes"></div>
        </div>
      </div>
      <div class="modelbar" id="modelbar"></div>
    </div>
  </div>
</div>

<div class="dpanel" id="dpanel">
  <div class="dp-head">
    <span class="dp-title">设计说明 · 画布页视觉稿 v2 · 品牌与图标</span>
    <span class="dp-sub">令牌 / 决策 / 待裁定 / 自检 / 组件</span>
    <div class="dp-tabs">
      <button class="dp-tab on" data-tab="tok">令牌</button>
      <button class="dp-tab" data-tab="dec">决策</button>
      <button class="dp-tab" data-tab="opt">待裁定</button>
      <button class="dp-tab" data-tab="chk">自检</button>
      <button class="dp-tab" data-tab="gal">组件</button>
      <button class="btn" id="dpClose" style="margin-left:8px">✕ 关闭</button>
    </div>
  </div>
  <div class="dp-body">

    <section class="dp-sec on" id="sec-tok">
      <h3>① 令牌体系（深／浅两套同名，值不同）</h3>
      <p class="lead">下表由页内脚本从 <b>实际 computedStyle</b> 读出，不是手抄：切主题后同一张表刷新。
        语义令牌分六族——背景层级 / 文字 / 线 / 强调 / 状态 / 类型；「用途」列写它只能用在什么位置。
        品牌蜂蜜金单列为 <span class="num">--brand-gold</span>，只进品牌标，不进状态与按钮。</p>
      <table class="tk">
        <thead><tr><th style="width:150px">令牌</th><th style="width:220px">用途</th>
          <th style="width:170px">深色值</th><th style="width:170px">浅色值</th></tr></thead>
        <tbody id="tkBody"></tbody>
      </table>
      <h4>字号阶（六档，写清用在哪）</h4>
      <table class="tk">
        <thead><tr><th style="width:120px">档</th><th style="width:90px">字号/行高</th>
          <th>用在哪</th></tr></thead>
        <tbody>
          <tr><td class="nm">--fs-title</td><td class="vl">16px / 1.4</td>
            <td class="uc">卡标题（Master 档；其余卡 15px）、面板标题</td></tr>
          <tr><td class="nm">--fs-head</td><td class="vl">14px / 1.5</td>
            <td class="uc">区块标题、命令面板输入、浮层标题</td></tr>
          <tr><td class="nm">--fs-body</td><td class="vl">13px / 1.6</td>
            <td class="uc">正文、消息正文、规则卡正文</td></tr>
          <tr><td class="nm">--fs-2</td><td class="vl">12px / 1.6</td>
            <td class="uc">次要正文、事实行、按钮文字、树行</td></tr>
          <tr><td class="nm">--fs-3</td><td class="vl">11px / 1.6</td>
            <td class="uc">辅助说明、时间戳、徽标文字、提示行</td></tr>
          <tr><td class="nm">--fs-4</td><td class="vl">10px / 1.4</td>
            <td class="uc">等宽数字/编号/原因码/事件类型（配 --f-mono）</td></tr>
        </tbody>
      </table>
      <h4>间距与圆角</h4>
      <table class="tk">
        <thead><tr><th style="width:150px">令牌</th><th style="width:90px">值</th><th>用在哪</th></tr></thead>
        <tbody>
          <tr><td class="nm">--s1 / --s2</td><td class="vl">4 / 8</td><td class="uc">图标与文字间距、控件内边距、徽标间距</td></tr>
          <tr><td class="nm">--s3 / --s4</td><td class="vl">12 / 16</td><td class="uc">卡片内边距（12px）、浮层内边距、区块内边距</td></tr>
          <tr><td class="nm">--s5 / --s6</td><td class="vl">24 / 32</td><td class="uc">区域间距（面板与画布）、段落间距、抽屉大分节</td></tr>
          <tr><td class="nm">--r-card</td><td class="vl">6px</td><td class="uc">卡片节点、徽标、控制件</td></tr>
          <tr><td class="nm">--r-panel</td><td class="vl">8px</td><td class="uc">右列规则面板、内嵌信息盒</td></tr>
          <tr><td class="nm">--r-float</td><td class="vl">10px</td><td class="uc">右缘浮窗（对话/事件/规则卡/归档）、tooltip、菜单</td></tr>
          <tr><td class="nm">--r-modal</td><td class="vl">14px</td><td class="uc">命令面板、确认类弹窗（本轮仅有命令面板）</td></tr>
        </tbody>
      </table>
    </section>

    <section class="dp-sec" id="sec-dec">
      <h3>② 关键视觉决策与理由</h3>
      <p class="lead">每条写：定了什么 → 为什么 → 落到哪个令牌/选择器。可以不同意，改令牌即可，不用改结构。</p>
      <div class="dec"><b>1｜明度层级取代描边层级：画布最深、浮层最亮</b>
        <p>bg(#0c1015) → surface(#12171e) → surface2(#171e27) → raised(#1f2731) 四级台阶，每级只差一点明度。
        结构靠「谁压在谁上面」表达，不靠加粗描边——这样信息密度高也不会变成一堵线网。
        代价：单靠明度不够，所以承载边界信息的描边另走 <span class="num">--stroke-strong</span>（≥3:1）。</p></div>
      <div class="dec"><b>2｜强调色只给三件事：主操作、选中、焦点环</b>
        <p>--accent 不出现在任何卡片底色、标题、状态点上。理由：画布上同时有 7 类卡 × 6 种状态，
        强调色一旦用于装饰，用户就无法靠颜色判断「哪里能点、哪里是当前」。品牌蜂蜜金同理，只进品牌标。</p></div>
      <div class="dec"><b>3｜状态色与类型色分两族，永不同时落在一个元素上</b>
        <p>状态只用「顶部 2px 发丝线 + 色点 + 状态词」；类型只用「细左条 / 徽标 / 底栏同名格」。同一张卡上两者并排但不争夺同一像素，
        所以 7 类 × 6 态也不会串味。四态容器（加载/空/错误/无权限）不复用状态色，避免「错误」与「受阻」被读成同一件事。</p></div>
      <div class="dec"><b>4｜运行中＝呼吸，其余全静止</b>
        <p>只有 data-state="run" 有动效（1.9s 呼吸点）。「还在跑的」会动，「可以看结果的」不动——这是密度极高的画布上唯一需要的动态线索。
        reduced-motion 下呼吸降为静态高亮点，状态词仍在，功能不缺。</p></div>
      <div class="dec"><b>5｜三类线两维可区分：颜色 + 线型/端点</b>
        <p>父子线＝中性灰实线正交折线（结构的形状）；通信线＝强调蓝曲线 + 流星虚线流动 + 收件端实心点（信息传递那一下）；
        依赖关联线＝紫点线 + 端点菱形（只记关系、不参与通信）。灰度打印或色弱下仍靠线型分得开，矩阵见「自检」页。</p></div>
      <div class="dec"><b>6｜类型靠图形与文字，层级靠细左条，不靠一圈彩框</b>
        <p>七类卡各有独立 SVG 图形与文字名；Master / Manager / Unit 用 2px 细左条标记结构深度，
        执行卡用 1px 细线与虚线类型徽标。边框整体保持中性，状态只留给顶部发丝线；降低彩框噪声，名称仍是最终识别依据。</p></div>
      <div class="dec"><b>7｜命中区一律 24px，不靠视觉尺寸撑</b>
        <p>--hit:24px 统一给图标按钮、树行、菜单项、分段书签、缩放钮。视觉上按钮仍可以画得小而精，
        但可点范围不小于 24×24——密集布局里这是最容易被牺牲、也最影响使用的一条。</p></div>
      <div class="dec"><b>8｜阴影只表层级，不做装饰</b>
        <p>三级：--shadow-1（卡片悬停/演示坞）、--shadow-2（面板、书签组展开）、--shadow-3（浮窗、命令面板、设计说明）。
        卡片常态只留 1px 接触阴影，浮起阴影只给悬停与面板——画布上同时几十张卡，重投影会糊成一片。</p></div>
      <div class="dec"><b>9｜中文字体优先，主字号阶稳定，辅助文字有明确定值</b>
        <p>字体栈 PingFang SC → Hiragino Sans GB → Microsoft YaHei → Segoe UI；数字/编号/原因码走等宽。
        主字号阶为 16/14/13/12/11/10；画布缩放产生的屏上字号是视图结果，不伪装成新的令牌。
        低倍率只保留标题、状态与关键事实，完整内容在 full / ultra 恢复。</p></div>
      <div class="dec"><b>10｜非 active 置灰必须带原因码，不只变灰</b>
        <p>置灰降低饱和（saturate .48），但不降低整张卡的 opacity——实测那样会把状态词拉到 3.51:1。
        状态词改用中性色并保留 4.5:1；底部补原因码
        （如 <span class="num">R-STEP-08</span>）+ 一句为什么。灰是「它现在不推进」，不是「它不存在」。</p></div>
      <div class="dec"><b>11｜LOD 四档做减法：先减事实、再减字、最后只留图标</b>
        <p>far(&lt;58%) 留类型、标题、状态；near(58–71%) 补前 2 项事实；full(72–95%) 恢复最近进展；
        ultra(≥96%) 保留完整事实与最近进展。低倍率子树入口移到卡缘并维持屏上 24px，不能为达标而把出口藏掉。</p></div>
      <div class="dec"><b>12｜动效只服务理解：三段节奏，不改语义</b>
        <p>--t-fast 120ms（悬停/按下）／--t-mid 200ms（面板让位、浮层推入）／--t-canvas 400ms（折叠展开、适配）。
        缓动统一 cubic-bezier(.4,0,.2,1)，位移用 (.22,.75,.2,1)。手势永不过渡——过渡会让画面追不上手。</p></div>
      <div class="dec" style="border-left-color:var(--brand-gold)"><b>13｜v2 品牌：C 形小机器人进产品，蜂蜜金只表「这是品牌」</b>
        <p>v1 把品牌做成一个写着 C 的金方块——那不是品牌，是占位。v2 用 brand/ 的真实资产内联：
        左栏是 ≤48px 的加粗版 mark（粗 C、大双目），顶栏是 symbol-as-C 字标（ard 线色＋Colony 点色，零间距）。
        蜂蜜金 <span class="num">--brand-gold</span> 只出现在这两处，永不进按钮、徽标、状态点——
        否则用户会把品牌色误读成「警告」。双目/天线珠/Colony 三处永远同一个点色，这是品牌规范的红线。</p></div>
      <div class="dec" style="border-left-color:var(--brand-gold)"><b>14｜v2 图标：一套几何语言替掉所有字形符号</b>
        <p>v1 的 ▦◧⌕✕◆◇▣ 是「字形」，随系统字体漂移、在不同平台长得不一样，且没有统一的视觉重量。
        v2 全部换成 SVG：24 网格 / 1.6 描边 / round 端点 / 单色 currentColor。七类卡各有语义图标
        （Master=冠、Manager=分叉、Unit=立方、worker=齿轮、qa=盾勾、pm=笔、ui=显示器），
        卡面、底部模型条、设计说明组件页三处同源——规范样板与实物用的是同一份路径数据，不会各画各的。</p></div>
      <div class="dec" style="border-left-color:var(--brand-gold)"><b>15｜v2 状态表达：从「整卡边框染色」改成「顶部 2px 发丝线＋色点」</b>
        <p>v1 让运行中/受阻的整张卡边框染色，15 张卡同屏时变成一团彩边，状态反而读不出。
        v2 边框回到中性，状态只落在顶部一条 2px 发丝线与状态色点上——扫读时视线沿顶缘一扫即知谁在跑、谁受阻，
        画面整体更静。呼吸也从整卡投影收回色点。这是「画布是主角、状态是标注」的直接后果。</p></div>
    </section>

    <section class="dp-sec" id="sec-chk">
      <h3>④ 自检读数（页内现算，不是自述）</h3>
      <p class="lead">令牌组合与实际可见文字分开计算；命中区只统计视口内、中心无遮挡的元素，并采用缩放后的真实尺寸。
        设计面板打开时重算当前视口，不再沿用初始全景的旧读数。这里是 DOM／计算样式验收，不是像素级图像审查；
        覆盖层、悬停和不同缩放状态需要分别检查，红项不隐藏。</p>
      <h4>① 对比度（令牌组合，不代表所有实际元素）</h4>
      <div id="ctBody"></div>
      <h4>①b 实际可见文字（按 opacity 合成）</h4>
      <div id="visualAuditBody"></div>
      <h4>② 命中区（视口内＋无中心遮挡＋缩放后尺寸）</h4>
      <div id="hitBody"></div>
      <h4>③ 令牌齐备性</h4>
      <div id="parityBody"></div>
      <h4>③b 动效降级（reduced-motion）实测 — 勾选即套用同一套降级规则</h4>
      <label class="chk" style="padding:0 0 6px"><input type="checkbox" id="rmChk"> 模拟 reduced-motion（给 body 加 .rm）</label>
      <div id="rmBody"></div>
      <p style="font-size:11px;color:var(--text3);line-height:1.7;margin:4px 0 0">
        降级后：呼吸点变静态高亮点、流星虚线变静止实线、骨架条变静态色块、过渡时长归零；
        状态词、原因码、书签、覆层开关、缩放与折叠全部照旧——功能不缺。</p>
      <h4>③c LOD 四档视觉简化 — 逐档实测（随缩放刷新，读的是 computedStyle）</h4>
      <div id="lodBody"></div>
      <h4>④ 三类线 × 维度矩阵</h4>
      <table class="mtx">
        <thead><tr><th>线类</th><th>颜色</th><th>线型</th><th>端点/标记</th><th>走向</th></tr></thead>
        <tbody>
          <tr><td>父子线</td><td><span class="dotline" style="background:var(--wire-parent)"></span>--wire-parent</td>
            <td>实线 1.5px</td><td>无</td><td>正交折线（结构的形状）</td></tr>
          <tr><td>通信线</td><td><span class="dotline" style="background:var(--wire-comm)"></span>--wire-comm</td>
            <td>曲线 + 流星虚线流动</td><td>收件端实心圆点</td><td>贝塞尔（穿过中间卡不被误读成父子）</td></tr>
          <tr><td>依赖关联线</td><td><span class="dotline" style="border-top:2px dotted var(--wire-rel);background:none;height:0"></span>--wire-rel</td>
            <td>点线 2/6</td><td>两端菱形</td><td>直线</td></tr>
        </tbody>
      </table>
      <h4>⑤ 四态两两可区分（含必查对：加载 vs 空）</h4>
      <table class="mtx">
        <thead><tr><th>态</th><th>形态</th><th>与相邻态的区别</th></tr></thead>
        <tbody>
          <tr><td>加载</td><td>骨架条（3 条 shimmer）+「正在取卡片树」</td><td>有形状、无文字结论——「还没取到」</td></tr>
          <tr><td>空</td><td>虚线空框图标 + 「数据已取回·一张卡都没有」+ 为什么</td><td>确知为 0，有说明与下一步——与骨架完全不同形</td></tr>
          <tr><td>错误</td><td>红边盒 + 502 码 + 就地「重试」+ 保留上次结果</td><td>带错误码与可执行动作</td></tr>
          <tr><td>无权限</td><td>中性盒 + E403 + 缺哪个 scope +「申请只读」</td><td>不用错误红（不是故障），给的是申请路径</td></tr>
        </tbody>
      </table>
    </section>

    <section class="dp-sec" id="sec-opt">
      <h3>③ 需要你裁定的视觉选项</h3>
      <p class="lead">三处我认为有争议的地方，各给候选。点一个即可（页内记住选择，不影响其他任何行为）。</p>
      <div class="opt" data-opt="o1">
        <div class="oh">选项 1｜画布底 vs 面板底的明度关系</div>
        <p class="oq">画布是不是该比侧栏更暗？更暗＝内容区沉稳、框架后退；同明度＝界面更平、更像文档工具。</p>
        <div class="cand">
          <span class="cd sel" data-v="A">A 画布最深（现方案）<span class="tag">bg &lt; surface</span></span>
          <span class="cd" data-v="B">B 画布与侧栏同明度<span class="tag">bg = surface</span></span>
          <span class="cd" data-v="C">C 画布略亮<span class="tag">bg &gt; surface</span></span>
        </div>
        <div class="note">现方案 A：深色 UI 里画布最暗能压住内容、让 44px 框架后退；浅色 UI 里反过来（画布 #f1f2f0 比面板白更灰一档）。
          选 B 会让卡片浮起感消失，需要靠阴影补；选 C 会把注意力分给框架。</div>
      </div>
      <div class="opt" data-opt="o2">
        <div class="oh">选项 2｜「运行中」用什么色</div>
        <p class="oq">运行中现在用青绿（#3fc7b4），强调色是蓝（#7aa2f7）。两者分开是为了不让「当前选中」和「正在跑」混淆。</p>
        <div class="cand">
          <span class="cd sel" data-v="A">A 青绿 + 呼吸（现方案）</span>
          <span class="cd" data-v="B">B 蓝（与强调同源，靠呼吸区分）</span>
          <span class="cd" data-v="C">C 中性灰 + 只有呼吸点</span>
        </div>
        <div class="note">B 更统一但会和选中态撞色；C 最克制但 15 张卡同屏时「运行中」不够跳。</div>
      </div>
      <div class="opt" data-opt="o3">
        <div class="oh">选项 3｜父子线走向</div>
        <p class="oq">父子线现在走正交折线（先横后竖再横），依赖关联线走直线、通信线走曲线。</p>
        <div class="cand">
          <span class="cd sel" data-v="A">A 正交折线（现方案）</span>
          <span class="cd" data-v="B">B 贝塞尔曲线</span>
        </div>
        <div class="note">A 更像结构图、更好追路径；B 更柔和，但会和通信线曲线撞形——那样三类线就只剩颜色一维可分了。</div>
      </div>
    </section>

    <section class="dp-sec" id="sec-gal">
      <h3>⑤ 组件视觉（本轮定稿值）</h3>
      <p class="lead">每个可交互件给全态。悬停/按下请直接在本页操作看效果；禁用与加载态在下面并列展示。</p>
      <div class="gal">
        <div class="gcard"><h6>按钮 · 主（含五态）</h6>
          <div class="grow"><button class="btn primary">主操作</button>
            <button class="btn primary is-loading">主操作</button>
            <button class="btn primary" disabled>禁用</button></div></div>
        <div class="gcard"><h6>按钮 · 次</h6>
          <div class="grow"><button class="btn">次操作</button>
            <button class="btn is-loading">次操作</button>
            <button class="btn" disabled>禁用</button></div></div>
        <div class="gcard"><h6>按钮 · 危险</h6>
          <div class="grow"><button class="btn danger">归档整支</button>
            <button class="btn danger" disabled>禁用</button></div></div>
        <div class="gcard"><h6>按钮 · 文字链</h6>
          <div class="grow"><button class="btn link">查看证据</button>
            <button class="btn link" disabled>禁用</button></div></div>
        <div class="gcard"><h6>输入框</h6>
          <div class="grow" style="flex-direction:column;align-items:stretch">
            <input class="field" placeholder="默认态 · placeholder">
            <input class="field" value="聚焦态由 :focus 给 2px 焦点环">
            <input class="field" placeholder="禁用" disabled style="opacity:.55">
          </div></div>
        <div class="gcard"><h6>状态徽标（六态）</h6>
          <div class="grow">
            <span class="n-state" style="color:var(--st-run)"><i class="sd" style="background:var(--st-run)"></i>运行中</span>
            <span class="n-state" style="color:var(--st-done)"><i class="sd" style="background:var(--st-done)"></i>已完成</span>
            <span class="n-state" style="color:var(--st-blocked)"><i class="sd" style="background:var(--st-blocked)"></i>受阻</span>
            <span class="n-state" style="color:var(--st-paused)"><i class="sd" style="background:var(--st-paused)"></i>已暂停</span>
            <span class="n-state" style="color:var(--st-queued)"><i class="sd" style="background:var(--st-queued)"></i>排队中</span>
            <span class="n-state" style="color:var(--text3)"><i class="sd" style="background:var(--text3)"></i>已归档</span>
          </div></div>
        <div class="gcard"><h6>类型徽标（七类）</h6>
          <div class="grow" style="flex-direction:column;align-items:flex-start" id="galKinds"><!-- 七类徽标由脚本用与画布同一套 SVG 图标渲染，保证规范样板与实物一致 --></div></div>
        <div class="gcard"><h6>原因码 / 归档码</h6>
          <div class="grow"><span class="rcode">R-STEP-08</span>
            <span class="rcode" style="color:var(--st-arch);border-color:color-mix(in srgb,var(--st-arch) 45%,transparent)">ARCH-04</span></div></div>
      </div>
    </section>

  </div>
</div>

<script>
(function(){
"use strict";
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>Array.prototype.slice.call(r.querySelectorAll(s));
const ROWH=168, NW=312, GAPX=92, PADX=48, PADY=16;

/* ============ 令牌表：页面样式的同名清单（自检逐项比对，防两套漂移） ============ */
const TOKENS=[
 {n:'--bg',use:'画布底｜内容区最底层',d:'#0c1015',l:'#f1f2f0'},
 {n:'--surface',use:'面板底｜顶栏/左栏/右列/浮窗',d:'#12171e',l:'#ffffff'},
 {n:'--surface2',use:'次面板底｜控件底、次级块',d:'#171e27',l:'#f7f8f6'},
 {n:'--raised',use:'浮起底｜工作卡、弹层内块',d:'#1f2731',l:'#ffffff'},
 {n:'--line',use:'装饰分隔线（不作信息载体）',d:'#232c37',l:'#e2e4e0'},
 {n:'--stroke',use:'弱边界｜工作卡虚线框',d:'#3c4a58',l:'#c9cfc9'},
 {n:'--stroke-strong',use:'强边界｜控件与卡片描边（≥3:1）',d:'#66798d',l:'#77817a'},
 {n:'--text',use:'正文/标题',d:'#e9eff6',l:'#161f28'},
 {n:'--text2',use:'次要文字｜徽标、事实键',d:'#adbccb',l:'#46566a'},
 {n:'--text3',use:'辅助文字｜时间戳、提示',d:'#8296a8',l:'#5d6b7a'},
 {n:'--text-disabled',use:'禁用文字',d:'#5b6b7b',l:'#98a2ac'},
 {n:'--accent',use:'强调｜主操作、选中、焦点环',d:'#7aa2f7',l:'#1f5fd1'},
 {n:'--accent2',use:'强调按下｜主按钮底',d:'#5f88e0',l:'#1a4faf'},
 {n:'--on-accent',use:'主按钮上的文字',d:'#0b1220',l:'#ffffff'},
 {n:'--st-run',use:'状态·运行中',d:'#3fc7b4',l:'#0f6f63'},
 {n:'--st-done',use:'状态·已完成',d:'#5cbf7a',l:'#1d6b3c'},
 {n:'--st-blocked',use:'状态·受阻｜错误码',d:'#ec6f63',l:'#a3231e'},
 {n:'--st-paused',use:'状态·已暂停',d:'#d7a03e',l:'#8a5a00'},
 {n:'--st-queued',use:'状态·排队中',d:'#8fa4c0',l:'#4a5b74'},
 {n:'--st-arch',use:'状态·归档置灰',d:'#8b97a3',l:'#5d6b7a'},
 {n:'--k-master',use:'类型色·master',d:'#b9c9ff',l:'#2a4a9c'},
 {n:'--k-manager',use:'类型色·manager',d:'#93a9de',l:'#3a5b96'},
 {n:'--k-unit',use:'类型色·unit',d:'#9aa6b4',l:'#5b6672'},
 {n:'--k-worker',use:'类型色·worker',d:'#6fa8dc',l:'#1f5f9e'},
 {n:'--k-qa',use:'类型色·qa_card',d:'#5cbf7a',l:'#1d6b3c'},
 {n:'--k-pm',use:'类型色·pm_card',d:'#b48ce8',l:'#6b3fa0'},
 {n:'--k-ui',use:'类型色·ui',d:'#e0a24a',l:'#8a5a00'},
 {n:'--wire-parent',use:'线类·父子线',d:'#8296a8',l:'#5d6b7a'},
 {n:'--wire-comm',use:'线类·通信线',d:'#7aa2f7',l:'#1f5fd1'},
 {n:'--wire-rel',use:'线类·依赖关联线',d:'#b48ce8',l:'#6b3fa0'},
 {n:'--brand-gold',use:'品牌点色｜双目/天线珠/Colony，只进品牌标',d:'#e2a63d',l:'#c9901f'},
 {n:'--brand-line',use:'品牌线色｜C 笔身/天线杆/ard，只进品牌标',d:'#e6edf3',l:'#1c2733'},
 {n:'--brand-gold-ink',use:'品牌块上的字（深墨，两套同值）',d:'#1a1408',l:'#1a1408'}
];

/* ============ 15 卡三层示意数据（口径＝spec §12，不新增业务字段） ============ */
/* 七类卡各配一枚语义图标（取自 ICONS，同一几何语言）——不再是 ◆◇·▦✓✎◱ 这种随字体漂移的字形 */
const KIND={master:{n:'Master',ic:'crown'},manager:{n:'Manager',ic:'branch'},unit:{n:'Unit',ic:'cube'},
  worker:{n:'worker',ic:'gear'},qa:{n:'qa_card',ic:'shieldCheck'},pm:{n:'pm_card',ic:'pen'},ui:{n:'ui',ic:'monitor'}};
const STATE={run:'运行中',done:'已完成',blocked:'受阻',paused:'已暂停',queued:'排队中'};
const MODEL={master:'claude-opus-4-5',manager:'claude-opus-4-5',unit:'claude-sonnet-4-5',
  worker:'claude-sonnet-4-5',qa:'claude-sonnet-4-5',pm:'claude-sonnet-4-5',ui:'gpt-5.2'};
let DATA=[
 {id:'card_001',t:'底层重构',kind:'master',state:'run',parent:null,
  facts:[['轮次','38'],['阶段','视觉层'],['子卡','4'],['引用','12']],
  last:'根卡：v1.0 首发口径未变，视觉层单独成卡推进'},
 {id:'card_074',t:'产品与交互需求 · 总负责人',kind:'manager',state:'run',parent:'card_001',
  facts:[['轮次','21'],['阶段','放行'],['子卡','3'],['待审','0']],
  last:'需求：R1～R33 已转正稿，本轮视觉层不改判据'},
 {id:'card_257',t:'功能线 1 · 页面架构及 UI/UE',kind:'manager',state:'done',parent:'card_001',
  facts:[['轮次','27'],['阶段','收口'],['子卡','9'],['证据','6']],
  last:'产出：v3 交互定版 + 视觉稿 v1，证据在 docs/'},
 {id:'card_3a1',t:'验收与证据基线',kind:'manager',state:'blocked',parent:'card_001',
  facts:[['轮次','11'],['阶段','等签'],['子卡','0'],['阻塞','3 天']],
  last:'三方签字未回，自动推进停下等人接手',
  why:'R-STEP-08｜等待三方签字（产品/前端/QA），自动推进已停 3 天'},
 {id:'card_3a2',t:'外部接入与联调',kind:'manager',state:'queued',parent:'card_001',
  facts:[['轮次','0'],['阶段','排队'],['子卡','0'],['队位','4']],
  last:'在队列第 4 位，尚未开始',why:'R-QUEUE-01｜排队第 4 位，前序未收口'},
 {id:'card_4a1',t:'交互规格',kind:'unit',state:'done',parent:'card_257',
  facts:[['轮次','9'],['阶段','定版'],['页','1'],['条文','33']],
  last:'产出：canvas-page-interaction-spec-v1.md（R1–R33）'},
 {id:'card_4a2',t:'组件与状态库',kind:'unit',state:'paused',parent:'card_257',
  facts:[['轮次','6'],['阶段','暂停'],['组件','18'],['缺','2']],
  last:'暂停：等视觉令牌定稿后再收组件态',
  why:'R-HOLD-02｜等视觉令牌定稿（本卡产出）后才继续收组件态'},
 {id:'card_4a3',t:'绘图底座与几何',kind:'unit',state:'done',parent:'card_257',
  facts:[['轮次','14'],['阶段','收口'],['节点','15'],['线','3 类']],
  last:'产出：布局铁律 x=48+depth×366，格子 NW×ROWH 防 LOD 震荡'},
 {id:'card_4b1',t:'设计令牌',kind:'worker',state:'done',parent:'card_257',
