  transform:translateY(3px);transition:opacity .13s,transform .13s}
.tip.on{opacity:1;pointer-events:auto;transform:none}
.tip-hd{display:flex;align-items:center;gap:6px;padding:8px 10px 6px;border-bottom:1px solid var(--line);
  font:11px var(--mono);color:var(--text3)}
.tip-hd b{color:var(--text2);font-family:inherit;font-size:11.5px}
.tip-msg{padding:8px 10px;font-size:12px;line-height:1.55;color:var(--text2)}
.tip-msg .who{color:var(--accent);font:10.5px var(--mono);margin-right:5px}
.tip-msg .tm{color:var(--text3);font:10px var(--mono);margin-left:5px}
.tip-msg .more{display:block;margin-top:5px;font-size:11px;color:var(--text3)}
/* 流式中：只占一行，行尾一个光标。内容还在变长，铺开全文会让浮层一秒跳三次高度。 */
.tip-msg.streaming{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding-right:12px}
.tip-msg.streaming .cur{display:inline-block;width:2px;height:12px;background:var(--accent);
  margin-left:3px;vertical-align:-1px;animation:blink 1s steps(1) infinite}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
.tip-tag{font:10px var(--mono);color:var(--accent);border:1px solid var(--accent);border-radius:3px;
  padding:0 4px;margin-left:6px}
.tip-in{display:flex;gap:5px;padding:6px 8px;border-top:1px solid var(--line)}
.tip-in input{flex:1;height:24px;border:1px solid var(--line2);border-radius:5px;background:var(--surface2);
  padding:0 7px;font-size:12px;outline:none;color:var(--text);min-width:0}
.tip-in input:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-weak)}
.hintbar{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:47;
  display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--line2);
  border-radius:4px;box-shadow:var(--shadow);padding:6px 8px 6px 14px;font-size:11.5px;color:var(--text2);
  transition:opacity .2s,transform .2s}
.hintbar.hide{opacity:0;transform:translate(-50%,8px);pointer-events:none}
.hintbar .h{display:flex;align-items:center;gap:5px;white-space:nowrap}
.hintbar .h b{color:var(--text);font-weight:600}
.hintbar .kb{font:10px var(--mono);padding:1px 4px;border:1px solid var(--line2);border-radius:3px;
  background:var(--surface3);color:var(--text2)}
.hintbar .x{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;color:var(--text3);font-size:11px}
.hintbar .x:hover{background:var(--surface3);color:var(--text)}
.dock{position:absolute;left:12px;top:56px;z-index:50;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
.dock-pill{display:flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:4px;
  background:var(--surface);border:1px solid var(--line2);box-shadow:var(--shadow);font-size:11.5px;
  color:var(--text2);cursor:pointer;transition:border-color .12s,color .12s}
.dock-pill:hover{border-color:var(--line3);color:var(--text)}
.dock-pill .cd{width:6px;height:6px;border-radius:50%;background:var(--wait)}
.dock-pill.open{border-color:var(--accent);color:var(--accent)}
.dock-panel{display:none;width:196px;background:var(--surface);border:1px solid var(--line2);border-radius:4px;
  box-shadow:var(--shadow2);padding:7px}
.dock-panel.open{display:block}
.dock-hd{font:10px var(--mono);color:var(--text3);letter-spacing:.06em;text-transform:uppercase;padding:3px 4px 5px}
.dock-row{display:flex;gap:4px;padding:0 4px 5px}
.dock-row .btn{flex:1;justify-content:center;height:23px;font-size:11px;padding:0 4px}
.states{position:absolute;left:12px;bottom:12px;width:372px;height:250px;z-index:56;display:none;background:var(--surface);border:1px solid var(--line2);border-radius:4px;box-shadow:var(--shadow2);overflow:hidden}
.states.on{display:block}
.st-wrap{position:absolute;inset:0;display:flex;flex-direction:column}
.st-banner{display:flex;align-items:center;gap:8px;padding:7px 12px;border-bottom:1px solid var(--line);
  background:var(--surface2);font:11px var(--mono);color:var(--text3)}
.st-banner b{color:var(--accent);font-family:inherit}
.st-body{flex:1;display:grid;place-items:center;padding:14px;overflow:auto}
.st-inner{max-width:320px;text-align:center}
.st-inner h3{margin:0 0 6px;font-size:14px;font-weight:600}
.st-inner p{margin:0 0 14px;font-size:12.5px;color:var(--text2);line-height:1.6}
.st-acts{display:flex;gap:7px;justify-content:center}
.st-code{display:inline-block;font:11px var(--mono);color:var(--blocked);border:1px dashed rgba(224,101,92,.45);
  padding:1px 6px;border-radius:4px;margin-bottom:8px}
.sk{background:var(--surface2);border:1px solid var(--line);border-radius:4px}
.sk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;width:min(760px,80vw)}
.sk-card{padding:13px;display:flex;flex-direction:column;gap:8px}
.sk-l{height:9px;border-radius:3px;background:linear-gradient(90deg,var(--surface3) 25%,var(--line) 37%,var(--surface3) 63%);
  background-size:400% 100%;animation:sh 1.3s ease infinite}
.sk-l.w40{width:40%}.sk-l.w70{width:70%}.sk-l.w55{width:55%}
@keyframes sh{0%{background-position:100% 50%}100%{background-position:0 50%}}
.diff{position:absolute;right:calc(var(--rp) + 12px);bottom:12px;z-index:50;width:344px;max-width:calc(100vw - 24px);
  background:var(--surface);border:1px solid var(--line2);border-radius:4px;box-shadow:var(--shadow2);
  overflow:hidden;transition:transform .2s}
.diff-hd{display:flex;align-items:center;gap:7px;padding:9px 11px;cursor:pointer;border-bottom:1px solid transparent}
.diff.open .diff-hd{border-bottom-color:var(--line)}
.diff-hd .ttl{font-size:12.5px;font-weight:600}
.diff-hd .cnt{font:10.5px var(--mono);color:var(--accent);background:var(--accent-weak);padding:1px 5px;border-radius:4px}
.diff-hd .arw{margin-left:auto;color:var(--text3);font-size:10px;transition:transform .2s}
.diff.open .diff-hd .arw{transform:rotate(180deg)}
.diff-body{display:none;max-height:392px;overflow:auto;padding:2px 0 6px}
.diff.open .diff-body{display:block}
.diff-item{padding:8px 11px;border-bottom:1px solid var(--line);cursor:pointer}
.diff-item:last-child{border-bottom:0}
