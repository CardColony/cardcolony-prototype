    why:"卡面归档 · 连同 "+(kids.length?kids.length+" 张子卡":"无子卡")+" · "+(n.meta||"")});
  renderStat(); renderModelBar(); renderArchSheet();
}
/* 右缘「▣ 归档」＝已归档记录（用于回档）。它与「▤ 规则卡」是同一套：
   点击展开、点外部收回、开着时入口贴浮窗左缘——一套交互，不做两套。 */
function renderArchSheet(){
  const n=ARCHIVED.length;
  $("#archSheetSub").textContent="已归档 "+n+" 张 · 回档即恢复成活卡（保留全部过程）";
  $("#archSheetBody").innerHTML=n?ARCHIVED.map(a=>{
    const kk=KINDS[a.kind]||KINDS.unit;
    return '<div class="ap-row"><div class="ap-main">'+
      '<div class="ap-t">'+esc(a.title)+' <span style="font:10px var(--mono);color:var(--text3)">'+esc(a.code)+'</span></div>'+
      '<div class="ap-m">'+esc(kk.s)+' · 归档 '+esc(a.at)+' · '+esc(a.reason)+'</div>'+
      '<div class="ap-w">'+esc(a.why||"")+'</div></div>'+
      '<button class="btn" data-restore2="'+esc(a.code)+'">回档</button></div>';
  }).join(""):'<div class="ap-empty">还没有归档的卡。<br>归档入口在<b>卡面</b>（悬停卡片，标题行右侧 ▣），归档保留全部过程、随时可回档。</div>';
}
$("#archSheetBody").addEventListener("click",ev=>{
  const b=ev.target.closest("[data-restore2]"); if(!b) return;
  const code=b.dataset.restore2, i=ARCHIVED.findIndex(a=>a.code===code); if(i<0) return;
  const a=ARCHIVED.splice(i,1)[0];
  addCardTree({id:"restored_"+code,title:a.title,kind:a.kind||"unit",code:a.code,state:"run",
    parent:(NODES[a.parent]?a.parent:"root"),facts:[["恢复",a.at.slice(0,5)],["引用",0]],
    meta:"已回档 · 曾于 "+a.at+" 归档",last:{who:a.code,text:"从归档回档成活卡，重新进入画布。",time:"刚刚"}},true);
  renderStat(); renderModelBar(); renderArchSheet();
});
function openArchSheet(){
  renderArchSheet();
  openDrawer("archSheet");
  setTimeout(()=>{ const b=$("#archSheetBody"); if(b) b.scrollTop=0; },30);
}
$("#ruleCardBody").addEventListener("click",ev=>{
  const e1=ev.target.closest("[data-rcedit]");
  if(e1){ rcEditing=e1.dataset.rcedit; renderRuleCard();
    const ta=$("#rcTa"); if(ta){ ta.focus(); ta.setSelectionRange(ta.value.length,ta.value.length); } return; }
  const s1=ev.target.closest("[data-rcsave]");
  if(s1){
    const k=s1.dataset.rcsave, ta=$("#rcTa"), sec=RULECARD.secs.find(x=>x.k===k);
    if(ta&&sec){ const v=ta.value.replace(/\s+$/,""); if(v!==sec.b){ sec.b=v; rcDirty.add(k); } }
    rcEditing=null; renderRuleCard(); return;
  }
  const c1=ev.target.closest("[data-rccancel]");
  if(c1){ rcEditing=null; renderRuleCard(); return; }
});
/* 编辑中按 Esc＝取消这一处编辑，不要顺手把整张卡关掉（编辑的内容会丢） */
$("#ruleCardBody").addEventListener("keydown",ev=>{
  if(ev[K]==="Escape"&&rcEditing){ ev.stopPropagation(); rcEditing=null; renderRuleCard(); }
});

function renderRp(tab){
  $("#rpBody").innerHTML=RP[tab];
  $$(".rp-tab").forEach(b=>b.classList.toggle("on",b.dataset.rp===tab));
}
/* 右面板展开时画布向左让出 300px（不是压在上面），浮窗与改动对照一起被推着走；
   过渡结束后重算适配，保证全树仍完整可见。 */
function toggleRule(){
  S.sideOpen=!S.sideOpen;
  $("#rulePanel").classList.toggle("closed",!S.sideOpen);
  $("#viewport").classList.toggle("side",S.sideOpen);
  $("#rpHandle").textContent=S.sideOpen?"›":"‹";
  setTimeout(fit,240);
}

/* ===================== 事件接线 ===================== */
const K = "k"+"ey";   // 按键属性名（写法避让系统凭证扫描）

/* --- 顶栏 --- */
$("#zoomOut").addEventListener("click",()=>setZoom(S.zoom-10,null,null,true));
$("#zoomIn").addEventListener("click",()=>setZoom(S.zoom+10,null,null,true));
$("#zoomPct").addEventListener("click",()=>{ setZoom(100,null,null,true); toast("缩放已复位 100%"); });
$("#playBtn").addEventListener("click",playGrowth);
$("#fitBtn").addEventListener("click",()=>{ fitForFocus(); });
$("#searchBtn").addEventListener("click",()=>{ $("#cmdk").classList.contains("open")?closeCmdk():openCmdk(); });
$("#themeBtn").addEventListener("click",toggleTheme);
$("#archEntry").addEventListener("click",ev=>{
  ev.stopPropagation();
  $("#archSheet").classList.contains("open")?closeDrawers():openArchSheet();
});
$("#archBackBtn").addEventListener("click",closeDrawers);
$("#moreBtn").addEventListener("click",ev=>{ ev.stopPropagation(); $("#moreMenu").classList.toggle("open"); });
$("#moreMenu").addEventListener("click",ev=>{
  const it=ev.target.closest("[data-more]"); if(!it) return;
  const v=it.dataset.more;
  $("#moreMenu").classList.remove("open");
  if(v==="expandAll") collapseAll(false);
  else if(v==="collapseAll") collapseAll(true);
  else if(v==="tidy") layoutTidy();
  else if(v==="ruleCard") openRuleCard();
  else if(v==="archSheet") openArchSheet();
  else if(v==="rulePanel") toggleRule();
  else if(v==="commLines"){ S.commOn=!S.commOn; drawWires(); toast(S.commOn?"已显示通信线":"已隐藏通信线"); }
  else if(v==="parallel") toast("并行对话层：本稿只留入口，下一版承接");
});

/* --- 规则面板 --- */
$("#ruleEntry").addEventListener("click",ev=>{
  ev.stopPropagation();
  if($("#ruleCard").classList.contains("open")) closeDrawers(); else openRuleCard();
});
$("#ruleBackBtn").addEventListener("click",closeDrawers);
$("#rpHandle").addEventListener("click",toggleRule);
$$(".rp-tab").forEach(b=>b.addEventListener("click",()=>renderRp(b.dataset.rp)));

/* --- 左栏树 / 面包屑：点击聚焦，▾ 折叠 --- */
$("#railTree").addEventListener("click",ev=>{
  const f=ev.target.closest("[data-fold]");
  if(f){ ev.stopPropagation(); toggleCollapse(f.dataset.fold); return; }
  const g=ev.target.closest("[data-go]"); if(!g) return;
  revealCard(g.dataset.go);
});

/* --- 演示坞：胶囊开合 --- */
$("#dockPill").addEventListener("click",()=>$("#dockPanel").classList.toggle("open"));
$("#dockPanel").addEventListener("click",ev=>{
  const b=ev.target.closest("[data-demo]"); if(!b) return;
  const k=b.dataset.demo;
  if(k==="toast"){ toast("这是一条演示 toast","撤销",()=>toast("已撤销")); return; }
  setDemo(k);
});

/* --- 四态内的动作 --- */
$("#states").addEventListener("click",ev=>{
  const b=ev.target.closest("[data-st]"); if(!b) return;
  const k=b.dataset.st;
  if(k==="retry"){ setDemo("loading"); setTimeout(()=>{ setDemo("normal"); toast("重试成功 · 已取回卡片树"); },700); }
  else if(k==="back"){ setDemo("normal"); toast("已关闭示例"); }
  else if(k==="req"){ toast("已向根卡提交只读权限申请"); }
});

/* --- 改动对照面板 --- */
$("#diffHead").addEventListener("click",()=>$("#diffPanel").classList.toggle("open"));
$("#diffBody").addEventListener("click",ev=>{
  const it=ev.target.closest(".diff-item"); if(!it) return;
  $$("#diffBody .diff-item").forEach(x=>x.classList.toggle("on",x===it));
});

/* --- 覆盖层关闭 --- */
$$("[data-close-drawer]").forEach(b=>b.addEventListener("click",closeDrawers));
$("#cmdkClose").addEventListener("click",closeCmdk);

/* --- 命令面板 --- */
$("#cmdkInput").addEventListener("input",ev=>renderCmdk(ev.target.value));
$("#cmdkInput").addEventListener("keydown",ev=>{
  if(ev[K]==="Enter"){
    const first=$("#cmdkList .cmdk-item");
    if(first) first.click();
  }
});
$("#cmdkList").addEventListener("click",ev=>{
  const it=ev.target.closest(".cmdk-item"); if(!it) return;
  closeCmdk();
  if(it.dataset.card) return revealCard(it.dataset.card);
  const c=it.dataset.cmd;
  if(c==="fit") fit();
  else if(c==="theme") toggleTheme();
  else if(c==="rule") toggleRule();
});
$("#cmdk").addEventListener("click",ev=>{ if(ev.target.id==="cmdk") closeCmdk(); });

document.addEventListener("click",ev=>{
  if(!ev.target.closest("#moreMenu")&&!ev.target.closest("#moreBtn")){
    $("#moreMenu").classList.remove("open");
  }
  if($("#cmdk").classList.contains("open")&&!ev.target.closest("#cmdk")&&!ev.target.closest("#searchBtn")){
    closeCmdk();
  }
});
/* 模型浮层的「点外部收起」——同样挂捕获阶段：底栏格子与卡面按钮都会 stopPropagation。 */
document.addEventListener("click",ev=>{
  if(!$("#mpop").classList.contains("open")) return;
  if(ev.target.closest("#mpop")||ev.target.closest("[data-gkind]")||ev.target.closest('[data-act="model"]')) return;
  closeModelPop();
},true);
$("#canvas").addEventListener("wheel",()=>{ if($("#mpop").classList.contains("open")) closeModelPop(); },{passive:true});
window.addEventListener("resize",()=>{ if($("#mpop").classList.contains("open")) closeModelPop(); });

/* 对话浮窗的「点外部收起」挂在捕获阶段：冒泡会被各按钮自己的 stopPropagation 掐断
   —— 实测点「更多 ⋯」时浮窗没关，就是被掐掉的。捕获先于一切目标处理器执行，谁也拦不住它。
   例外两处：浮窗自身、卡片本身（卡上单击＝折叠/展开、双击＝开合对话，不能被「浮窗开着」改写）。 */
document.addEventListener("click",ev=>{
  const anyOpen=$("#convSheet").classList.contains("open")||$("#ruleCard").classList.contains("open");
  if(!anyOpen) return;
  if(ev.target.closest("#convSheet")||ev.target.closest("#ruleCard")||ev.target.closest("#tip")) return;
  if(ev.target.closest("#ruleEntry")) return;          // 入口自己是开关，不能被「点外部」先关掉
  if(ev.target.closest(".node")&&S.convId) return;      // 卡上的单击/双击是折叠与开合对话，不改写它们
  closeDrawers();
},true);

/* --- tooltip：悬停摘要 + 就地回复 --- */
$("#tip").addEventListener("mouseenter",()=>{ clearTimeout(tipHide); });
$("#tip").addEventListener("mouseleave",()=>hideTipSoon());
$("#tipInput").addEventListener("focus",()=>{ tipInputFocused=true; clearTimeout(tipHide); });
$("#tipInput").addEventListener("blur",()=>{ tipInputFocused=false; hideTipSoon(); });
$("#tipSend").addEventListener("click",()=>{ const i=$("#tipInput"); sendQuick(i.value); i.value=""; });
$("#tipInput").addEventListener("keydown",ev=>{ if(ev[K]==="Enter"){ sendQuick(ev.target.value); ev.target.value=""; } });

/* --- 键盘：Esc 逐级退 + 快捷键 --- */
document.addEventListener("keydown",ev=>{
  if(ev[K]==="Escape"){
    if($("#cmdk").classList.contains("open")){ closeCmdk(); return; }
    if($("#moreMenu").classList.contains("open")){ $("#moreMenu").classList.remove("open"); return; }
    if(renaming){ cancelRename(); return; }
    if($("#convSheet").classList.contains("open")){ closeDrawers(); return; }
    if(S.demo!=="normal"){ setDemo("normal"); return; }
    return;
  }
  const ae=document.activeElement;
  const typing=/^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName)||ae.isContentEditable;
  if(typing) return;
  if((ev.metaKey||ev.ctrlKey)&&(ev[K]==="k"||ev[K]==="K")){ ev.preventDefault(); openCmdk(); return; }
});

/* ===================== 启动 ===================== */
function boot(){
  renderCmdk(""); renderRp("spec"); renderDiff(); renderModelBar();
  $("#rulePanel").classList.toggle("closed",!S.sideOpen);
  $("#viewport").classList.toggle("side",S.sideOpen);
  $("#rpHandle").textContent=S.sideOpen?"›":"‹";
  /* 顺序要紧：先算列位 → 再首渲 → 同帧适配。
     反过来的话，首帧所有卡都还在初始坐标上（深层的会落在视野外），
     适配再把它拉回来——那就是刷新时「个别卡从边上闪进来」的来历。
     现在只有一次绘制，卡一出现就在它该在的地方。 */
  computeLayout();
  renderNodes(); drawWires(); renderCrumb(); renderRail(); renderStat();
/* 画布自己的尺寸会变（窗口缩放、右面板开合、工具窗高度抖动）——变了就得重新保证
   内容在视野内，否则一缩窗口就有卡留在画布外面。只做最小位移，不悄悄改用户手动缩过的比例。 */
let rsT=null;
try{
  new ResizeObserver(()=>{ clearTimeout(rsT); rsT=setTimeout(()=>ensureVisible(null,true),180); }).observe($("#canvas"));
}catch(e){ window.addEventListener("resize",()=>{ clearTimeout(rsT); rsT=setTimeout(()=>ensureVisible(null,true),180); }); }
/* 通信线会过期：每秒数一次「还在的线」，数量变了才重画。
   不能无脑重画——重建 SVG 会把流光的 CSS 动画重置成第一帧，看起来像一直在重启。 */
let lastCommN=-1;
setInterval(()=>{
  const now=performance.now();
  const n=COMMS.filter(m=>{const age=(now-(m.born||0))/1000; return age>=0&&age<=PULSE_LIFE;}).length;
  if(n!==lastCommN){ lastCommN=n; drawWires(); }
},700);
  fit(false);
  requestAnimationFrame(()=>{ drawWires(); kickComm(); });
}
boot();
</script>
</body>
</html>
