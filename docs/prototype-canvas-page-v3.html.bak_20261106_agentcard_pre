const NW=290, NH=84, ROWH=96;   // 节点世界尺寸；ROWH＝布局行距（LOD 改高度也不动摇，避免缩放反复）

/* 状态词＝后端真实取值，不是我编的。三层，互不替代：
   ① 生命周期 state（config/card_type_registry.json → state_machine）：active / completed
   ② 自动推进 goal_state（auto_driver.py，只有 auto_mode=true 才谈得上）：
        active→running / paused→paused / complete→done / blocked→blocked（canvas.js:1843-1862）
   ③ 实时推送 live（/api/nav/running 流）：running＝正在跑 / queued＝排队中（canvas.js:6648）
   关键区别（旧系统原话）：running 是**动的**（呼吸），done/blocked/paused 是**静的**。
   「待裁定」不是任何 state 字段的取值——它是卡面内容里的一条待办，不进状态词。 */
const STATE_LABEL={run:"运行中",queued:"排队中",done:"已完成",blocked:"受阻",paused:"已暂停"};

/* ===== 卡类型体系（2026-11 改） =====
   结构卡按层级分三种：Master（根）／Manager（一级子项目）／Unit（二级及以下子项目）。
   原来二级与更深的不区分；现在**分开**——它们是两种卡、两种权限，所以数据上是不同 kind，
   不是同一张卡换个标签。工作卡（worker / QA / PM / UI）保持原名，只做视觉区分。
   课题卡（topic）本轮从需求里取消。 */
const KINDS={
  master :{n:"Master Agent Card",s:"Master", ic:"◆",struct:1},
  manager:{n:"Manager Agent Card",s:"Manager",ic:"◈",struct:1},
  unit   :{n:"Unit Agent Card",  s:"Unit",   ic:"◇",struct:1},
  worker :{n:"worker 卡",        s:"worker", ic:"▦",struct:0},
  qa     :{n:"QA 卡",            s:"QA",     ic:"✓",struct:0},
  pm     :{n:"PM 卡",            s:"PM",     ic:"✎",struct:0},
  ui     :{n:"UI 卡",            s:"UI",     ic:"◱",struct:0}
};
const KORDER=["master","manager","unit","worker","qa","pm","ui"];
/* 模型清单（示意用真实型号名，才看得出真实密度下的排布）。 */
