     浮窗只有一个：同一张卡再双击＝收起；双击别的卡＝直接换成那张（旧的自动让位）。 */
  if(clickTimer){ clearTimeout(clickTimer); clickTimer=null; }
  const cid=nodeEl.dataset.id;
  if(S.convId===cid && $("#convSheet").classList.contains("open")) closeDrawers();
  else openConv(cid);
});
$("#nodes").addEventListener("mouseover",e=>{
  const nodeEl=e.target.closest(".node"); if(!nodeEl) return;
  if(e.relatedTarget&&nodeEl.contains(e.relatedTarget)) return;
  scheduleTip(nodeEl.dataset.id,nodeEl);
});
$("#nodes").addEventListener("mouseout",e=>{
  const nodeEl=e.target.closest(".node"); if(!nodeEl) return;
  if(e.relatedTarget&&nodeEl.contains(e.relatedTarget)) return;
  hideTipSoon();
});

/* 贴右缘的浮窗目前三个：卡片对话、规则卡、归档。同级互斥（同时只开一个），
   因为三者都占同一条右缘——叠着开就会互相盖住。 */
const DRAWERS=["convSheet","ruleCard","archSheet"];
function openDrawer(id){
  DRAWERS.forEach(d=>$("#"+d).classList.toggle("open",d===id));
  if(id!=="convSheet") S.convId=null;
  if(id!=="ruleCard") rcEditing=null;
  $("#ruleEntry").classList.toggle("on",id==="ruleCard");
  $("#archEntry").classList.toggle("on",id==="archSheet");
  if(id==="archSheet") renderArchSheet();
  $("#viewport").classList.add("sheetOpen");
  renderCrumb();
}
function closeDrawers(){
  DRAWERS.forEach(d=>$("#"+d).classList.remove("open"));
  S.convId=null; rcEditing=null;
  $("#ruleEntry").classList.remove("on");
  $("#archEntry").classList.remove("on");
  $("#viewport").classList.remove("sheetOpen");
  renderCrumb();
}

const CONV={
  default:[
    ["card_074","界面语言按信息分层写，别拿配色当进度。","10:24"],
