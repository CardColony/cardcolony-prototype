/* 滚轮＝上下／左右平移（画布自己就是「页面」，页面没有原生滚动条）；
   Ctrl/⌘+滚轮＝以光标为锚缩放；Shift+滚轮＝横向。
   deltaMode 归一：Firefox 与部分鼠标按「行」滚（deltaMode=1，delta 是行数），
   不换算会变成一滚只动一两个像素，看起来就像滚轮失灵。 */
function wheelDelta(e){
  const k = e.deltaMode===1 ? 16 : (e.deltaMode===2 ? 400 : 1);
  return {x:e.deltaX*k, y:e.deltaY*k};
}
function onWheel(e){
  e.preventDefault();
  const d=wheelDelta(e);
  if(e.ctrlKey||e.metaKey){ setZoom(S.zoom*(d.y<0?1.1:0.9),e.clientX,e.clientY); return; }
  if(e.shiftKey&&!d.x){ S.tx-=d.y; applyTransform(); return; }
  S.tx-=d.x; S.ty-=d.y; applyTransform();
}
