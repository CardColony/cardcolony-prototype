    meta:"更新 10:31 · 6 张子卡",last:{who:"card_001",text:"画布页交互定稿，走视觉化之前先看信息与交互。",time:"10:31"},
    pos:{x:0,y:0}},
  prod:{title:"产品与交互需求",kind:"manager",code:"card_074",state:"run",parent:"root",
