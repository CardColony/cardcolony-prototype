        <button class="rail-btn on" title="画布">◱</button>
        <button class="rail-btn" title="对话">◧</button>
        <button class="rail-btn" title="产物">▤</button>
        <button class="rail-btn" title="规则">§</button>
      </div>
      <div class="rail-body">
        <div class="rail-sec">项目树</div>
        <ul class="tree" id="railTree"></ul>
        <div class="rail-sec" style="margin-top:10px">过滤</div>
        <ul class="tree">
          <li><div class="tree-row child"><span class="d" style="background:var(--run)"></span><span class="t">仅运行中</span></div></li>
          <li><div class="tree-row child"><span class="d" style="background:var(--blocked)"></span><span class="t">仅受阻</span></div></li>
