Object.keys(NODES).forEach((k,i)=>{ if(NODES[k].ord==null) NODES[k].ord=i; });
/* 归档卡不进画布、不占槽位——后端 archive_card 把 cards 那一行**删掉**、整行 meta 存进
   card_archive 表（card_store.py:1882-1890）。它已经不是活卡，画布上不可能有它的格子。
   所以归档收成父卡旁的一个计数入口，点开才列出记录（可恢复）。 */
const ARCHIVED=[{code:"card_021",title:"构建与发布",kind:"manager",parent:"root",
  at:"11-03 14:20",reason:"ARCH-04",why:"发布线并入「页面架构及 UI/UE」，本卡留存过程"}];

/* 通信线记录：每条＝一次真实发生过的消息传递，ago＝几秒前（演示窗口 12 秒，过期线自动消失）。
   txt 只给悬停读，画布上不铺字——线表达的是「有东西过去了」，不是「过去的是什么」。 */
const COMMS=[{a:"prod",b:"ext",ago:0.3,n:1,txt:"card_074 → card_118：依赖清单补齐三项，请重排期"},
             {a:"arch",b:"qa",ago:1.1,n:1,txt:"card_257 → card_091：三条交互口径已提升，请按新判据复核"},
             {a:"protoA",b:"protoB",ago:26,n:1,txt:"card_322 → card_319：组件表定稿，可对齐"}];
/* 一次传递在画布上的三段：信号沿曲线走过去 → 到站停一下 → 整条渐隐消失。
   时长按性能时钟逐帧算（不用 CSS 动画）：SVG 每重画一次，CSS 动画就被重置到第一帧。 */
const COMM_TRAVEL=0.62;   // 秒：信号头从发件端走到收件端
const COMM_HOLD=1.35;     // 秒：到站后停一下（收件端一点亮）
const COMM_FADE=0.85;     // 秒：整条渐隐
const PULSE_LIFE=COMM_TRAVEL+COMM_HOLD+COMM_FADE;   // ≈2.8 秒后这条线不在画布上
COMMS.forEach(m=>{ m.born=performance.now()-m.ago*1000; });

const S={zoom:100,tx:60,ty:20,convId:null,hint:true,demo:"normal",
  lod:"full",anno:false,sideOpen:false,commOn:true,theme:"light",collapsed:new Set()};
/* 子卡按「出生序号」排序，不按对象 key 的插入顺序。
   卡片树会被增删（推流、演示收回再长回来），key 顺序一变布局的纵向次序就跟着变——
   同一棵树会长成两个样子、适配缩放也对不上。序号随卡走，布局才是确定的。 */
let ORD=0;
function kidsOf(id){
  return Object.keys(NODES).filter(k=>NODES[k].parent===id)
    .sort((a,b)=>(NODES[a].ord==null?1e9:NODES[a].ord)-(NODES[b].ord==null?1e9:NODES[b].ord));
}
function hasKids(id){return kidsOf(id).length>0;}
function visibleIds(){
  const out=[];
  (function walk(id){
    if(NODES[id]._hidden) return;
    out.push(id);
    if(S.collapsed.has(id)) return;
    kidsOf(id).forEach(walk);
  })("root");
  return out;
}
function branchIds(id){
  const out=[];
  (function walk(x){
    if(NODES[x]._hidden) return;
    out.push(x);
    if(S.collapsed.has(x)) return;
    kidsOf(x).forEach(walk);
  })(id);
  return out;
}
function depthOf(id){return chainOf(id).length-1;}
function fitIdsFor(id){return branchIds(id);}

function nodeHTML(id){
  const n=NODES[id];
  const arch=n.arch?'<span class="archcode">'+esc(n.arch)+'</span>':'';
  const kk=KINDS[n.kind]||KINDS.unit;
  const kids=hasKids(id)?'<span class="n-kids" title="子卡数">'+kidsOf(id).length+'</span>':'';
  const mdl='<button class="n-model" data-act="model" title="这张卡用的模型 · 点选即改">'+esc(shortModel(n.model))+'</button>';
  return '<div class="n-top"><button class="n-caret" data-act="fold" title="折叠/展开该支">▾</button>'+
      '<span class="n-type" data-ic="'+kk.ic+'" title="'+esc(kk.n)+'">'+esc(kk.s)+'</span>'+
      '<span class="n-state"><span class="sd"></span>'+STATE_LABEL[n.state]+'</span>'+
      mdl+
      '<span class="n-code">'+esc(n.code)+'</span>'+kids+'</div>'+
    '<div class="n-title"><span class="t">'+esc(n.title)+arch+'</span>'+
      '<span class="n-fold">+0</span>'+
      '<span class="n-acts"><button class="n-act" data-act="conv" title="打开对话">◧</button>'+
        (id==="root"?'':'<button class="n-act" data-act="archive" title="归档这张卡（连同其子卡·保留过程·可回档）">▣</button>')+
      '</span>'+
      '<button class="pencil" data-act="pencil" title="重命名">✎</button></div>'+
    '<div class="n-facts">'+n.facts.map(f=>'<span>'+esc(f[0])+' <b>'+esc(f[1])+'</b></span>').join("")+'</div>'+
    '<div class="n-last"><i>'+esc(n.last.time)+'</i>'+esc(n.last.text)+'</div>';
}
function nodeEl(id){
  const el=document.createElement("div");
  el.className="node"+(hasKids(id)?" has-kids":"");
  el.dataset.id=id; el.dataset.state=NODES[id].state; el.dataset.kind=NODES[id].kind;
  el.setAttribute("role","group");
  el.setAttribute("aria-label",NODES[id].title+" · "+STATE_LABEL[NODES[id].state]+" · "+NODES[id].code);
  el.tabIndex=0;
  el.innerHTML=nodeHTML(id);
  return el;
}
/* 只重画这一张卡的内容（子卡数徽标、状态变了的场合）。其它卡与位置一个字不动。 */
function refreshNode(id){
  const el=$('#nodes .node[data-id="'+id+'"]'); if(!el) return;
  const n=NODES[id]; if(!n) return;
  el.innerHTML=nodeHTML(id);
  el.dataset.state=n.state; el.dataset.kind=n.kind;
  el.setAttribute("aria-label",n.title+" · "+STATE_LABEL[n.state]+" · "+n.code);
  el.classList.toggle("collapsed",S.collapsed.has(id));
  const caret=$(".n-caret",el); if(caret) caret.textContent=S.collapsed.has(id)?"▸":"▾";
  const fold=$(".n-fold",el); if(fold) fold.textContent=S.collapsed.has(id)?"+"+kidsOf(id).length:"";
}

const leaving=new Map();
/* 位移过渡的闸：只有这个窗口里节点才会「走过去」。
   新节点先落 left/top 再 appendChild——首帧就从 (0,0) 起步的话，
   刷新时能看见卡片从画布左上滑进场（列位越深滑得越远）。 */
let nodesAnimT=null;
function setNodesAnim(on){
  const h=$("#nodes"); clearTimeout(nodesAnimT);
  if(on){ h.classList.add("anim"); nodesAnimT=setTimeout(()=>h.classList.remove("anim"),480); }
  else h.classList.remove("anim");
}
function renderNodes(animate){
  setNodesAnim(!!animate);
  const host=$("#nodes");
  const ids=visibleIds();
  const have=new Map([...host.children].map(el=>[el.dataset.id,el]));
  ids.forEach(id=>{
    const n=NODES[id];
    let el=have.get(id); const isNew=!el;
    if(isNew){ el=nodeEl(id); el.style.left=n.pos.x+"px"; el.style.top=n.pos.y+"px"; host.appendChild(el); }
    else { have.delete(id); }
    if(leaving.has(id)){ clearTimeout(leaving.get(id)); leaving.delete(id); el.classList.remove("leave"); }
    el.style.left=n.pos.x+"px"; el.style.top=n.pos.y+"px";
    el.classList.toggle("collapsed",S.collapsed.has(id));
    const caret=$(".n-caret",el); if(caret) caret.textContent=S.collapsed.has(id)?"▸":"▾";
    const fold=$(".n-fold",el);
    if(fold) fold.textContent=S.collapsed.has(id)?"+"+kidsOf(id).length:"";
    if(isNew&&animate){
      el.classList.add("grow");
      el.addEventListener("animationend",()=>el.classList.remove("grow"),{once:true});
    }
    n._h=el.offsetHeight||NH;
  });
  /* 退场不「啪」一下消失：缩回并淡出 280ms 再移出 DOM。
     同 id 在 280ms 内回来（展开）时撤掉退场，不出现残影。 */
  have.forEach(el=>{
    if(!animate){ el.remove(); return; }
    const id=el.dataset.id;
    if(leaving.has(id)) return;
    el.classList.add("leave");
    leaving.set(id,setTimeout(()=>{ el.remove(); leaving.delete(id); },280));
  });
}

function anchorR(n){return {x:n.pos.x+NW, y:n.pos.y+(n._h||NH)/2};}
function anchorL(n){return {x:n.pos.x, y:n.pos.y+(n._h||NH)/2};}
function curve(a,b,cls){
  const dx=Math.max(40,(b.x-a.x)*0.5);
  return '<path class="'+cls+'" d="M '+a.x+' '+a.y+' C '+(a.x+dx)+' '+a.y+', '+(b.x-dx)+' '+b.y+', '+b.x+' '+b.y+'"/>';
}
/* 通信线＝「刚刚有信息过去」那一瞬的表达，不是拓扑。所以它有三条硬规矩：
   ① 不常驻：一条线只在传递发生后的 PULSE_LIFE 秒内存在，过期即消失（旧系统是 30 分钟窗口）；
   ② 画成曲线：直线穿过中间的卡会被误读成父子线（canvas.js:3954）；
   ③ 收件端一个实心点：表示「信落到这里」，配一圈扩散环表示「刚刚到」。
   画布上如果一条通信线都没有，那是**如实的**——这一刻确实没有信息在传。 */
function qpt(p0,p1,p2,u){
  const v=1-u;
  return {x:v*v*p0.x+2*v*u*p1.x+u*u*p2.x, y:v*v*p0.y+2*v*u*p1.y+u*u*p2.y};
}
/* 传递＝一颗流星沿着曲线飞过去：头亮、拖尾渐隐、到站后再整体消失。
   不是「先画一条线，再让光跑」——线上什么都没有留下，留下的只有那一下的经过。
   拖尾不按比例而是按**弧长**取：短线上尾巴不会糊成一团，长线上也不会断成一截。 */
const COMM_SEG=40;         // 曲线的采样段数（算弧长用）
const COMM_TAIL_MIN=70;    // 拖尾最短（世界坐标 px）
const COMM_TAIL_MAX=240;   // 拖尾最长
function commMarkup(geo){
  if(!S.commOn) return "";
  const now=performance.now();
  let h="";
  COMMS.forEach(m=>{
    const age=(now-(m.born||0))/1000;
    if(age<0||age>PULSE_LIFE) return;
    const g1=geo(m.a), g2=geo(m.b);
    if(!g1||!g2) return;
    const x1=g1.x+NW, y1=g1.y+g1.h/2, x2=g2.x, y2=g2.y+g2.h/2;
    const lift=Math.min(90,Math.abs(x2-x1)*0.22+30);
    const P0={x:x1,y:y1}, P1={x:(x1+x2)/2,y:(y1+y2)/2-lift}, P2={x:x2,y:y2};
    /* 采样一次曲线，拿累计弧长：头的位置、尾的起点都用「离起点多少像素」说话 */
    const pts=[], cum=[0];
    for(let i=0;i<=COMM_SEG;i++) pts.push(qpt(P0,P1,P2,i/COMM_SEG));
    for(let i=1;i<=COMM_SEG;i++) cum.push(cum[i-1]+Math.hypot(pts[i].x-pts[i-1].x, pts[i].y-pts[i-1].y));
    const total=cum[COMM_SEG]||1;
    const p=Math.max(0,Math.min(1,age/COMM_TRAVEL));
    const headD=total*p;                                   // 头已经飞了多远
    const tail=Math.min(COMM_TAIL_MAX,Math.max(COMM_TAIL_MIN,total*0.55));
    const tailD=Math.max(0,headD-tail);                    // 尾尖在哪
    /* 把「离起点距离」换算成采样下标 */
    const idxAt=d=>{ let k=0; while(k<COMM_SEG&&cum[k+1]<d) k++; return k; };
    const hi=idxAt(headD), ti=idxAt(tailD);
    const fade=age>PULSE_LIFE-COMM_FADE?Math.max(0,(PULSE_LIFE-age)/COMM_FADE):1;
    const arrived=(age>=COMM_TRAVEL);
    h+='<g class="comm-g" opacity="'+fade.toFixed(2)+'">';
    /* 拖尾：从头往后一段段画，越靠后越淡越细（流星尾巴） */
    const span=Math.max(1,hi-ti);
    for(let k=ti;k<=hi;k++){
      const u=(k-ti)/span;                                 // 0=尾尖 1=头
      const op=(0.04+0.72*Math.pow(u,1.7)).toFixed(3);
      const w=(0.9+2.6*Math.pow(u,1.5)).toFixed(2);
      const a=pts[k], b=pts[Math.min(hi,k+1)];
      h+='<path class="comm-tail" d="M '+a.x.toFixed(1)+' '+a.y.toFixed(1)+' L '+b.x.toFixed(1)+' '+b.y.toFixed(1)+
         '" stroke-opacity="'+op+'" stroke-width="'+w+'"/>';
    }
    const head=pts[hi];
    if(!arrived){
      h+='<circle class="comm-head-glow" cx="'+head.x.toFixed(1)+'" cy="'+head.y.toFixed(1)+'" r="10"/>'+
         '<circle class="comm-head" cx="'+head.x.toFixed(1)+'" cy="'+head.y.toFixed(1)+'" r="3.4"/>';
    }else{
      const rt=Math.min(1,(age-COMM_TRAVEL)/0.9);
      h+='<circle class="comm-head" cx="'+x2.toFixed(1)+'" cy="'+y2.toFixed(1)+'" r="3.2" opacity="'+Math.max(0,1-rt).toFixed(2)+'"/>'+
         '<circle class="comm-dot-ring" cx="'+x2.toFixed(1)+'" cy="'+y2.toFixed(1)+'" r="'+(4+rt*9).toFixed(1)+'" opacity="'+(0.6*(1-rt)).toFixed(2)+'"/>';
    }
    h+='<title>'+esc(m.txt||"")+'</title></g>';
  });
  return h;
}
/* 一次传递发生：从 a 到 b 拉一条线，信号走过去，到站后再渐渐消失。 */
function pulse(a,b,txt){
  if(!NODES[a]||!NODES[b]) return;
  COMMS.push({a:a,b:b,txt:txt||"",born:performance.now()});
  if(COMMS.length>8) COMMS.shift();
  drawWires(); kickComm();
}
/* 有线在画就逐帧重画（信号头在走路）；一条线都没有时自己停，不空转 */
let commRAF=null;
function kickComm(){
  if(commRAF) return;
  const step=()=>{
    drawWires();
    const now=performance.now();
    const alive=COMMS.some(m=>{const a=(now-(m.born||0))/1000; return a>=0&&a<PULSE_LIFE;});
    if(alive) commRAF=requestAnimationFrame(step);
    else { commRAF=null; drawWires(); }
  };
  commRAF=requestAnimationFrame(step);
}
/* 位移/重排过程中，连线要跟着卡走——否则卡在动、线还钉在老位置。
   读 computed left/top（过渡中的实时值）逐帧重画，过渡结束回落到 drawWires()。 */
let wireRAF=null;
function drawWiresLive(ms){
  cancelAnimationFrame(wireRAF);
  const t0=performance.now(), dur=ms||440;
  (function step(){
    const ids=visibleIds(), live=new Set(ids), geo={};
    ids.forEach(id=>{
      const el=$('#nodes .node[data-id="'+id+'"]');
      if(!el) return;
      const cs=getComputedStyle(el);
      geo[id]={x:parseFloat(cs.left)||0, y:parseFloat(cs.top)||0, h:el.offsetHeight||NH};
    });
    const aR=g=>({x:g.x+NW, y:g.y+g.h/2}), aL=g=>({x:g.x, y:g.y+g.h/2});
    let h="";
    ids.forEach(id=>{
      const n=NODES[id], g=geo[id];
      if(!g||!n) return;
      if(n.parent&&geo[n.parent]) h+=curve(aR(geo[n.parent]),aL(g),"wire-p");
    });
    h+=commMarkup(id=>{const g=geo[id]; return (g&&live.has(id))?g:null;});
    $("#wires").innerHTML=h;
    if(performance.now()-t0<dur) wireRAF=requestAnimationFrame(step);
    else drawWires();
  })();
}
function drawWires(){
  const ids=new Set(visibleIds());
  let h="";
  ids.forEach(id=>{
    const n=NODES[id];
    if(n.parent&&ids.has(n.parent)) h+=curve(anchorR(NODES[n.parent]),anchorL(n),"wire-p");
  });
  h+=commMarkup(id=>{const n=NODES[id]; return (n&&ids.has(id))?{x:n.pos.x,y:n.pos.y,h:(n._h||NH)}:null;});
  $("#wires").innerHTML=h;
}

function lodOf(z){ return z<58?"far":(z<72?"near":(z<96?"full":"ultra")); }
let animT=null,lodT=null;
/* animate=true：画布走过渡，画面连续放大缩小（折叠/展开/适配/定位都算）。
   animate=false：手势（拖、滚轮、触屏）——必须跟手，过渡会变成拖影。
   LOD 档位推迟到过渡末再切：否则字会在缩放途中「跳」一下。 */
/* 过渡期间百分比读数跟着实际比例走——否则矩阵还在 77%，标签已经写 85%，
   两处读数打架，用户会以为卡住了。过渡结束再落回目标值。 */
let zoomRAF=null;
function trackZoomLabel(){
  cancelAnimationFrame(zoomRAF);
  const t0=performance.now();
  const paint=()=>{
    const m=getComputedStyle($("#world")).transform;
    if(m&&m!=="none"){
      const a=parseFloat(m.slice(m.indexOf("(")+1));
      if(isFinite(a)) $("#zoomPct").textContent=Math.round(a*100)+"%";
    }
  };
  (function step(){
    paint();
    if(performance.now()-t0<430) zoomRAF=requestAnimationFrame(step);
    else $("#zoomPct").textContent=Math.round(S.zoom)+"%";
  })();
}
function applyTransform(animate){
  const w=$("#world");
  clearTimeout(animT); clearTimeout(lodT);
  if(animate){ w.classList.add("anim"); animT=setTimeout(()=>w.classList.remove("anim"),430); }
  else { w.classList.remove("anim"); }
  w.style.transform="translate("+S.tx+"px,"+S.ty+"px) scale("+(S.zoom/100)+")";
  if(animate) trackZoomLabel();
  if(animate){ lodT=setTimeout(()=>{ w.dataset.lod=lodOf(S.zoom); },390); }
  else w.dataset.lod=lodOf(S.zoom);
  if(!animate) $("#zoomPct").textContent=Math.round(S.zoom)+"%";   // 过渡中由 trackZoomLabel 按实际比例写
  const c=$("#canvas"); c.scrollLeft=0; c.scrollTop=0;
}

function setZoom(z,ax,ay,animate){
  z=Math.max(25,Math.min(200,z));
  const r=$("#canvas").getBoundingClientRect();
  if(ax==null){ax=r.left+r.width/2; ay=r.top+r.height/2;}
  const k=z/S.zoom;
  S.tx=(ax-r.left)-((ax-r.left)-S.tx)*k;
  S.ty=(ay-r.top)-((ay-r.top)-S.ty)*k;
  S.zoom=z; applyTransform(animate);
}

function measure(){
  visibleIds().forEach(id=>{
    const el=$('#nodes .node[data-id="'+id+'"]');
    if(el) NODES[id]._h=el.offsetHeight||NH;
  });
}
/* 画布宽度已随右面板变窄（CSS right 过渡），这里按当前 rect 算，不再二次扣面板宽度。
   bbox 用固定格子（NW×ROWH）而不是实测节点高度：LOD 会改节点高度，
   用实测值会让「缩放→档位→高度→缩放」互相反馈、收不敛。 */
function fit(ids,animate){
  ids=ids||visibleIds();
  const r=$("#canvas").getBoundingClientRect();
  const aw=Math.max(200,r.width-88), ah=Math.max(160,r.height-88);
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  ids.forEach(id=>{const n=NODES[id];
    x0=Math.min(x0,n.pos.x); y0=Math.min(y0,n.pos.y);
    x1=Math.max(x1,n.pos.x+NW); y1=Math.max(y1,n.pos.y+ROWH);});
  const z=Math.max(25,Math.min(150,Math.min(aw/Math.max(1,x1-x0),ah/Math.max(1,y1-y0))*100));
  S.zoom=z;
  S.tx=r.width/2-((x0+x1)/2)*z/100;
  S.ty=r.height/2-((y0+y1)/2)*z/100;
  applyTransform(animate);
  if(animate) drawWiresLive(440);
}

function chainOf(id){const out=[];let c=id;while(c){out.unshift(c);c=NODES[c].parent;}return out;}
/* 面包屑＝选中卡在树里的位置（只读，不是一层级） */
function renderCrumb(){
  let h='<span class="seg cur">全景</span>';
  if(S.convId&&NODES[S.convId]){
    chainOf(S.convId).slice(1).forEach(x=>{ h+='<span class="sep">›</span><span class="seg">'+esc(NODES[x].title)+'</span>'; });
    h+='<span class="sep">·</span><span class="seg">对话</span>';
  }
  $("#crumb").innerHTML=h;
}

function fitForFocus(){ fit(); toast("已适配全树"); }
function centerOn(ids){
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  ids.forEach(id=>{const n=NODES[id],h=n._h||NH;
    x0=Math.min(x0,n.pos.x); y0=Math.min(y0,n.pos.y);
    x1=Math.max(x1,n.pos.x+NW); y1=Math.max(y1,n.pos.y+h);});
  const r=$("#canvas").getBoundingClientRect();
  const aw=Math.max(200,r.width-88), ah=Math.max(160,r.height-88);
  const need=Math.min(aw/Math.max(1,x1-x0), ah/Math.max(1,y1-y0))*100;
  if(need<S.zoom) S.zoom=Math.max(25,need);   // 装不下才缩小，绝不主动放大成局部
  const k=S.zoom/100;
  S.tx=r.width/2-((x0+x1)/2)*k;
  S.ty=r.height/2-((y0+y1)/2)*k;
  applyTransform(true);
  drawWiresLive(440);
}
/* 定位＝把这张卡指给用户看。开模式、淡化其它卡、需要退出——一件都不做。
   已在视野里就不动画布（只高亮）；装不下才平移。画布不会自己跑。 */
function revealCard(id){
  const n=NODES[id]; if(!n) return;
  const el=$('#nodes .node[data-id="'+id+'"]');
  if(el){
    const cr=el.getBoundingClientRect(), vr=$("#canvas").getBoundingClientRect();
    const inside = cr.left>=vr.left+6 && cr.top>=vr.top+6 && cr.right<=vr.right-6 && cr.bottom<=vr.bottom-6;
    if(!inside) centerOn([id]);
    el.classList.remove("flash"); void el.offsetWidth; el.classList.add("flash");
    setTimeout(()=>el.classList.remove("flash"),1400);
  }
}
/* 折叠/展开＝密度旋钮：收起后剩下的卡重新紧凑排布（不留空洞）→ 同一块画布放得下更大比例
   → 卡更大、字更清、LOD 升档看到更多信息；展开则反过来。 */
function toggleCollapse(id){
  if(!hasKids(id)) return;
  if(S.collapsed.has(id)) S.collapsed.delete(id); else S.collapsed.add(id);
  renderNodes(true); renderRail();      // 退场的卡缩回淡出，留下的卡移动到位
  layoutTidy(true,true);                // 画布随之连续放大/缩小
}
function collapseAll(v){
  if(v) Object.keys(NODES).forEach(id=>{ if(hasKids(id)&&id!=="root") S.collapsed.add(id); });
  else S.collapsed.clear();
  renderNodes(true); renderRail(); layoutTidy(true,true);
}
/* ===== 自增长：卡片树是后端推流来的，随时会多出一张 =====
   动效要让人看清三件事：从哪长出来的、其余卡怎么让位、画布怎么跟上。
   做法：新卡先出现在父卡右下方，再走 380ms 到自己的列位；其余卡同时被推开；
   画布重新适配也是过渡。一步只加一张——推流是一张一张到的，不是整片刷新。 */
function addCardTree(spec,animate,noFit){
  const id=spec.id, pid=spec.parent||"root";
  if(NODES[id]) return id;
  const pn=NODES[pid]||NODES.root;
  S.collapsed.delete(pid);                        // 父卡若折叠着，新卡到了要展开才看得见
  NODES[id]=Object.assign({},spec,{
    pos:{x:pn.pos.x+Math.round(NW*0.55), y:pn.pos.y+Math.round(ROWH*0.5)},
    ord:(spec.ord!=null?spec.ord:++ORD)
  });
  /* type 一律由 kind 派生；model 缺省取该类全局值。新长出来的卡不许自带一份手写类型。 */
  NODES[id].kind=NODES[id].kind||"unit";
  NODES[id].type=KINDS[NODES[id].kind].n;
  if(!NODES[id].model) NODES[id].model=GMODEL[NODES[id].kind];
  renderModelBar();
  renderNodes(animate);                           // 此刻它落在父卡旁（起点）
  const el=$('#nodes .node[data-id="'+id+'"]');
  if(el&&animate) el.classList.add("grow");
  if(el) void el.offsetWidth;                     // 让「父卡旁」这一帧落定，下一步才有起点可过渡
  refreshNode(pid);                               // 父卡的子卡数徽标跟着变
  renderRail(); renderStat();
  layoutTidy(true,animate,noFit);                 // 走到自己的列位（noFit 时不动画布比例）
  ensureVisible([id],animate);                    // 新卡不许出画：装得下就平移、装不下才缩放
  return id;
}
function removeCardTree(id,animate){
  if(!NODES[id]) return;
  const kids=kidsOf(id).slice();
  kids.forEach(k=>removeCardTree(k,false));
  const pid=NODES[id].parent;
  delete NODES[id];
  renderNodes(animate); drawWires(); renderRail(); renderStat();
  if(pid) refreshNode(pid);
  layoutTidy(true,animate);
}
/* 演示：从根卡开始，把整棵树一层层长到底。
   推流是「一张一张到」的，不是整片刷新——所以先把非根卡全部收回（画布只剩根卡，
   自动放大到能看清它），再按深度从浅到深逐张 addCardTree：
   父卡一定先于子卡出现，看得见每一支是从谁下面长出来的、其余卡怎么让位。
   演示用的是当前这棵树本身（快照→收回→长回来），不另造一套假数据。 */
let playing=false,playTimers=[];
function snapshotTree(){
  return Object.keys(NODES).filter(id=>id!=="root").map(id=>{
    const n=NODES[id];
    return {depth:depthOf(id),spec:{id:id,title:n.title,kind:n.kind,model:n.model,code:n.code,state:n.state,
      parent:n.parent,facts:(n.facts||[]).slice(),meta:n.meta,last:n.last,live:n.live,arch:n.arch,
      _hidden:n._hidden,ord:n.ord}};
  }).sort((a,b)=>a.depth-b.depth);
}
function playGrowth(){
  if(playing) return;
  const btn=$("#playBtn");
  const snap=snapshotTree();
  if(!snap.length) return;
  playing=true; btn.disabled=true; btn.textContent="生长中…";
  const stopAll=()=>{ playTimers.forEach(clearTimeout); playTimers=[];
    playing=false; btn.disabled=false; btn.textContent="▶ 从根生长"; };
  /* ① 收回：只留根卡。退场走 280ms 淡出，画布随之放大到「一张卡」的比例。 */
  S.collapsed.clear();
  snap.forEach(x=>{ delete NODES[x.spec.id]; });
  renderNodes(true); renderRail(); renderStat(); renderCrumb();
  /* 适配延到退场（280ms）之后：退场卡还在 DOM 里淡出，这时把画布放大到「只剩根卡」的
     比例，它们会被瞬间甩到视野外——看着像一屋子卡被弹飞。等它们收了再放大。 */
  layoutTidy(true,true,true);                      // 只重排，不动画布比例
  playTimers.push(setTimeout(()=>{ fit(null,true); },300));
  /* ② 按层长回去：同一深度的卡一张张出现（父卡必定已在位），
        一层长完停一拍、才适配一次——于是看到的是「一层层往外长」，
        而不是每张卡都让画布缩一下（那样整幅画面一直在抖，层级反而看不清）。
        层内 noFit：卡在自己的列里排队，画布不动。 */
  const byD={}; snap.forEach(x=>{ (byD[x.depth]=byD[x.depth]||[]).push(x); });
  const ds=Object.keys(byD).map(Number).sort((a,b)=>a-b);
  let t=640;
  ds.forEach(d=>{
    byD[d].forEach((x,k)=>{
      playTimers.push(setTimeout(()=>{ addCardTree(x.spec,true,true); },t));
      if(k<byD[d].length-1) t+=300;
    });
    t+=520;                                                 // 这一层长完，停一拍
    playTimers.push(setTimeout(()=>{ fit(null,true); },t-280));
  });
  playTimers.push(setTimeout(()=>{ fit(null,true); },t+40));    // 收尾再适配一次，消掉多段残差
  playTimers.push(setTimeout(stopAll,t+560));
}
function visKids(id){ return kidsOf(id).filter(k=>!NODES[k]._hidden&&!S.collapsed.has(id)); }
function leafCount(id){ const k=visKids(id); return k.length? k.reduce((a,b)=>a+leafCount(b),0) : 1; }
function subDepth(id){ const k=visKids(id); return k.length? 1+Math.max(...k.map(subDepth)) : 0; }
/* 布局＝层级列对齐：同一深度的卡永远落在同一列（x = PAD + 深度×列距），
   纵向按子树次序紧凑堆叠、父卡居中于其子卡。
   这条规矩是硬约束——上一稿为了让画布「填满」把互不相交的子树并排放，
   于是某支的子卡跑到了别支孙卡的右边，看上去像它更深一层，层级读不出来。
   折叠＝该支从画布上消失、其余支重新紧凑堆叠 → 总高变小 → 适配放大 → 信息升档。 */
function computeLayout(){
  const GAPX=76, PAD=48;
  const pos={};
  let row=0;
  (function place(id,d){
    const kids=visKids(id);
    const x=PAD+d*(NW+GAPX);
    if(!kids.length){ pos[id]={x:x, y:PAD+row*ROWH}; row++; return; }
    const ys=kids.map(k=>{ place(k,d+1); return pos[k].y; });
    pos[id]={x:x, y:Math.round((Math.min.apply(null,ys)+Math.max.apply(null,ys))/2)};
  })("root",0);
  Object.keys(pos).forEach(id=>{ if(NODES[id]) NODES[id].pos=pos[id]; });
}
/* 新卡不许出画：生长时树在变大，画布必须跟上，否则「变化的那一点」正好在屏幕外。
   但也不能每张都全树适配——那样整幅一直在缩，层级反而看不清。
   所以分两步：① 装得下就只平移（把新卡拉回视野，画面不缩放）；② 真装不下才重新适配。 */
function ensureVisible(focusIds,animate){
  const r=$("#canvas").getBoundingClientRect();
  const pad=56, z=S.zoom/100;
  const box=ids=>{
    let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
    ids.forEach(id=>{const n=NODES[id]; if(!n)return;
      x0=Math.min(x0,n.pos.x); y0=Math.min(y0,n.pos.y);
      x1=Math.max(x1,n.pos.x+NW); y1=Math.max(y1,n.pos.y+ROWH);});
    return x0>x1?null:{x0:x0,y0:y0,x1:x1,y1:y1};
  };
  const bAll=box(visibleIds()); if(!bAll) return false;
  const inView=b=>{
    const sx0=b.x0*z+S.tx, sx1=b.x1*z+S.tx, sy0=b.y0*z+S.ty, sy1=b.y1*z+S.ty;
    return sx0>=pad&&sy0>=pad&&sx1<=r.width-pad&&sy1<=r.height-pad;
  };
  if(inView(bAll)) return false;
  const bF=box(focusIds||visibleIds())||bAll;
  const availW=r.width-pad*2, availH=r.height-pad*2;
  if((bAll.x1-bAll.x0)*z<=availW && (bAll.y1-bAll.y0)*z<=availH){
    let dx=0,dy=0;
    const sx0=bF.x0*z+S.tx, sx1=bF.x1*z+S.tx, sy0=bF.y0*z+S.ty, sy1=bF.y1*z+S.ty;
    if(sx1>r.width-pad) dx=r.width-pad-sx1;
    if(sx0+dx<pad) dx=pad-sx0;
    if(sy1>r.height-pad) dy=r.height-pad-sy1;
    if(sy0+dy<pad) dy=pad-sy0;
    if(dx||dy){ S.tx+=dx; S.ty+=dy; applyTransform(animate); return true; }
  }
  fit(null,animate); return true;
}
/* noFit=true：只重排、不动画布比例（推流分层生长时用——层内不动画布，层末才适配一次） */
function layoutTidy(quiet,animate,noFit){
  computeLayout();
  renderNodes(!!animate); drawWires();
