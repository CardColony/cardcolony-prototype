function closeCmdk(){ $("#cmdk").classList.remove("open"); }
function runCmd(name,id){
  if(name==="conv") return openConv(id);
  if(name==="rename") return startRename(id);
  if(name==="focus") return revealCard(id);
  if(name==="fold") return toggleCollapse(id);
  if(name==="fit") return fitForFocus();
  if(name==="tidy") return layoutTidy();
  if(name==="theme") return toggleTheme();
  if(name==="expandAll") return collapseAll(false);
  if(name==="collapseAll") return collapseAll(true);
}



