  evid:{title:"验收证据包",kind:"worker",code:"card_096",state:"done",parent:"qa",
    facts:[["条数",12],["证据",12]],
    meta:"收口 09:12 · 12/12",last:{who:"card_096",text:"每条都留原始输出，可按条独立复核。",time:"09:12"},
    pos:{x:0,y:0}},
  trace:{title:"交互轨迹留档",kind:"worker",code:"card_331",state:"paused",parent:"spec",
    facts:[["录制",4],["缺",1]],
    meta:"停住 10:48 · 等重录",last:{who:"card_331",text:"合成事件录不全，有一条要人工补一次。",time:"10:48"},
    pos:{x:0,y:0}}
};
/* type 是派生值：只由 kind 决定，不许在数据里各写一遍（两处写死必然走形）。 */
Object.keys(NODES).forEach(k=>{
  const n=NODES[k];
  n.type=KINDS[n.kind].n;
  if(!n.model) n.model=GMODEL[n.kind];
