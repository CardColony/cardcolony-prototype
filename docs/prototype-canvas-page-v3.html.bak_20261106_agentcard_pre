  font:10px var(--mono);display:grid;place-items:center}
.diff-item.on .no{background:var(--accent);color:#fff}
.diff-item .b{font-size:11.5px;line-height:1.6;color:var(--text2);margin:4px 0 0 23px}
.diff-item .why{font-size:11.5px;line-height:1.6;color:var(--text2);margin:2px 0 0 23px}
.diff-item .why::before{content:"为什么 ";color:var(--text3);font-size:10.5px}
.anno{display:none}
body.anno .anno{display:grid}
.anno{position:absolute;z-index:36;min-width:18px;height:18px;padding:0 4px;place-items:center;
  background:var(--accent);color:#fff;font:10px var(--mono);border-radius:4px;pointer-events:none;
  box-shadow:0 0 0 3px var(--accent-weak)}
.sr{position:absolute;left:-9999px}
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-thumb{background:var(--line2);border-radius:5px;border:2px solid var(--surface)}
::-webkit-scrollbar-thumb:hover{background:var(--line3)}
::-webkit-scrollbar-track{background:transparent}

/* ==== LOD：信息优先级随画布密度切换（折叠/缩放联动） ==== */
/* 四档各自的「显示什么」只在这里定义一次，不许在别处再写一遍：
   far 标题+状态+子卡数 / near 加类型行与前 2 项事实 / full 加事实全量与最近更新 /
   ultra 把计数换成「最近一条说了什么」。 */
.world[data-lod="far"] .n-type,
.world[data-lod="far"] .n-facts,
.world[data-lod="far"] .n-last,
.world[data-lod="far"] .n-acts{display:none}
.world[data-lod="far"] .n-title .t{font-size:14px}
.world[data-lod="near"] .n-last{display:none}
.world[data-lod="near"] .n-facts span:nth-child(n+3){display:none}
.world[data-lod="full"] .n-last{display:none}
/* 最近档：卡片足够大时，把干巴巴的计数换成「最近一条说了什么」——同高替换，不撑高卡片 */
.n-last{display:none;padding:8px 13px 0;font-size:12px;line-height:1.5;color:var(--text2);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.n-last i{font-style:normal;font:11px var(--mono);color:var(--text3);margin-right:5px}
.world[data-lod="ultra"] .n-last{display:block}
.world[data-lod="ultra"] .n-facts{display:none}
.world[data-lod="far"] .node[data-state="blocked"]{box-shadow:inset 3px 0 0 var(--blocked)}
.world[data-lod="far"] .node[data-state="paused"]{box-shadow:inset 3px 0 0 var(--wait)}
.world[data-lod="far"] .node[data-state="queued"]{box-shadow:inset 3px 0 0 var(--run)}
.node.flash{animation:nFlash 1.3s ease}
@keyframes nFlash{0%,100%{outline:3px solid transparent;outline-offset:1px}25%,60%{outline:3px solid var(--accent);outline-offset:1px}}
.node.collapsed{border-style:dashed}
.n-caret{width:18px;height:18px;flex:0 0 18px;display:none;align-items:center;justify-content:center;
  border:0;background:transparent;color:var(--text3);font-size:10px;cursor:pointer;border-radius:3px;padding:0}
.node.has-kids .n-caret{display:flex}
.node.has-kids:hover .n-caret{color:var(--text)}
.n-caret:hover{background:var(--surface3);color:var(--text)}
.n-kids{margin-left:auto;font-size:11px;color:var(--text3);border:1px solid var(--line2);
  border-radius:4px;padding:0 5px;line-height:14px}
.n-fold{display:none;font-size:11px;color:var(--accent);border:1px solid var(--accent);
  border-radius:4px;padding:0 5px;line-height:14px;margin-left:4px}
.node.collapsed .n-fold{display:inline-block}
#canvas.grab{cursor:grab}
#canvas.grab:active{cursor:grabbing}
.crumb .seg{cursor:default}
.crumb .seg.cur{color:var(--text);font-weight:600}
/* 远档只留：标题 + 状态 + 子卡数 */
.world[data-lod="far"] .n-code{display:none}
.pencil{opacity:0;pointer-events:none;transition:opacity .12s}
.node:hover .pencil,.node:focus-within .pencil{opacity:1;pointer-events:auto}
@media (prefers-reduced-motion:reduce){
  .node,.pencil,.world.anim{transition:none}
  .node.grow{animation:none}}
.hintbar{left:12px;transform:none;max-width:calc(100vw - 400px);flex-wrap:wrap}
@media (max-width:980px){.hintbar{display:none}}
</style>
