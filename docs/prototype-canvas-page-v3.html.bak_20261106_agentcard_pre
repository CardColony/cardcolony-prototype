$("#convSend").addEventListener("click",()=>{
  const v=$("#convInput").value.trim(); if(!v) return;
  const b=$("#convBody");
  b.insertAdjacentHTML("beforeend",'<div class="msg mine"><div class="av">我</div><div class="bd">'+
    '<div class="hd"><b>me</b><span>刚刚</span></div><div class="tx">'+esc(v)+'</div></div></div>');
  $("#convInput").value=""; b.scrollTop=b.scrollHeight;
  /* 发出一条消息＝画布上真的有一次传递：从父卡到这张卡拉一条线、流一下、12 秒后消失。
     这就是「信息传递只在那一下用线表达」——不常驻、不留痕。 */
  if(S.convId&&NODES[S.convId]&&NODES[S.convId].parent) pulse(NODES[S.convId].parent,S.convId,"我 → "+NODES[S.convId].code+"：发了一条消息");
