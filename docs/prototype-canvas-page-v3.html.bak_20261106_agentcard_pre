  {id:"gemini-3-pro",n:"Gemini 3 Pro",s:"gemini"},
  {id:"deepseek-v4",n:"DeepSeek V4",  s:"dsv4"}
];
const modelOf=id=>MODELS.find(m=>m.id===id)||MODELS[0];
const shortModel=id=>modelOf(id).s;
/* 全局模型配置：一格一类。底栏改它＝改这一类全部卡；卡面改它＝只改这一张。
   两者不冲突：卡面是覆盖值，底栏是这一类的默认值。 */
