    meta:"更新 10:40 · 返工中",last:{who:"card_257",text:"7 条缺陷已逐条修，手势与出口各自闭环。",time:"10:40"},
    pos:{x:0,y:0}},
  qa:{title:"验收与证据基线",kind:"manager",code:"card_091",state:"done",parent:"root",
    facts:[["轮次",12],["通过",12],["证据",4]],
    meta:"收口 09:12 · 12/12 通过",last:{who:"card_091",text:"证据包已归档，验收结果可按条复核。",time:"09:12"},
    pos:{x:0,y:0}},
  ext:{title:"外部接入与联调",kind:"manager",code:"card_118",state:"blocked",parent:"root",
    facts:[["接口",3],["等谁","外方"],["卡点",2]],
    meta:"停住 08:50 · 受阻待处理",last:{who:"card_118",text:"三方签名未回，自动推进停下等人接手。",time:"08:50"},
    pos:{x:0,y:0}},
  protoA:{title:"高保真原型 · 画布页",kind:"ui",code:"card_322",state:"run",parent:"prod",
    facts:[["版本","v3"],["缺陷","7 条"],["轮次",3]],
