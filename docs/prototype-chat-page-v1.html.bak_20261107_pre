<div id="toastContainer" aria-live="polite"></div>

<script>
(function(){'use strict';
/* 演示聚焦：URL hash 带 #hide=nav,chat 等时隐藏指定区域，便于单独核对某一块并精确量测尺寸；
   默认（无 hash）完全不隐藏，不影响任何形态。这是原型自带的量测辅助，不是产品态。 */
(function(){
  var m=(location.hash||'').match(/hide=([\w,\-]+)/);
  if(!m)return;
  var map={nav:'#appNav',chat:'#chatArea',rv:'#rvWin',rvstrip:'#rvStrip',rule:'#rulePanel',
           insp:'#inspector',inspectab:'#inspTab',cmp:'#cmpPanel',composer:'#composerSeat',
           topbar:'.topbar',sample:'#sampleWrap',older:'#flowOlder',rvwin:'#rvWin'};
  var css=m[1].split(',').map(function(k){return map[k]?map[k]+'{display:none!important}':'';}).join('');
  var st=document.createElement('style');st.setAttribute('data-focus-mode','1');st.textContent=css;
  document.head.appendChild(st);
})();
function $(id){return document.getElementById(id);}
function on(id,ev,fn){var el=$(id);if(el){el.addEventListener(ev,fn);}else{console.warn('[prototype] missing #'+id);}}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function toast(msg,kind){var box=$('toastContainer');if(!box)return;var t=document.createElement('div');t.className='toast'+(kind?' '+kind:'');t.textContent=msg;t.addEventListener('click',function(){t.remove();});box.appendChild(t);setTimeout(function(){t.remove();},2600);}

/* ---------- DOM id 自检：JS 引用 vs DOM 全集 ---------- */
var JS_IDS=['appNav','navActions','navNotifyBtn','npBadge','navNewProject','navSearchBox','navSearchInput','navSearchClear','navTree','navSettingsBtn','navDrawerBtn','chatCrumb','canvasEntryBtn','procToggleBtn','themeToggleBtn','topInspBtn','workspace','flowScroll','flowOlder','chatArea','flowTurnStatus','flowToBottom','composerSeat','queueBar','queueCount','queueList','queueClear','flowInput','flowSendBtn','modelBadgeMount','modelMenu','autoToggleBtn','statusDraftBtn','draftBtn','draftModal','draftModalX','draftModalTitle','draftArea','draftFeedbackInput','draftCloseBtn','draftFeedbackBtn','draftConfirmBtn','statusModal','statusModalX','statusModalTitle','statusOrig','statusEditArea','statusCloseBtn','statusConfirmBtn','inspTab','inspector','inspName','inspCardId','inspStatusChip','inspStatusWord','inspModelBadge','inspClose','inspStatusText','inspEditStatusBtn','relList','relAdd','inspNewSub','dangerArchive','dangerDelete','inspExecutor','notifyPanel','npClose','rvStrip','rvWin','rvCollapse','rulePanel','rulePanelFold','cmpPanel','cmpHead','cmpCount','cmpBody','cmpList','selfCheck','toastContainer','sampleWrap','sampleToggle','sampleBody'];
function runSelfCheck(){
  var missing=JS_IDS.filter(function(id){return !$(id);});
  var el=$('selfCheck');
  window.__ID_AUDIT__={referenced:JS_IDS.length,missing:missing};
  if(el){
    if(missing.length){el.textContent='id差集:'+missing.length;el.className='self-check bad';el.title='缺失: '+missing.join(', ');}
    else{el.textContent='id差集:0';el.className='self-check';el.title='JS 引用 '+JS_IDS.length+' 项全部命中 DOM';}
  }
}

/* ---------- 主题切换 ---------- */
on('themeToggleBtn','click',function(){
  var h=document.documentElement;
  var toLight=h.getAttribute('data-theme')!=='light';
  if(toLight){h.setAttribute('data-theme','light');}else{h.removeAttribute('data-theme');}
  var b=$('themeToggleBtn');
  if(b){b.textContent=toLight?'☀':'☾';b.title=toLight?'切回深色主题':'切换深浅主题';}
});

/* ---------- 左栏收展 ---------- */
on('navDrawerBtn','click',function(){document.body.classList.toggle('nav-collapsed');});

/* ---------- 导航树：搜索 / 折叠 / 当前卡 / 面包屑 ---------- */
var navTree=$('navTree');
var rows=navTree?Array.prototype.slice.call(navTree.querySelectorAll('.nav-row')):[];
function hasKids(i){return i+1<rows.length && +rows[i+1].dataset.depth>+rows[i].dataset.depth;}
function markHit(text,q){
  var idx=text.toLowerCase().indexOf(q.toLowerCase());
  if(idx<0)return esc(text);
  return esc(text.slice(0,idx))+'<mark>'+esc(text.slice(idx,idx+q.length))+'</mark>'+esc(text.slice(idx+q.length));
}
function refreshTree(){
  var input=$('navSearchInput');
  var q=input?input.value.trim().toLowerCase():'';
  var match=rows.map(function(r){return !q||r.dataset.name.toLowerCase().indexOf(q)>=0;});
  var show=match.slice();
  /* 命中项的上层全部显示 */
  for(var i=rows.length-1;i>=0;i--){
    if(show[i]){
      var d=+rows[i].dataset.depth;
      for(var j=i-1;j>=0;j--){
        if(+rows[j].dataset.depth<d){show[j]=true;d=+rows[j].dataset.depth;if(!d)break;}
      }
    }
  }
  var collapsed=[];
  rows.forEach(function(r,i){
    var d=+r.dataset.depth;
    collapsed=collapsed.filter(function(c){return c<d;});
    var vis=show[i]&&collapsed.length===0;
    r.style.display=vis?'':'none';
    r.classList.toggle('leaf',!hasKids(i));
    if(hasKids(i)){r.classList.toggle('open',r.dataset.open!=='0');}
    var nameEl=r.querySelector('.nav-name');
    if(nameEl){
      if(q&&match[i]){nameEl.innerHTML=markHit(r.dataset.name,q);}
      else{nameEl.textContent=r.dataset.name;}
    }
    /* 搜索时忽略折叠，保证命中可见 */
    if(!q&&hasKids(i)&&r.dataset.open==='0'){collapsed.push(d);}
  });
  var box=$('navSearchBox');
  if(box){box.classList.toggle('has-text',!!q);}
  var visible=rows.filter(function(r){return r.style.display!=='none';}).length;
  window.__TREE_STATE__={query:q,visible:visible,total:rows.length};
}
on('navSearchInput','input',refreshTree);
on('navSearchClear','click',function(){var i=$('navSearchInput');if(i){i.value='';}refreshTree();if(i){i.focus();}});

if(navTree){
  navTree.addEventListener('click',function(e){
    var row=e.target.closest('.nav-row');
    if(!row)return;
    var idx=rows.indexOf(row);
    if(e.target.closest('.nav-chev')&&hasKids(idx)){
      row.dataset.open=(row.dataset.open==='0')?'1':'0';
      refreshTree();
      return;
    }
    if(e.target.closest('.nav-more')||e.target.closest('.nav-plus')||e.target.closest('.nav-tail')){return;}
    if(row.dataset.kind==='project'){toast('示意：返回项目画布 prototype-canvas-page-v3.html');return;}
    switchCard(row);
  });
}
function switchCard(row){
  rows.forEach(function(r){r.classList.remove('current');});
  row.classList.add('current');
  buildCrumb(row);
  updateInspHeader(row);
}
function buildCrumb(row){
  var crumb=$('chatCrumb');
  if(!crumb)return;
  var idx=rows.indexOf(row);
  var chain=[row];
  var d=+row.dataset.depth;
  for(var i=idx-1;i>=0;i--){
    if(+rows[i].dataset.depth<d){chain.unshift(rows[i]);d=+rows[i].dataset.depth;if(!d)break;}
  }
  crumb.innerHTML='';
  chain.forEach(function(r,ci){
    if(ci>0){var sep=document.createElement('span');sep.className='csep';sep.textContent='›';crumb.appendChild(sep);}
    var last=(ci===chain.length-1);
    var seg=document.createElement(last?'span':'button');
    seg.className='crumb-seg'+(last?' cur':'');
    seg.textContent=r.dataset.name;
    seg.title=r.dataset.name+(r.dataset.cid?'（'+r.dataset.cid+'）':'');
    if(!last){
      seg.addEventListener('click',function(){
        if(r.dataset.kind==='project'){toast('示意：返回项目画布 prototype-canvas-page-v3.html');return;}
        switchCard(r);
      });
    }
    crumb.appendChild(seg);
  });
}
var ST_MAP={running:['st-running','运行中'],completed:['st-completed','已完成'],paused:['st-paused','已暂停'],blocked:['st-blocked','受阻'],archived:['st-archived','已归档']};
function updateInspHeader(row){
  var n=$('inspName');if(n)n.textContent=row.dataset.name;
  var c=$('inspCardId');if(c)c.textContent=row.dataset.cid||'（示意卡）';
  var chip=$('inspStatusChip');var w=$('inspStatusWord');
  var st=ST_MAP[row.dataset.status]||ST_MAP.paused;
  if(chip)chip.className='st-chip '+st[0];
  if(w)w.textContent=st[1];
