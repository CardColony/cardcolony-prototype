/* ---------- 对话流：发送 / 停止 / 排队 ---------- */
var flowInput=$('flowInput'),flowSendBtn=$('flowSendBtn'),flowTurnStatus=$('flowTurnStatus');
var running=false,runTimer=null,lastSent='',queue=[];
var chatArea=$('chatArea'),flowScroll=$('flowScroll');
function scrollBottom(smooth){if(flowScroll){flowScroll.scrollTo({top:flowScroll.scrollHeight,behavior:smooth?'smooth':'auto'});}}
function appendUser(text){
  var d=document.createElement('div');d.className='msg msg-user';
  var b=document.createElement('div');b.className='msg-bubble';b.textContent=text;
  d.appendChild(b);chatArea.appendChild(d);scrollBottom(true);
}
function appendAI(text){
  var d=document.createElement('div');d.className='msg msg-ai';
  d.innerHTML='<span class="avatar ai">A</span><div class="msg-body"><div class="msg-meta">助手 · card_454</div><div class="msg-bubble"></div></div>';
  d.querySelector('.msg-bubble').textContent=text;
  chatArea.appendChild(d);scrollBottom(true);
}
function setRunUI(onRun){
  running=onRun;
  if(flowSendBtn){
    flowSendBtn.classList.toggle('stop',onRun);
    flowSendBtn.textContent=onRun?'停止 ■':'发送 ↑';
    flowSendBtn.title=onRun?'停止':'发送';
  }
  if(flowTurnStatus)flowTurnStatus.hidden=!onRun;
  window.__RUN_STATE__=onRun;
}
function startRun(){
  setRunUI(true);
  runTimer=setTimeout(function(){
    appendAI('（示意回复）已收到：「'+lastSent+'」——本图为高保真原型，此回复为占位示意。');
    setRunUI(false);
    if(queue.length){
      var nxt=queue.shift();renderQueue();
      setTimeout(function(){lastSent=nxt;appendUser(nxt);startRun();},350);
    }
  },1600);
}
function stopRun(){
  if(runTimer){clearTimeout(runTimer);runTimer=null;}
  setRunUI(false);
  toast('已停止（示意）','warn');
}
function enqueue(text){queue.push(text);renderQueue();toast('已排队：当前回合结束后送达');}
function renderQueue(){
  var bar=$('queueBar'),cnt=$('queueCount'),list=$('queueList');
  if(!bar||!list)return;
  bar.hidden=queue.length===0;
  if(cnt)cnt.textContent=String(queue.length);
  list.innerHTML='';
  queue.forEach(function(t,i){
    var chip=document.createElement('span');chip.className='qb-chip';
    var s=t.length>18?t.slice(0,18)+'…':t;
    chip.innerHTML=esc(s)+' <button class="qb-x" data-i="'+i+'" title="移除">×</button>';
    list.appendChild(chip);
  });
  window.__QUEUE_STATE__=queue.slice();
}
function doSend(){
  var t=flowInput?flowInput.value.trim():'';
  if(!t){if(flowInput)flowInput.focus();return;}
  if(running){enqueue(t);if(flowInput)flowInput.value='';return;}
  if(flowInput)flowInput.value='';
  lastSent=t;appendUser(t);startRun();
}
if(flowSendBtn){flowSendBtn.addEventListener('click',function(){if(running){stopRun();}else{doSend();}});}
if(flowInput){
  flowInput.addEventListener('keydown',function(e){
    if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();doSend();}
  });
  flowInput.addEventListener('input',function(){flowInput.style.height='auto';flowInput.style.height=Math.min(flowInput.scrollHeight,160)+'px';});
}
var queueList=$('queueList');
if(queueList){queueList.addEventListener('click',function(e){var x=e.target.closest('.qb-x');if(!x)return;queue.splice(+x.dataset.i,1);renderQueue();});}
on('queueClear','click',function(){queue=[];renderQueue();});

