<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>高保真原型 · 对话页 v1 · card_454</title>
<style>
/* 对话页高保真原型 v1 · 单文件零外链 · file:// 直开
   令牌同源 ui.css（body.page-chat 作用域）· 左栏 272px / 顶栏 52px 按盘上实测
   深浅两主题切 html[data-theme] */
:root{
  --ui-bg:#0b0d11;--ui-surface-1:#101318;--ui-surface-2:#151920;--ui-surface-3:#1b2028;--ui-surface-4:#222833;
  --ui-line:rgba(255,255,255,.07);--ui-line-2:rgba(255,255,255,.12);--ui-line-3:rgba(255,255,255,.18);--ui-line-input:#5f6670;
  --ui-text:#e9ecf1;--ui-text-2:#aab1bc;--ui-text-3:#949ba6;--ui-text-4:#6f7681;
  --ui-accent:#7d88ee;--ui-accent-hi:#909af5;--ui-accent-lo:rgba(125,136,238,.14);--ui-accent-line:rgba(125,136,238,.32);--ui-accent-ink:#0b0d11;
  --ui-ok:#4ec98a;--ui-warn:#e0a63c;--ui-err:#f0685f;
  --ui-r-xs:6px;--ui-r-sm:8px;--ui-r-md:12px;--ui-r-lg:16px;--ui-r-xl:20px;--ui-r-pill:999px;
  --ui-s1:4px;--ui-s2:8px;--ui-s3:12px;--ui-s4:16px;--ui-s5:24px;--ui-s6:32px;--ui-s7:48px;
  --ui-ease:cubic-bezier(.22,.61,.36,1);--ui-fast:120ms;--ui-mid:180ms;
  --ui-font:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  --ui-mono:ui-monospace,SFMono-Regular,Consolas,Menlo,monospace;
  --ui-col:960px;--ui-col-pad:28px;
  --nav-w:272px;--topbar-h:52px;--rule-w:300px;--rule-rail:34px;--rv-w:340px;
}
html[data-theme="light"] body.page-chat{
  --ui-bg:#fbfbfc;--ui-surface-1:#fff;--ui-surface-2:#f7f8fa;--ui-surface-3:#eef0f4;--ui-surface-4:#e4e7ed;
  --ui-line:rgba(16,19,24,.08);--ui-line-2:rgba(16,19,24,.13);--ui-line-3:rgba(16,19,24,.2);--ui-line-input:#8a9099;
  --ui-text:#14171c;--ui-text-2:#4d545e;--ui-text-3:#666d78;--ui-text-4:#8b929c;
  --ui-accent:#5560d8;--ui-accent-hi:#4550c9;--ui-accent-lo:rgba(85,96,216,.10);--ui-accent-line:rgba(85,96,216,.30);--ui-accent-ink:#fff;
  --ui-ok:#17925c;--ui-warn:#a9721a;--ui-err:#cf3f36;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body.page-chat{font-family:var(--ui-font);font-size:13px;line-height:1.55;background:var(--ui-bg);color:var(--ui-text);overflow:hidden}
button{font-family:inherit;font-size:inherit;color:inherit;background:none;border:none;cursor:pointer}
input,textarea,select{font-family:inherit;font-size:inherit;color:inherit}
[hidden]{display:none!important}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-thumb{background:var(--ui-line-3);border-radius:3px}
::-webkit-scrollbar-track{background:transparent}
:focus-visible{outline:2px solid var(--ui-accent);outline-offset:1px;border-radius:2px}
svg{display:block}
.work-page{display:flex;height:100vh}
.app-main{flex:1;min-width:0;display:flex;flex-direction:column}
.workspace{flex:1;min-height:0;display:flex;position:relative}

/* ============ 左栏 272px 恒展开（ui.css body.page-chat .app-nav 实测） ============ */
#appNav{width:var(--nav-w);flex:none;background:var(--ui-surface-1);border-right:1px solid var(--ui-line);display:flex;flex-direction:column;position:relative;transition:margin-left var(--ui-mid) var(--ui-ease)}
body.nav-collapsed #appNav{margin-left:calc(-1 * var(--nav-w))}
#navActions{position:absolute;top:12px;right:10px;display:flex;gap:6px;z-index:3}
.nav-icon-btn{width:28px;height:28px;border-radius:var(--ui-r-sm);display:flex;align-items:center;justify-content:center;color:var(--ui-text-2);position:relative}
.nav-icon-btn:hover{background:var(--ui-surface-3);color:var(--ui-text)}
.np-badge{position:absolute;top:-3px;right:-3px;min-width:15px;height:15px;padding:0 4px;border-radius:var(--ui-r-pill);background:var(--ui-err);color:#fff;font-size:10px;line-height:15px;text-align:center;font-weight:600}
#navNewProject{margin:12px 10px 0;height:32px;border-radius:var(--ui-r-sm);border:1px dashed var(--ui-line-3);color:var(--ui-text-2);display:flex;align-items:center;gap:6px;padding:0 10px;width:calc(100% - 20px)}
#navNewProject:hover{color:var(--ui-accent);border-color:var(--ui-accent-line);background:var(--ui-accent-lo)}
.nav-top{padding:52px 10px 8px}
.nav-search-box{display:flex;align-items:center;gap:6px;background:var(--ui-surface-2);border:1px solid var(--ui-line-2);border-radius:var(--ui-r-sm);padding:0 8px;height:30px}
.nav-search-box:focus-within{border-color:var(--ui-accent-line)}
.nav-search-box svg{color:var(--ui-text-3);flex:none}
#navSearchInput{flex:1;min-width:0;background:none;border:none;outline:none;color:var(--ui-text)}
#navSearchInput::placeholder{color:var(--ui-text-4)}
#navSearchClear{width:18px;height:18px;border-radius:50%;color:var(--ui-text-3);display:none;align-items:center;justify-content:center;font-size:12px;flex:none}
.nav-search-box.has-text #navSearchClear{display:flex}
#navSearchClear:hover{background:var(--ui-surface-4);color:var(--ui-text)}
#navTree{flex:1;overflow-y:auto;overflow-x:hidden;padding:4px 6px 12px}
.nav-row{position:relative;display:flex;align-items:center;gap:6px;height:30px;padding-right:6px;border-radius:var(--ui-r-xs);color:var(--ui-text-2);cursor:pointer;user-select:none}
.nav-row:hover{background:var(--ui-surface-2);color:var(--ui-text)}
/* 树线：按深度叠垂直引导线 */
.nav-row.d1{padding-left:26px;background-image:linear-gradient(var(--ui-line-2),var(--ui-line-2));background-size:1px 100%;background-position:16px 0;background-repeat:no-repeat}
.nav-row.d2{padding-left:44px;background-image:linear-gradient(var(--ui-line-2),var(--ui-line-2)),linear-gradient(var(--ui-line-2),var(--ui-line-2));background-size:1px 100%,1px 100%;background-position:16px 0,34px 0;background-repeat:no-repeat}
.nav-row.d3{padding-left:62px;background-image:linear-gradient(var(--ui-line-2),var(--ui-line-2)),linear-gradient(var(--ui-line-2),var(--ui-line-2)),linear-gradient(var(--ui-line-2),var(--ui-line-2));background-size:1px 100%,1px 100%,1px 100%;background-position:16px 0,34px 0,52px 0;background-repeat:no-repeat}
.nav-chev{width:24px;height:24px;flex:none;display:flex;align-items:center;justify-content:center;color:var(--ui-text-3);border-radius:4px;margin-left:-4px}
.nav-chev svg{transition:transform var(--ui-fast) var(--ui-ease)}
.nav-row.leaf .nav-chev{visibility:hidden}
.nav-row:not(.open) > .nav-chev svg{transform:rotate(-90deg)}
.nav-chev:hover{color:var(--ui-text);background:var(--ui-surface-3)}
.nav-ico{flex:none;color:var(--ui-text-3);position:relative;z-index:1}
.nav-name{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-name mark{background:#3d3413;color:#ffe9a8;border-radius:2px;padding:0 1px}
html[data-theme="light"] .nav-name mark{background:#fff1bf;color:#6b5200}
.nav-row.archived{opacity:.55}
.nav-phead{height:36px;margin-top:8px;background:var(--ui-surface-2);border-radius:var(--ui-r-sm);padding-left:8px;color:var(--ui-text);font-weight:600}
.nav-phead:hover{background:var(--ui-surface-3)}
.nav-phead::before{content:'';position:absolute;left:6px;right:6px;top:-4px;height:1px;background:var(--ui-line-2)}
.nav-card.current{background:var(--ui-accent-lo);color:var(--ui-text);box-shadow:inset 0 0 0 1px var(--ui-accent-line)}
.nav-card.current::before{content:'';position:absolute;left:2px;top:5px;bottom:5px;width:3px;border-radius:2px;background:var(--ui-accent)}
.nav-card.current .nav-ico{color:var(--ui-accent)}
.bdg{flex:none;font-size:10px;line-height:16px;padding:0 5px;border-radius:4px;font-weight:600}
.bdg-worker{color:#e8a35c;background:rgba(232,163,92,.14)}
.bdg-ui{color:#54b8c4;background:rgba(84,184,196,.14)}
.bdg-qa{color:#5cbb8a;background:rgba(92,187,138,.14)}
.bdg-pm{color:#d978a0;background:rgba(217,120,160,.14)}
.bdg-role{color:#d0b25c;background:rgba(208,178,92,.14)}
.bdg-rv{color:var(--ui-accent);background:var(--ui-accent-lo)}
.bdg-arch{color:var(--ui-text-3);background:var(--ui-surface-4)}
.nav-tail{display:flex;align-items:center;gap:2px;opacity:0;transition:opacity var(--ui-fast)}
.nav-row:hover .nav-tail{opacity:1}
.nav-time{font-size:11px;color:var(--ui-text-4);white-space:nowrap}
.nav-more,.nav-plus{width:20px;height:20px;border-radius:4px;color:var(--ui-text-3);display:flex;align-items:center;justify-content:center;font-size:13px}
.nav-more:hover,.nav-plus:hover{background:var(--ui-surface-4);color:var(--ui-text)}
.nav-rvrow .rv-score{font-size:11px;color:var(--ui-text-3);font-family:var(--ui-mono)}
.nav-frow{height:32px;color:var(--ui-text-2)}
.nav-frow .frow-duty{font-size:11px;color:var(--ui-text-4)}
.nav-footer{flex:none;border-top:1px solid var(--ui-line);padding:8px 10px}
#navSettingsBtn{width:100%;height:32px;border-radius:var(--ui-r-sm);display:flex;align-items:center;gap:8px;padding:0 8px;color:var(--ui-text-2)}
#navSettingsBtn:hover{background:var(--ui-surface-2);color:var(--ui-text)}

/* ============ 顶栏 52px（ui.css body.page-chat .topbar 实测） ============ */
.topbar{height:var(--topbar-h);flex:none;display:flex;align-items:center;gap:6px;padding:0 12px;background:var(--ui-surface-1);border-bottom:1px solid var(--ui-line)}
.tb-btn{width:30px;height:30px;border-radius:var(--ui-r-sm);display:flex;align-items:center;justify-content:center;color:var(--ui-text-2)}
.tb-btn:hover{background:var(--ui-surface-3);color:var(--ui-text)}
.tb-btn.on{background:var(--ui-accent-lo);color:var(--ui-accent)}
.tb-sep{width:1px;height:18px;background:var(--ui-line-2);margin:0 4px}
#chatCrumb{display:flex;align-items:center;gap:2px;min-width:0;flex:1;overflow:hidden}
.crumb-seg{padding:3px 6px;border-radius:var(--ui-r-xs);color:var(--ui-text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px}
button.crumb-seg:hover{background:var(--ui-surface-3);color:var(--ui-text)}
.crumb-seg.cur{color:var(--ui-text);font-weight:600;cursor:default}
.csep{color:var(--ui-text-4);flex:none}

/* ============ 中区对话 ============ */
.flow-view{flex:1;min-width:0;display:flex;flex-direction:column;position:relative;transition:margin-right var(--ui-mid) var(--ui-ease)}
.workspace.rv-open .flow-view{margin-right:calc(var(--rv-w) + var(--rule-rail))}
.workspace.rv-open.with-rule .flow-view{margin-right:calc(var(--rv-w) + var(--rule-w))}
.flow-view-scroll{flex:1;overflow-y:auto;padding:0 var(--ui-col-pad) 28px}
.flow-view-column{max-width:var(--ui-col);margin:0 auto;display:flex;flex-direction:column;gap:14px;padding-top:18px}
.flow-view-older{align-self:center;padding:5px 14px;border-radius:var(--ui-r-pill);border:1px solid var(--ui-line-2);color:var(--ui-text-3);background:var(--ui-surface-1)}
.flow-view-older:hover:not(:disabled){color:var(--ui-text);border-color:var(--ui-line-3);background:var(--ui-surface-2)}
.flow-view-older:disabled{opacity:.5;cursor:default}
.date-sep{display:flex;align-items:center;gap:12px;color:var(--ui-text-4);font-size:11px}
.date-sep::before,.date-sep::after{content:'';flex:1;height:1px;background:var(--ui-line)}
.msg{display:flex;gap:10px;max-width:100%}
.msg-user{justify-content:flex-end}
.msg-user .msg-bubble{max-width:78%;background:var(--ui-accent-lo);border:1px solid var(--ui-accent-line);border-radius:var(--ui-r-md);padding:8px 12px;white-space:pre-wrap;word-break:break-word}
.avatar{flex:none;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;background:var(--ui-surface-3);color:var(--ui-text-2)}
.avatar.ai{background:var(--ui-accent-lo);color:var(--ui-accent);border:1px solid var(--ui-accent-line)}
.msg-ai .msg-body{max-width:78%}
.msg-meta{font-size:11px;color:var(--ui-text-4);margin-bottom:3px}
.msg-ai .msg-bubble{background:var(--ui-surface-2);border:1px solid var(--ui-line);border-radius:var(--ui-r-md);padding:8px 12px;white-space:pre-wrap;word-break:break-word}
.msg-card{background:var(--ui-surface-2);border:1px solid var(--ui-line-2);border-left:3px solid var(--ui-accent);border-radius:var(--ui-r-sm);padding:8px 12px}
.cm-head{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.cm-route{font-size:11px;color:var(--ui-accent);font-weight:600}
.cm-time{font-size:11px;color:var(--ui-text-4);margin-left:auto}
.cm-text{color:var(--ui-text-2)}
.msg-proc{border:1px dashed var(--ui-line-2);border-radius:var(--ui-r-sm);overflow:hidden}
.proc-head{width:100%;display:flex;align-items:center;gap:8px;padding:6px 10px;color:var(--ui-text-3);font-family:var(--ui-mono);font-size:12px;text-align:left}
.proc-head:hover{background:var(--ui-surface-2);color:var(--ui-text-2)}
.proc-chev{margin-left:auto;transition:transform var(--ui-fast)}
.msg-proc.open .proc-chev{transform:rotate(90deg)}
.proc-detail{padding:6px 12px 8px 26px;font-family:var(--ui-mono);font-size:11px;color:var(--ui-text-4);border-top:1px dashed var(--ui-line-2);white-space:pre-wrap}
.sysbar{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ui-text-3);padding:5px 10px;border-radius:var(--ui-r-sm);background:var(--ui-surface-2);border:1px solid var(--ui-line)}
.sysbar .sb-ico{flex:none;font-weight:700}
.sb-new .sb-ico{color:var(--ui-ok)}
.sb-tool .sb-ico{color:var(--ui-text-3)}
.sb-op .sb-ico{color:var(--ui-warn)}
.sb-err{border-color:rgba(240,104,95,.3);background:rgba(240,104,95,.08)}
.sb-err .sb-ico,.sb-err{color:var(--ui-err)}
.sb-time{margin-left:auto;font-size:11px;color:var(--ui-text-4)}
.sysbar b{color:var(--ui-text-2);font-weight:600}
body.proc-hidden .msg-proc{display:none}
.chat-skeleton{display:flex;flex-direction:column;gap:16px;padding:8px 0}
.sk-row{display:flex;gap:10px}
.sk-ava{flex:none;width:26px;height:26px;border-radius:50%;background:linear-gradient(90deg,var(--ui-surface-2),var(--ui-surface-4),var(--ui-surface-2));background-size:200% 100%;animation:sk 1.2s infinite}
.sk-lines{flex:1;display:flex;flex-direction:column;gap:8px;padding-top:3px}
.sk-line{height:12px;border-radius:6px;background:linear-gradient(90deg,var(--ui-surface-2),var(--ui-surface-4),var(--ui-surface-2));background-size:200% 100%;animation:sk 1.2s infinite}
.w40{width:40%}.w60{width:60%}.w90{width:90%}
@keyframes sk{0%{background-position:200% 0}100%{background-position:-200% 0}}
.chat-empty{display:flex;flex-direction:column;align-items:center;gap:8px;padding:36px 16px;border:1px dashed var(--ui-line-2);border-radius:var(--ui-r-lg);color:var(--ui-text-3)}
.ce-ico{font-size:26px;color:var(--ui-text-4)}
.ce-title{font-size:14px;color:var(--ui-text-2);font-weight:600}
.ce-sub{font-size:12px}
.ce-sugg{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:6px}
.sugg{padding:5px 12px;border-radius:var(--ui-r-pill);border:1px solid var(--ui-line-2);color:var(--ui-text-2);background:var(--ui-surface-1)}
.sugg:hover{border-color:var(--ui-accent-line);color:var(--ui-accent);background:var(--ui-accent-lo)}
.flow-turn-status{display:flex;align-items:center;gap:8px;padding:6px 12px;border-radius:var(--ui-r-pill);background:var(--ui-surface-2);border:1px solid var(--ui-line-2);color:var(--ui-text-2);font-size:12px;align-self:flex-start}
.fts-dot{width:8px;height:8px;border-radius:50%;background:var(--ui-accent);animation:pulse 1.1s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.fts-dots i{display:inline-block;width:3px;height:3px;border-radius:50%;background:var(--ui-text-3);margin-right:3px;animation:pulse 1s infinite}
.fts-dots i:nth-child(2){animation-delay:.15s}
.fts-dots i:nth-child(3){animation-delay:.3s}
.flow-view-to-bottom{position:absolute;right:calc(var(--ui-col-pad) + 4px);bottom:14px;padding:6px 12px;border-radius:var(--ui-r-pill);background:var(--ui-surface-3);border:1px solid var(--ui-line-2);color:var(--ui-text-2);box-shadow:0 4px 14px rgba(0,0,0,.25);z-index:6}
.flow-view-to-bottom:hover{color:var(--ui-text);background:var(--ui-surface-4)}
.sample-wrap{border:1px dashed var(--ui-line-2);border-radius:var(--ui-r-sm);overflow:hidden}
.sample-toggle{width:100%;display:flex;align-items:center;gap:8px;padding:6px 10px;color:var(--ui-text-4);font-size:12px;text-align:left}
.sample-toggle:hover{background:var(--ui-surface-2);color:var(--ui-text-3)}
.sample-body{padding:14px;border-top:1px dashed var(--ui-line-2);display:flex;flex-direction:column;gap:18px;background:var(--ui-surface-1)}
.sample-label{font-size:11px;color:var(--ui-text-4);font-family:var(--ui-mono);margin-bottom:6px}

/* ============ 输入区 ============ */
#composerSeat{flex:none;position:relative;padding:8px var(--ui-col-pad) 16px}
.composer-stack{max-width:var(--ui-col);margin:0 auto}
.queue-bar{display:flex;align-items:center;gap:8px;padding:6px 10px;margin-bottom:8px;border-radius:var(--ui-r-sm);background:var(--ui-accent-lo);border:1px solid var(--ui-accent-line);color:var(--ui-text-2);font-size:12px;flex-wrap:wrap}
.qb-label b{color:var(--ui-accent)}
.qb-list{display:flex;gap:6px;flex-wrap:wrap;flex:1;min-width:0}
.qb-chip{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:var(--ui-r-pill);background:var(--ui-surface-2);border:1px solid var(--ui-line-2);max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qb-x{color:var(--ui-text-3);font-size:12px;padding:0 2px}
.qb-x:hover{color:var(--ui-err)}
.qb-clear{color:var(--ui-text-3);padding:2px 8px;border-radius:var(--ui-r-xs)}
.qb-clear:hover{background:var(--ui-surface-3);color:var(--ui-err)}
.composer-card{background:var(--ui-surface-2);border:1px solid var(--ui-line-2);border-radius:var(--ui-r-lg);padding:10px 12px 8px;box-shadow:0 6px 20px rgba(0,0,0,.18)}
.composer-card:focus-within{border-color:var(--ui-accent-line)}
#flowInput{width:100%;min-height:40px;max-height:160px;resize:none;background:none;border:none;outline:none;color:var(--ui-text);line-height:1.5}
#flowInput::placeholder{color:var(--ui-text-4)}
.composer-bar{display:flex;align-items:center;gap:8px;margin-top:6px}
.spacer{flex:1}
.model-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:var(--ui-r-pill);border:1px solid var(--ui-line-2);color:var(--ui-text-2);font-size:12px}
.model-badge:hover{border-color:var(--ui-accent-line);color:var(--ui-text)}
.model-badge .mb-dot{width:7px;height:7px;border-radius:50%;background:var(--ui-accent)}
.ghost-btn{padding:5px 12px;border-radius:var(--ui-r-sm);border:1px solid var(--ui-line-2);color:var(--ui-text-2);font-size:12px}
.ghost-btn:hover{border-color:var(--ui-line-3);color:var(--ui-text);background:var(--ui-surface-3)}
.ghost-btn.on{background:var(--ui-accent-lo);border-color:var(--ui-accent-line);color:var(--ui-accent)}
.send-btn{min-width:76px;padding:6px 16px;border-radius:var(--ui-r-sm);background:var(--ui-accent);color:var(--ui-accent-ink);font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:6px}
.send-btn:hover{background:var(--ui-accent-hi)}
