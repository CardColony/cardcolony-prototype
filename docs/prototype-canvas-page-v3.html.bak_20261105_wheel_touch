<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>画布页 · 交互原型 v3</title>
<style>
:root{
  --bg:#161616; --surface:#1e1e1e; --surface2:#252525; --surface3:#2c2c2c;
  --line:#343434; --line2:#4a4a4a; --line3:#5e5e5e;
  --text:#e6e6e6; --text2:#a8a8a8; --text3:#7c7c7c;
  --accent:#5b9bff; --accent2:#3d82f0; --accent-weak:rgba(91,155,255,.12);
  --run:#5b9bff; --done:#5fbf80; --wait:#d8a94a; --blocked:#e8786c; --arch:#7c7c7c;
  --shadow:0 1px 2px rgba(0,0,0,.5); --shadow2:0 6px 18px rgba(0,0,0,.45);
  --mono:ui-monospace,SFMono-Regular,Consolas,monospace;
}
html[data-theme="light"]{
  --bg:#efefef; --surface:#ffffff; --surface2:#f6f6f6; --surface3:#eaeaea;
  --line:#d6d6d6; --line2:#b9b9b9; --line3:#a0a0a0;
  --text:#1b1b1b; --text2:#5a5a5a; --text3:#8c8c8c;
  --accent:#1f5fd1; --accent2:#1a4faf; --accent-weak:rgba(31,95,209,.10);
  --run:#1f5fd1; --done:#1d6b3c; --wait:#8a5a00; --blocked:#a3231e; --arch:#8c8c8c;
  --shadow:0 1px 2px rgba(0,0,0,.06); --shadow2:0 4px 14px rgba(0,0,0,.10);
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden}
body{font:13px/1.5 system-ui,"Segoe UI","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);
  -webkit-font-smoothing:antialiased;transition:background .2s,color .2s}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
input{font:inherit;color:inherit}
::selection{background:var(--accent-weak)}
.btn{height:24px;padding:0 8px;border:1px solid var(--line2);border-radius:5px;background:var(--surface2);
  color:var(--text2);display:inline-flex;align-items:center;gap:4px;font-size:12px;
  transition:background .12s,border-color .12s,color .12s;white-space:nowrap}
.btn:hover{background:var(--surface3);border-color:var(--line3);color:var(--text)}
.btn:active{background:var(--accent-weak);border-color:var(--accent);transform:translateY(.5px)}
.btn[disabled],.btn.is-disabled{opacity:.42;cursor:not-allowed;pointer-events:none}
.btn.primary{background:var(--accent2);border-color:var(--accent2);color:#fff}
.btn.primary:hover{filter:brightness(1.08);color:#fff}
.btn.ghost{border-color:transparent;background:transparent}
.btn.ghost:hover{background:var(--surface3);border-color:transparent}
.icon{width:24px;height:24px;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;
  color:var(--text2);transition:background .12s,color .12s}
.icon:hover{background:var(--surface3);color:var(--text)}
.icon:active{transform:scale(.94)}
.icon.on{background:var(--accent-weak);color:var(--accent)}
.field{height:24px;border:1px solid var(--line2);border-radius:5px;background:var(--surface);
  padding:0 7px;color:var(--text);font-size:12px;outline:none;transition:border-color .12s,box-shadow .12s;width:100%}
.field::placeholder{color:var(--text3)}
.field:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-weak)}
.kbd{font:11px/1 var(--mono);padding:2px 4px;border:1px solid var(--line2);border-radius:3px;color:var(--text3);background:var(--surface3)}
.work-page{display:flex;height:100vh;width:100vw;position:relative}
.rail{width:44px;flex:0 0 44px;background:var(--surface);border-right:1px solid var(--line);
  position:relative;z-index:35}
.rail-inner{position:absolute;left:0;top:0;width:260px;height:100%;background:var(--surface);
  border-right:1px solid var(--line);transform:translateX(-216px);transition:transform .18s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column}
.rail:hover .rail-inner{transform:translateX(0);box-shadow:var(--shadow)}
.rail-icons{width:44px;padding:8px 0;display:flex;flex-direction:column;align-items:center;gap:2px;flex:0 0 44px}
.rail-logo{width:28px;height:28px;border-radius:4px;background:var(--accent2);color:#fff;
  display:grid;place-items:center;font-weight:700;font-size:12px;margin-bottom:6px}
.rail-btn{width:32px;height:32px;border-radius:4px;display:grid;place-items:center;color:var(--text3);font-size:14px}
.rail-btn:hover{background:var(--surface3);color:var(--text)}
.rail-btn.on{background:var(--accent-weak);color:var(--accent)}
.rail-body{flex:1;min-width:0;padding:10px 0;overflow:auto;opacity:0;transition:opacity .12s}
.rail:hover .rail-body{opacity:1;transition-delay:.06s}
.rail-sec{padding:6px 14px 4px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--text3)}
.tree{list-style:none;margin:0;padding:0 8px}
.tree li{margin:1px 0}
.tree-row{display:flex;align-items:center;gap:6px;height:26px;padding:0 6px;border-radius:5px;cursor:pointer;
  color:var(--text2);font-size:12.5px;white-space:nowrap;overflow:hidden}
.tree-row:hover{background:var(--surface3);color:var(--text)}
.tree-row.on{background:var(--accent-weak);color:var(--accent);font-weight:600}
.tree-row .d{width:5px;height:5px;border-radius:50%;flex:0 0 5px}
.tree-row .t{overflow:hidden;text-overflow:ellipsis}
.tree-row.child{padding-left:20px}
.main{flex:1;min-width:0;display:flex;flex-direction:column;position:relative}
.topbar{height:44px;flex:0 0 44px;display:flex;align-items:center;gap:8px;padding:0 10px;
  background:var(--surface);border-bottom:1px solid var(--line);position:relative;z-index:30}
.crumb{display:flex;align-items:center;gap:5px;font-size:12.5px;min-width:0}
.crumb .seg{color:var(--text2);cursor:pointer;padding:2px 4px;border-radius:4px;white-space:nowrap}
.crumb .seg:hover{background:var(--surface3);color:var(--text)}
.crumb .seg.cur{color:var(--text);font-weight:600}
.crumb .sep{color:var(--text3);font-size:11px}
.stat{display:flex;align-items:center;gap:9px;font-size:11.5px;color:var(--text3);
  padding:0 8px;border-left:1px solid var(--line);margin-left:2px}
.stat b{color:var(--text2);font-weight:600}
.build{font:11px var(--mono);color:var(--text3);padding:2px 6px;border:1px solid var(--line);border-radius:4px}
.tb-spacer{flex:1}
.zoomgrp{display:flex;align-items:center;gap:2px;padding:0 4px;border-left:1px solid var(--line)}
.zoomgrp .lbl{font:11px var(--mono);color:var(--text2);width:38px;text-align:center;cursor:pointer;
  padding:2px 0;border-radius:4px}
.zoomgrp .lbl:hover{background:var(--surface3);color:var(--text)}
input[type=range]{-webkit-appearance:none;appearance:none;width:84px;height:16px;background:transparent;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:3px;border-radius:2px;background:var(--line2)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;border-radius:50%;
  background:var(--accent);margin-top:-4.5px;border:2px solid var(--surface)}
.zoomgrp .sep2{width:1px;height:18px;background:var(--line);margin:0 4px}
.bellwrap{position:relative}
.badge{position:absolute;top:-2px;right:-3px;min-width:14px;height:14px;padding:0 3px;border-radius:4px;
  background:var(--blocked);color:#fff;font:10px/14px var(--mono);text-align:center;pointer-events:none}
.stage{flex:1;min-height:0;position:relative;overflow:hidden;background:var(--bg);--rp:0px}
.stage.side{--rp:300px}
.canvas{position:absolute;top:0;left:0;bottom:0;right:0;overflow:clip;cursor:default;
  transition:right .2s cubic-bezier(.4,0,.2,1)}
.stage.side .canvas{right:300px}
.canvas.panning{cursor:grabbing}
.world{position:absolute;left:0;top:0;width:2600px;height:1800px;transform-origin:0 0;will-change:transform}
#wires{position:absolute;left:0;top:0;width:2600px;height:1800px;pointer-events:none;overflow:visible}
.wire-p{stroke:var(--line3);stroke-width:1.4;fill:none}
.wire-c{stroke:var(--accent);stroke-width:1.3;fill:none;stroke-dasharray:5 4;opacity:.62}
.node{position:absolute;width:302px;min-height:132px;background:var(--surface);border:1px solid var(--line2);
  border-radius:5px;padding:0;display:flex;flex-direction:column;
  transition:border-color .12s,box-shadow .12s,background .12s,opacity .15s;user-select:none}
.node:hover{border-color:var(--line3);box-shadow:var(--shadow)}
.node.focus{border-color:var(--accent);border-width:1.5px}
.n-top{display:flex;align-items:center;gap:7px;padding:11px 14px 0}
.n-type{font-size:11.5px;letter-spacing:.03em;padding:1px 5px;border-radius:3px;background:var(--surface3);
  color:var(--text2);border:1px solid var(--line);white-space:nowrap}
.n-code{font:11px var(--mono);color:var(--text3);margin-left:auto}
.n-title{font-size:15px;font-weight:600;line-height:1.4;padding:9px 14px 0;color:var(--text);
  display:flex;align-items:flex-start;gap:5px;min-height:24px}
.n-title .t{flex:1;min-width:0;word-break:break-word}
.n-title[contenteditable="true"]{outline:none;background:var(--accent-weak);border-radius:4px;
  box-shadow:0 0 0 1px var(--accent);padding:5px 8px;margin:5px 8px 0}
.pencil{flex:0 0 auto;width:18px;height:18px;border-radius:4px;display:grid;place-items:center;
  color:var(--text3);opacity:0;transition:opacity .12s,background .12s;font-size:11px}
.node:hover .pencil{opacity:1}
.pencil:hover{background:var(--surface3);color:var(--accent)}
.n-facts{display:flex;flex-wrap:wrap;gap:0 13px;padding:10px 14px 0;font-size:12.5px;color:var(--text3)}
.n-facts span{white-space:nowrap}
.n-facts b{color:var(--text2);font-weight:600}
.n-foot{display:flex;align-items:center;gap:7px;padding:11px 14px 12px;margin-top:auto}
.n-state{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--text2);
  padding:1px 6px 1px 5px;border-radius:4px;background:var(--surface3)}
.n-state .sd{width:6px;height:6px;border-radius:50%;flex:0 0 6px;background:var(--text3)}
.n-acts{margin-left:auto;display:flex;gap:2px;opacity:0;transition:opacity .12s}
.node:hover .n-acts{opacity:1}
.n-act{width:24px;height:24px;border-radius:4px;display:grid;place-items:center;color:var(--text3);font-size:12px}
.n-act:hover{background:var(--surface3);color:var(--text)}
.n-meta{font:11.5px var(--mono);color:var(--text3);padding:0 14px 11px}
.node[data-state="run"] .sd{background:var(--run);box-shadow:0 0 0 3px rgba(91,149,245,.18)}
.node[data-state="run"] .n-state{color:var(--run)}
.node[data-state="done"] .sd{background:var(--done)}
.node[data-state="done"] .n-state{color:var(--done)}
.node[data-state="wait"] .sd{background:var(--wait)}
.node[data-state="wait"] .n-state{color:var(--wait)}
.node[data-state="blocked"] .sd{background:var(--blocked)}
.node[data-state="blocked"] .n-state{color:var(--blocked)}
.node[data-state="archived"] .sd{background:var(--arch)}
.node[data-state="archived"] .n-state{color:var(--arch)}
.node[data-state="archived"]{opacity:.55;background:var(--surface2)}
.node[data-state="archived"] .n-title .t{text-decoration:line-through;color:var(--text3)}
.archcode{font:10px var(--mono);color:var(--blocked);border:1px dashed rgba(224,101,92,.45);
  padding:0 4px;border-radius:3px;margin-left:4px;text-decoration:none!important}
.world[data-lod="near"] .n-facts,.world[data-lod="near"] .n-acts,.world[data-lod="near"] .n-meta{display:none}
.world[data-lod="far"] .n-facts,.world[data-lod="far"] .n-acts,.world[data-lod="far"] .n-meta,
.world[data-lod="far"] .n-type,.world[data-lod="far"] .n-code{display:none}
.world[data-lod="far"] .node{min-height:0;padding-bottom:4px}
.rule-panel{position:absolute;top:0;right:0;bottom:0;width:300px;background:var(--surface);
  border-left:1px solid var(--line);z-index:40;display:flex;flex-direction:column;
  transform:translateX(0);transition:transform .2s cubic-bezier(.4,0,.2,1);box-shadow:var(--shadow)}
.rule-panel.closed{transform:translateX(300px)}
.rp-tabs{display:flex;align-items:center;border-bottom:1px solid var(--line);height:36px;flex:0 0 36px;padding-right:6px}
.rp-tab{height:36px;padding:0 11px;font-size:12px;color:var(--text3);border-bottom:2px solid transparent;display:flex;align-items:center}
.rp-tab:hover{color:var(--text2)}
.rp-tab.on{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
.rp-body{flex:1;overflow:auto;padding:10px 12px}
.rp-handle{position:absolute;left:-26px;top:50%;transform:translateY(-50%);width:26px;height:64px;
  background:var(--surface);border:1px solid var(--line);border-right:0;border-radius:6px 0 0 6px;
  display:grid;place-items:center;color:var(--text3);cursor:pointer;z-index:41;font-size:13px}
.rp-handle:hover{color:var(--accent);background:var(--surface3)}
.spec-sec{margin-bottom:14px}
.spec-sec h4{margin:0 0 5px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--text3);font-weight:600}
.spec-sec p,.spec-sec li{font-size:12px;line-height:1.65;color:var(--text2);margin:0 0 3px}
.spec-sec ul{margin:0;padding-left:14px}
.spec-sec code{font:11px var(--mono);background:var(--surface3);padding:1px 4px;border-radius:3px;color:var(--text)}
.drawer{position:absolute;top:10px;bottom:10px;right:calc(var(--rp) + 10px);width:392px;
  background:var(--surface);border:1px solid var(--line2);border-radius:8px;z-index:46;
  transform:translateX(108%);opacity:0;pointer-events:none;
  transition:transform .22s cubic-bezier(.4,0,.2,1),right .2s cubic-bezier(.4,0,.2,1),opacity .16s;
  display:flex;flex-direction:column;box-shadow:var(--shadow2)}
.drawer.open{transform:translateX(0);opacity:1;pointer-events:auto}
.dr-head{height:42px;flex:0 0 42px;display:flex;align-items:center;gap:8px;padding:0 12px;border-bottom:1px solid var(--line)}
.dr-title{font-size:13px;font-weight:600}
.dr-sub{font-size:11px;color:var(--text3)}
.dr-body{flex:1;overflow:auto;padding:12px}
.dr-foot{border-top:1px solid var(--line);padding:9px 12px;display:flex;gap:6px;align-items:center}
.msg{display:flex;gap:8px;margin-bottom:12px}
.msg .av{width:22px;height:22px;border-radius:5px;background:var(--surface3);border:1px solid var(--line);
  display:grid;place-items:center;font:10px var(--mono);color:var(--text2);flex:0 0 22px}
.msg .bd{min-width:0}
.msg .hd{font-size:11px;color:var(--text3);margin-bottom:2px;display:flex;gap:6px;align-items:center}
.msg .hd b{color:var(--text2);font-weight:600}
.msg .tx{font-size:12.5px;line-height:1.6;color:var(--text);background:var(--surface2);
  border:1px solid var(--line);border-radius:4px;padding:7px 9px;white-space:pre-wrap;word-break:break-word}
.msg.mine .tx{background:var(--accent-weak);border-color:rgba(91,149,245,.3)}
.daysep{display:flex;align-items:center;gap:8px;margin:14px 0 10px;font-size:11px;color:var(--text3)}
.daysep::before,.daysep::after{content:"";flex:1;height:1px;background:var(--line)}
.cmdk{position:absolute;left:50%;top:12%;transform:translate(-50%,-8px) scale(.98);width:520px;max-width:88vw;
  background:var(--surface);border:1px solid var(--line2);border-radius:4px;box-shadow:var(--shadow2);
  z-index:70;opacity:0;pointer-events:none;transition:opacity .14s,transform .14s;overflow:hidden}
.cmdk.open{opacity:1;pointer-events:auto;transform:translate(-50%,0) scale(1)}
.cmdk-in{display:flex;align-items:center;gap:8px;padding:11px 13px;border-bottom:1px solid var(--line)}
.cmdk-in input{border:0;background:none;outline:none;flex:1;font-size:14px;color:var(--text)}
.cmdk-list{max-height:320px;overflow:auto;padding:5px}
.cmdk-item{display:flex;align-items:center;gap:9px;height:34px;padding:0 9px;border-radius:6px;cursor:pointer;font-size:12.5px}
.cmdk-item:hover,.cmdk-item.on{background:var(--accent-weak);color:var(--accent)}
.cmdk-item .k{font:10.5px var(--mono);color:var(--text3);margin-left:auto}
.cmdk-item .ic{width:16px;text-align:center;color:var(--text3)}
.cmdk-empty{padding:22px;text-align:center;font-size:12px;color:var(--text3)}
.ctx{position:absolute;min-width:186px;background:var(--surface);border:1px solid var(--line2);border-radius:4px;
  box-shadow:var(--shadow2);padding:4px;z-index:60;opacity:0;pointer-events:none;transform:scale(.97);
  transition:opacity .1s,transform .1s;transform-origin:top left}
.ctx.open{opacity:1;pointer-events:auto;transform:scale(1)}
.ctx-item{display:flex;align-items:center;gap:8px;height:28px;padding:0 8px;border-radius:5px;font-size:12.5px;color:var(--text2);cursor:pointer}
.ctx-item:hover{background:var(--surface3);color:var(--text)}
.ctx-item .k{margin-left:auto;font:10.5px var(--mono);color:var(--text3)}
.ctx-item.danger:hover{background:rgba(224,101,92,.14);color:var(--blocked)}
.ctx-sep{height:1px;background:var(--line);margin:4px 6px}
.ctx-hd{padding:5px 8px 3px;font:10.5px var(--mono);color:var(--text3)}
.modal{position:absolute;inset:0;z-index:75;display:none;place-items:center;background:rgba(8,12,18,.42)}
.modal.open{display:grid}
.modal-box{width:420px;max-width:90vw;background:var(--surface);border:1px solid var(--line2);border-radius:4px;
  box-shadow:var(--shadow2);overflow:hidden}
.modal-hd{padding:13px 15px;border-bottom:1px solid var(--line);font-size:13.5px;font-weight:600;display:flex;align-items:center}
.modal-bd{padding:14px 15px;display:flex;flex-direction:column;gap:11px}
.modal-bd label{font-size:11.5px;color:var(--text3);display:block;margin-bottom:4px}
.modal-ft{padding:11px 15px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:7px}
.toast-wrap{position:absolute;left:50%;bottom:74px;transform:translateX(-50%);z-index:80;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.toast{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line2);
  border-radius:4px;box-shadow:var(--shadow2);padding:8px 12px;font-size:12.5px;pointer-events:auto;
  animation:tin .18s cubic-bezier(.34,1.4,.64,1)}
@keyframes tin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.toast .act{color:var(--accent);font-weight:600;cursor:pointer;padding:1px 4px;border-radius:4px}
.toast .act:hover{background:var(--accent-weak)}
.toast[x-out]{animation:tout .16s forwards}
@keyframes tout{to{opacity:0;transform:translateY(6px)}}
.tip{position:fixed;z-index:85;width:288px;background:var(--surface);border:1px solid var(--line2);
  border-radius:4px;box-shadow:var(--shadow2);padding:0;opacity:0;pointer-events:none;
  transform:translateY(3px);transition:opacity .13s,transform .13s}
.tip.on{opacity:1;pointer-events:auto;transform:none}
.tip-hd{display:flex;align-items:center;gap:6px;padding:8px 10px 6px;border-bottom:1px solid var(--line);
  font:11px var(--mono);color:var(--text3)}
.tip-hd b{color:var(--text2);font-family:inherit;font-size:11.5px}
.tip-msg{padding:8px 10px;font-size:12px;line-height:1.55;color:var(--text2)}
.tip-msg .who{color:var(--accent);font:10.5px var(--mono);margin-right:5px}
.tip-msg .tm{color:var(--text3);font:10px var(--mono);margin-left:5px}
.tip-msg .more{display:block;margin-top:5px;font-size:11px;color:var(--text3)}
.tip-in{display:flex;gap:5px;padding:6px 8px;border-top:1px solid var(--line)}
.tip-in input{flex:1;height:24px;border:1px solid var(--line2);border-radius:5px;background:var(--surface2);
  padding:0 7px;font-size:12px;outline:none;color:var(--text);min-width:0}
.tip-in input:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-weak)}
.hintbar{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:47;
  display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--line2);
  border-radius:4px;box-shadow:var(--shadow);padding:6px 8px 6px 14px;font-size:11.5px;color:var(--text2);
  transition:opacity .2s,transform .2s}
.hintbar.hide{opacity:0;transform:translate(-50%,8px);pointer-events:none}
.hintbar .h{display:flex;align-items:center;gap:5px;white-space:nowrap}
.hintbar .h b{color:var(--text);font-weight:600}
.hintbar .kb{font:10px var(--mono);padding:1px 4px;border:1px solid var(--line2);border-radius:3px;
  background:var(--surface3);color:var(--text2)}
.hintbar .x{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;color:var(--text3);font-size:11px}
.hintbar .x:hover{background:var(--surface3);color:var(--text)}
