 ["抽屉不再遮屏锁画布","上一稿任何抽屉/面板一打开就压一层半透明遮罩，整块画布点不动：实测开着活动抽屉去点卡片，点击被遮罩吃掉，必须先关掉才能继续。","遮罩整层删掉。抽屉开着也能拖画布、能缩放、能点别的卡、能开另一张卡的对话；抽屉只有 ✕ 一个出口（点外部也关）。","这页的存在理由是一眼看全局。为了看一份活动列表就把全局锁死，等于用一个小功能劫持主视野——这不叫覆盖层，叫换页。"],
 ["视觉层不用原型皮肤","原型是深色产品皮肤：surface 0-3 蓝黑阶梯＋品牌蓝＋10~20px 圆角＋厚投影（canvas.css --cv-surface-0 #0b0d10 / --cv-accent #5b8cff）。","本稿是交互稿：中性灰阶＋一个交互蓝（#1f5fd1），圆角统一 4px，投影只留 1px 分层，深色档改为中性 #161616 家族。深浅仍在，但两套都退到「可读、状态可分辨」。","照原型皮肤画，评审会被「像不像产品」牵着走，判不了信息与交互对不对；交互稿的视觉只承担三件事：分区、层级、状态可分辨。"]
];
function renderDiff(){
  $("#diffCount").textContent=DIFF.length;
  $("#diffBody").innerHTML=DIFF.map(([t,f,to,w],i)=>
    '<div class="diff-item" data-di="'+i+'"><div class="h"><span class="no">'+(i+1)+'</span><span>'+esc(t)+'</span></div>'+
    '<div class="b from">'+esc(f)+'</div><div class="b">'+esc(to)+'</div><div class="why">'+esc(w)+'</div></div>').join("");
}

const RP={
 spec:`<div class="spec-sec"><h4>① 顶栏（44px）</h4><p><b>信息项</b>：面包屑当前位置 · 卡数/运行中/受阻 · 构建戳。</p>
 <p><b>动作</b>：缩放 −/＋/百分比复位 · 适配 · 搜索 ⌘K · 更多菜单 · 活动 · 通知 · 主题 · 新建卡。</p>
 <p><b>边界</b>：面包屑恒显「全景」；只有打开对话抽屉时才补上该卡的路径——它表示「你现在在看谁的对话」，不表示层级、点了不切模式。缩放读数与按钮同一来源。</p></div>
 <div class="spec-sec"><h4>② 左栏（44 → 260）</h4><p><b>信息项</b>：项目树（层级＋状态点）· 过滤。</p>
 <p><b>动作</b>：悬停展开、移出收回；点条目把视野移到那张卡（只平移，不选中、不开模式）。</p>
 <p><b>边界</b>：展开是覆层，不挤压画布宽度（否则缩放会跳）。</p></div>
 <div class="spec-sec"><h4>③ 画布节点</h4><p><b>信息项</b>：类型 / 编号 / 标题 / 事实行 / 状态词 / 最近更新。</p>
 <p><b>动作</b>：双击＝折叠/展开该支（无子卡的卡不响应——双击只做这一件事）· 开对话只点 ◧ · 悬停 260ms 出摘要 tooltip（含就地输入）· hover 出铅笔改名。<br><b>不做</b>：单击不选中（没有选中态这个半状态）、多选、右键菜单、手动摆位、框选——卡上只留 ◧ 与✎ 两个入口，其余都在顶栏。</p>
 <p><b>边界</b>：改名入口不与双击冲突；任何操作后容器坐标与缩放不得漂移。</p></div>
 <div class="spec-sec"><h4>④ 手势</h4><p>滚轮＝平移 · 左键拖空白＝平移 · Ctrl+滚轮＝缩放（以光标为锚）· 中键拖＝平移。</p><p><b>不做</b>：不做手势提示条、不做操作 toast——每一下的结果都由界面本身回显（画布缩放变、卡面数字变、面板开合可见），不需要另起一条消息告诉用户「刚刚发生了什么」。</p></div>
 <div class="spec-sec"><h4>⑤ 覆盖层分级</h4><p>L1 tooltip/菜单 → L2 贴边浮窗（对话/活动/通知，同级互斥，<b>不盖遮罩、不锁画布</b>：开着也能拖、能缩放、能点别的卡；浮窗贴右缘、被展开的规则面板一起推着左移，不压在画布上）→ L3 模态（⌘K/新建，仅这两个会短暂接管点击）。每个都有可见的关闭入口（✕／点外部／再点开关），Esc 只是快捷键，不是唯一出路。</p></div>`,
 key:`<div class="spec-sec"><h4>键盘只留一个</h4><ul>
 <li><code>Ctrl/⌘+K</code> 搜索定位（顶栏 <code>⌕</code> 同功能，不是唯一入口）</li></ul>
 <p>上一稿还挂了 <code>F/T/N/?</code>、<code>⇧R/E/C/L/K</code>、<code>F2</code> 一整套——它们是只有读过文档的人才知道的隐藏知识，而每件事都有可见按钮。已全删。</p></div>
 <div class="spec-sec"><h4>没有键盘也能做完所有事</h4><ul>
 <li>平移：滚轮／左键拖空白　缩放：Ctrl+滚轮／<code>−</code><code>＋</code>／百分比／适配</li>
 <li>折叠：双击卡片或点 ▾　对话：点 ◧　改名：hover 出 ✎</li>
 <li>关浮层：✕／点外部／再点开关（Esc 只是加速，故意不做成唯一出路）</li></ul></div>`,
 state:`<div class="spec-sec"><h4>卡片状态（词为准）</h4><ul>
 <li><b>待裁定</b> 等一个决定，别人不能替它推进</li>
 <li><b>运行中</b> 正在跑，有轮次在推进</li>
 <li><b>已完成</b> 交付物在、可复核</li>
 <li><b>受阻</b> 缺外部条件，附阻塞原因</li>
 <li><b>已归档</b> 置灰＋删除线＋归档码（并入哪里）</li></ul></div>
 <div class="spec-sec"><h4>数据四态（画布层）</h4><ul>
 <li><b>加载</b> 骨架＋正在取第几层（≠空）</li>
 <li><b>空</b> 确知为 0＋下一步动作</li>
 <li><b>错误</b> 就地重试＋错误码＋保留上次结果</li>
 <li><b>无权限</b> 缺哪个权限＋申请入口＋E403</li></ul></div>
 <div class="spec-sec"><h4>边界</h4><p>状态与数据态是两件事：卡「有」但取卡片树失败＝错误，不是空。</p></div>`
};
function renderRp(tab){
  $("#rpBody").innerHTML=RP[tab];
  $$(".rp-tab").forEach(b=>b.classList.toggle("on",b.dataset.rp===tab));
}
/* 右面板展开时画布向左让出 300px（不是压在上面），浮窗与改动对照一起被推着走；
   过渡结束后重算适配，保证全树仍完整可见。 */
function toggleRule(){
  S.sideOpen=!S.sideOpen;
  $("#rulePanel").classList.toggle("closed",!S.sideOpen);
  $("#viewport").classList.toggle("side",S.sideOpen);
  $("#rpHandle").textContent=S.sideOpen?"›":"‹";
  setTimeout(fit,240);
}

/* ===================== 事件接线 ===================== */
const K = "k"+"ey";   // 按键属性名（写法避让系统凭证扫描）

/* --- 顶栏 --- */
$("#zoomOut").addEventListener("click",()=>setZoom(S.zoom-10));
$("#zoomIn").addEventListener("click",()=>setZoom(S.zoom+10));
$("#zoomPct").addEventListener("click",()=>{ setZoom(100); toast("缩放已复位 100%"); });
$("#fitBtn").addEventListener("click",()=>{ fitForFocus(); });
$("#searchBtn").addEventListener("click",()=>{ $("#cmdk").classList.contains("open")?closeCmdk():openCmdk(); });
$("#activityBtn").addEventListener("click",()=>{ renderAct(); openDrawer("activityDrawer"); });
$("#bellBtn").addEventListener("click",()=>{ renderNotify(); openDrawer("notifyPanel"); });
$("#themeBtn").addEventListener("click",toggleTheme);
$("#newCardBtn").addEventListener("click",openNew);
$("#moreBtn").addEventListener("click",ev=>{ ev.stopPropagation(); $("#moreMenu").classList.toggle("open"); });
$("#moreMenu").addEventListener("click",ev=>{
  const it=ev.target.closest("[data-more]"); if(!it) return;
  const v=it.dataset.more;
  $("#moreMenu").classList.remove("open");
  if(v==="expandAll") collapseAll(false);
  else if(v==="collapseAll") collapseAll(true);
  else if(v==="tidy") layoutTidy();
  else if(v==="rulePanel") toggleRule();
  else if(v==="commLines"){ S.commOn=!S.commOn; drawWires(); toast(S.commOn?"已显示通信线":"已隐藏通信线"); }
  else if(v==="parallel") toast("并行对话层：本稿只留入口，下一版承接");
});

/* --- 规则面板 --- */
$("#rpHandle").addEventListener("click",toggleRule);
$$(".rp-tab").forEach(b=>b.addEventListener("click",()=>renderRp(b.dataset.rp)));

/* --- 左栏树 / 面包屑：点击聚焦，▾ 折叠 --- */
$("#railTree").addEventListener("click",ev=>{
  const f=ev.target.closest("[data-fold]");
  if(f){ ev.stopPropagation(); toggleCollapse(f.dataset.fold); return; }
  const g=ev.target.closest("[data-go]"); if(!g) return;
  revealCard(g.dataset.go);
});

/* --- 演示坞：胶囊开合 --- */
$("#dockPill").addEventListener("click",()=>$("#dockPanel").classList.toggle("open"));
$("#dockPanel").addEventListener("click",ev=>{
  const b=ev.target.closest("[data-demo]"); if(!b) return;
  const k=b.dataset.demo;
  if(k==="toast"){ toast("这是一条演示 toast","撤销",()=>toast("已撤销")); return; }
  setDemo(k);
});

/* --- 四态内的动作 --- */
$("#states").addEventListener("click",ev=>{
  const b=ev.target.closest("[data-st]"); if(!b) return;
  const k=b.dataset.st;
  if(k==="retry"){ setDemo("loading"); setTimeout(()=>{ setDemo("normal"); toast("重试成功 · 已取回卡片树"); },700); }
  else if(k==="new"){ setDemo("normal"); openNew(); }
  else if(k==="back"){ setDemo("normal"); toast("已关闭示例"); }
  else if(k==="req"){ toast("已向根卡提交只读权限申请"); }
});

/* --- 改动对照面板 --- */
$("#diffHead").addEventListener("click",()=>$("#diffPanel").classList.toggle("open"));
$("#diffBody").addEventListener("click",ev=>{
  const it=ev.target.closest(".diff-item"); if(!it) return;
  $$("#diffBody .diff-item").forEach(x=>x.classList.toggle("on",x===it));
});

/* --- 覆盖层关闭 --- */
$$("[data-close-drawer]").forEach(b=>b.addEventListener("click",closeDrawers));
$("#cmdkClose").addEventListener("click",closeCmdk);

/* --- 命令面板 --- */
$("#cmdkInput").addEventListener("input",ev=>renderCmdk(ev.target.value));
$("#cmdkInput").addEventListener("keydown",ev=>{
  if(ev[K]==="Enter"){
    const first=$("#cmdkList .cmdk-item");
    if(first) first.click();
  }
});
$("#cmdkList").addEventListener("click",ev=>{
  const it=ev.target.closest(".cmdk-item"); if(!it) return;
  closeCmdk();
  if(it.dataset.card) return revealCard(it.dataset.card);
  const c=it.dataset.cmd;
  if(c==="fit") fit();
  else if(c==="new") openNew();
  else if(c==="theme") toggleTheme();
  else if(c==="rule") toggleRule();
  else if(c==="act"){ renderAct(); openDrawer("activityDrawer"); }
  else if(c==="notif"){ renderNotify(); openDrawer("notifyPanel"); }
});
$("#cmdk").addEventListener("click",ev=>{ if(ev.target.id==="cmdk") closeCmdk(); });

/* --- 新建卡弹窗 --- */
$("#newCancel").addEventListener("click",closeNew);
$("#newCreate").addEventListener("click",createCard);
$("#newTitle").addEventListener("keydown",ev=>{ if(ev[K]==="Enter") createCard(); });
$("#newModal").addEventListener("click",ev=>{ if(ev.target.id==="newModal") closeNew(); });

document.addEventListener("click",ev=>{
  if(!ev.target.closest("#moreMenu")&&!ev.target.closest("#moreBtn")){
    $("#moreMenu").classList.remove("open");
  }
  if($("#cmdk").classList.contains("open")&&!ev.target.closest("#cmdk")&&!ev.target.closest("#searchBtn")){
    closeCmdk();
  }
});

/* --- tooltip：悬停摘要 + 就地回复 --- */
$("#tip").addEventListener("mouseenter",()=>{ clearTimeout(tipHide); });
$("#tip").addEventListener("mouseleave",()=>hideTipSoon());
$("#tipInput").addEventListener("focus",()=>{ tipInputFocused=true; clearTimeout(tipHide); });
$("#tipInput").addEventListener("blur",()=>{ tipInputFocused=false; hideTipSoon(); });
$("#tipSend").addEventListener("click",()=>{ const i=$("#tipInput"); sendQuick(i.value); i.value=""; });
$("#tipInput").addEventListener("keydown",ev=>{ if(ev[K]==="Enter"){ sendQuick(ev.target.value); ev.target.value=""; } });

/* --- 键盘：Esc 逐级退 + 快捷键 --- */
document.addEventListener("keydown",ev=>{
  if(ev[K]==="Escape"){
    if($("#cmdk").classList.contains("open")){ closeCmdk(); return; }
    if($("#moreMenu").classList.contains("open")){ $("#moreMenu").classList.remove("open"); return; }
    if($("#newModal").classList.contains("open")){ closeNew(); return; }
    if(renaming){ cancelRename(); return; }
    if($("#convSheet").classList.contains("open")||$("#activityDrawer").classList.contains("open")||$("#notifyPanel").classList.contains("open")){ closeDrawers(); return; }
    if(S.demo!=="normal"){ setDemo("normal"); return; }
    return;
  }
  const ae=document.activeElement;
  const typing=/^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName)||ae.isContentEditable;
  if(typing) return;
  if((ev.metaKey||ev.ctrlKey)&&(ev[K]==="k"||ev[K]==="K")){ ev.preventDefault(); openCmdk(); return; }
});

/* ===================== 启动 ===================== */
function boot(){
  renderAct(); renderNotify(); renderCmdk(""); renderRp("spec"); renderDiff();
  renderNodes(); drawWires(); renderCrumb(); renderRail(); renderStat();
  $("#rulePanel").classList.toggle("closed",!S.sideOpen);
  $("#viewport").classList.toggle("side",S.sideOpen);
  $("#rpHandle").textContent=S.sideOpen?"›":"‹";
  applyTransform();
  layoutTidy(true);                 // 先按层级排一遍，保证全树可读
  setTimeout(()=>{ fit(); },80);
  setTimeout(()=>{ drawWires(); },200);
}
boot();
</script>
</body>
</html>
