function archiveOne(id){
  const n=NODES[id];
  if(n.state==="archived"){ toast("已经是已归档状态"); return; }
  const old=n.state; n.state="archived"; n.arch="ARCH-04"; n.archivedFrom=old;
  renderNodes(); renderRail();
  toast("已归档 · "+n.title,"撤销",()=>{
    n.state=n.archivedFrom||old; delete n.arch;
    renderNodes(); renderRail();
  });
}
