    if(!inside) centerOn([id]);
    el.classList.remove("flash"); void el.offsetWidth; el.classList.add("flash");
    setTimeout(()=>el.classList.remove("flash"),1400);
  }
}
/* 折叠/展开＝密度旋钮：收起后剩下的卡重新紧凑排布（不留空洞）→ 同一块画布放得下更大比例
   → 卡更大、字更清、LOD 升档看到更多信息；展开则反过来。 */
function toggleCollapse(id){
  if(!hasKids(id)) return;
  if(S.collapsed.has(id)) S.collapsed.delete(id); else S.collapsed.add(id);
  renderNodes(); renderRail();
  layoutTidy(true);
}
function collapseAll(v){
  if(v) Object.keys(NODES).forEach(id=>{ if(hasKids(id)&&id!=="root") S.collapsed.add(id); });
  else S.collapsed.clear();
  renderNodes(); renderRail(); layoutTidy(true);
}
function visKids(id){ return kidsOf(id).filter(k=>!NODES[k]._hidden&&!S.collapsed.has(id)); }
function leafCount(id){ const k=visKids(id); return k.length? k.reduce((a,b)=>a+leafCount(b),0) : 1; }
function subDepth(id){ const k=visKids(id); return k.length? 1+Math.max(...k.map(subDepth)) : 0; }
/* 布局＝按「栏」排：栏内 x 仍表达层级（同栏内父子向右），栏只是把互不相交的子树并排放，
   于是这棵树不再是一条竖长条——竖向被摊平，画布的水平空间才用得上，节点也才放得大。
   栏数 K 逐个试，取整幅缩放最大的那个：树形不同，最优栏数也不同，不写死。 */
function layoutTidy(quiet){
  const GAPX=74, PAD=64, ROW=ROWH;
  const rootKids=visKids("root");
  if(!rootKids.length){ NODES.root.pos={x:PAD,y:PAD}; renderNodes(); drawWires(); setTimeout(fit,20); return; }
  const r=$("#canvas").getBoundingClientRect();
  const AW=Math.max(200,r.width-88), AH=Math.max(160,r.height-88);
  let best=null;
  for(let K=1;K<=Math.min(4,rootKids.length);K++){
    const bins=Array.from({length:K},()=>({roots:[],h:0}));
    [...rootKids].sort((a,b)=>leafCount(b)-leafCount(a)).forEach(id=>{
      let b=bins[0]; bins.forEach(x=>{ if(x.h<b.h) b=x; });
      b.roots.push(id); b.h+=leafCount(id);
    });
    const pos={}; let bx=PAD+NW+GAPX;
    bins.forEach(b=>{
      const x0c=bx, span=(Math.max(0,...b.roots.map(subDepth))+1)*(NW+GAPX);
      let cur=0;
      b.roots.forEach(rid=>{
        (function place(id,d){
          const kids=visKids(id);
          if(!kids.length){ pos[id]={x:x0c+d*(NW+GAPX), y:cur*ROW}; cur++; return; }
          const ys=[];
          kids.forEach(k=>{ place(k,d+1); ys.push(pos[k].y); });
          pos[id]={x:x0c+d*(NW+GAPX), y:(Math.min(...ys)+Math.max(...ys))/2};
        })(rid,0);
      });
      bx+=span;
    });
    const ys=rootKids.map(id=>pos[id].y);
    pos.root={x:PAD, y:(Math.min(...ys)+Math.max(...ys))/2};
    let x0=1e9,x1=-1e9,y0=1e9,y1=-1e9;
    Object.values(pos).forEach(q=>{
      x0=Math.min(x0,q.x); x1=Math.max(x1,q.x+NW);
      y0=Math.min(y0,q.y); y1=Math.max(y1,q.y+ROW);
    });
    const z=Math.min(AW/Math.max(1,x1-x0), AH/Math.max(1,y1-y0));
    if(!best||z>best.z) best={pos,z};
  }
  Object.entries(best.pos).forEach(([id,q])=>{ if(NODES[id]) NODES[id].pos={x:Math.round(q.x),y:Math.round(q.y)}; });
  renderNodes(); drawWires();
  setTimeout(()=>{ fit(); },30);
}
function renderRail(){
  let h="";
  (function walk(id,pad){
    if(NODES[id]._hidden) return;
    const n=NODES[id], kids=hasKids(id);
h+='<li><div class="tree-row'+(pad?" child":"")+'" data-go="'+id+'" style="padding-left:'+(10+pad*14)+'px">'+
      '<span class="d" style="background:var(--'+n.state+')"></span><span class="t">'+esc(n.title)+'</span>'+
      (kids?'<span class="tw" data-fold="'+id+'" title="折叠/展开">'+(S.collapsed.has(id)?"▸":"▾")+'</span>':'')+
      '</div></li>';
    if(kids&&!S.collapsed.has(id)) kidsOf(id).forEach(k=>walk(k,pad+1));
  })("root",0);
  $("#railTree").innerHTML=h;
}

